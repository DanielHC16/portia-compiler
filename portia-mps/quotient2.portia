int main() {
    local var int num1 = 0;
    local var int num2 = 0;
    local var int quot = 0;

    threadln("Enter first number:");
    trap(num1);
    threadln("Enter second number:");
    trap(num2);

    if (num2 != 0) {
        quot = num1 / num2;
        thread("Quotient: ");
        threadln(quot);
    } else {
        threadln("Cannot divide by zero!");
    }

    return 0;
}
