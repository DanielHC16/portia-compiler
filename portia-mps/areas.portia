int main() {
    local var int choice = 0;
    local var double radius = 0;
    local var double base = 0;
    local var double height = 0;
    local var double side = 0;
    local var double length = 0;
    local var double width = 0;

    local var double area = 0;

    threadln("Choose shape:");
    threadln("1 - Circle");
    threadln("2 - Triangle");
    threadln("3 - Square");
    threadln("4 - Rectangle");

    thread("Enter choice: ");
    trap(choice);

    switch (choice) {

        case 1:
            thread("Enter radius: ");
            trap(radius);

            area = 3.1416 * radius * radius;

            threadln("Area of Circle: " .. area);
            break;

        case 2:
            thread("Enter base: ");
            trap(base);

            thread("Enter height: ");
            trap(height);

            area = (base * height) / 2;

            threadln("Area of Triangle: " .. area);
            break;

        case 3:
            thread("Enter side: ");
            trap(side);

            area = side * side;

            threadln("Area of Square: " .. area);
            break;

        case 4:
            thread("Enter length: ");
            trap(length);

            thread("Enter width: ");
            trap(width);

            area = length * width;

            threadln("Area of Rectangle: " .. area);
            break;

        default:
            threadln("Invalid Input");
            break;
    }

    return 0;
}
