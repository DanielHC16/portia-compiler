int main() {
    local var char a = 'h';
    local var char b = 'e';
    local var char ch = 'f';

    threadln("Testing char comparison");

    if (a > b) {
        threadln("1. h > e : true");
    } else {
        threadln("1. h > e : false");
    }

    if (b < a) {
        threadln("2. e < h : true");
    } else {
        threadln("2. e < h : false");
    }

    if (ch >= 'A' && ch <= 'Z') {
        threadln("3. F is uppercase");
    } else {
        threadln("3. F is not uppercase");
    }

    if ('A' <= 'Z') {
        threadln("4. A <= Z : true");
    } else {
        threadln("4. A <= Z : false");
    }

    if (a != b) {
        threadln("5. h != e : true");
    } else {
        threadln("5. h != e : false");
    }

    if (ch == 'F') {
        threadln("6. F == F : true");
    } else {
        threadln("6. F == F : false");
    }

    return 0;
}
