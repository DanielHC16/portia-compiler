int main() {
    local var int n = 0;

    do {
        thread("Input any number (positive) to start for Hailstone Sequence: ");
        trap(n);
        if (n <= 0) {
            threadln("Invalid input. Please enter a positive integer.");
        }
    } while (n <= 0);

    threadln("The hailstone sequence starting at " .. n .. " is:");

    while (n != 1) {
        thread("" .. n .. "  ");
        if ((n % 2) == 0) {
            n = n / 2;
        } else {
            n = n * 3 + 1;
        }
    }

    threadln("" .. 1);

    return 0;
}
