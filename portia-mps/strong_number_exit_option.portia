//strong number with exit option
func int factorial(int n) {
    if (n == 0 || n == 1) {
        return 1;
    }

    return n * factorial(n - 1);
}

func int isStrong(int n) {
    local var int temp = 0;
    local var int sum = 0;

    if (n < 0) {
        return 0;
    }

    if (n == 0) {
        return 0;
    }

    temp = n;

    while (temp > 0) {
        sum = sum + factorial(temp % 10);
        temp = temp / 10;
    }

    if (sum == n) {
        return 1;
    }

    return 0;
}

int main() {
    local var int n = 0;
    local var int choice = 1;

    while (choice == 1) {
        thread("Enter a number: ");
        trap(n);

        if (isStrong(n) == 1) {
            threadln("Strong number");
        } else {
            threadln("Not a Strong number");
        }

        thread("Enter 1 to try again, 0 to exit: ");
        trap(choice);
    }

    return 0;
}
