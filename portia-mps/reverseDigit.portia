int main() {
    local var long number  = 0;
    local var long temp    = 0;
    local var long digit   = 0;
    local var long reverse = 0;
    local var bool isNeg   = false;

    thread("Enter a number: ");
    trap(number);

    temp = number;

    // check if negative and strip the sign for reversal
    if (temp < 0) {
        isNeg = true;
        temp  = temp * -1;
    }

    while (temp > 0) {
        digit   = temp % 10;
        reverse = (reverse * 10) + digit;
        temp    = temp / 10;
    }

    // re-apply negative sign 
    if (isNeg) {
        reverse = reverse * -1;
    }

    threadln("Reversed number: " .. reverse);

    return 0;
}
