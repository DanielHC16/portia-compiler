int main() {
    local var int r = 0;
    local var int s = 0;
    local var int str = 0;
    local var int size = 0;
    local var int spaces = 0;

    thread("Enter size: ");
    trap(size);

    threadln("Inverted Pyramid:");

    r = size;
    while (r >= 1) {

        spaces = size - r;

        s = 0;
        while (s < spaces) {
            thread(" ");
            s = s + 1;
        }

        str = 0;
        while (str < r) {
            thread("* ");
            str = str + 1;
        }

        threadln("");
        r = r - 1;
    }

    return 0;
}
