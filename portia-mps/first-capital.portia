func char firstCapital(string text, int index) {
    if (index >= len(text)) {
        return ' ';
    }

    if (text[index] >= 'A' && text[index] <= 'Z') {
        return text[index];
    }

    return firstCapital(text, index + 1);
}

int main() {
    local var string text = "";
    local var char result = ' ';

    threadln("Enter a string:");
    trap(text);

    result = firstCapital(text, 0);

    if (result >= 'A' && result <= 'Z') {
        thread("First capital letter: ");
        threadln(result);
    } else {
        threadln("No capital letter found.");
    }

    return 0;
}
