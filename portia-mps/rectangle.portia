int main() {
    local var int i = 0;
    local var int j = 0;
    local var int height = 0;
    local var int width = 0;
    
    thread("Enter width: ");
    trap(width);
    thread("Enter height: ");
    trap(height);
    
    threadln("Rectangle:");
    i = 0;
    while (i < height) {
        j = 0;
        while (j < width) {
            thread("*");
            j = j + 1;
        }
        threadln("");
        i = i + 1;
    }
    
    return 0;
}
