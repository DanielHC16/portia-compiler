int main() {
    local var int m = 0;
    local var int n = 0;
    local var int r = 0;
    local var int c = 0;
    local var int result = 0;

    thread("Enter number of rows (m): ");
    trap(m);
    thread("Enter number of columns (n): ");
    trap(n);
    threadln("Multiplication Table:");

    r = 1;
    while (r <= m) {

        c = 1;
        while (c <= n) {

            result = r * c;

            // alignment logic
            if (result < 10) {
                thread("  ");   // extra space for 1-digit
            } else if (result < 100) {
                thread(" ");    // less space for 2-digit
            }

            thread(result);
            thread("   "); // spacing between columns

            c = c + 1;
        }

        threadln("");
        r = r + 1;
    }

    return 0;
}
