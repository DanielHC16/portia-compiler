int main() {
    local var int n = 0;
    local var int i = 0;
    local var int a = 0;
    local var int b = 1;
    local var int next = 0;

    thread("Enter N: ");
    trap(n);

    // validation
    if (n <= 0) {
        threadln("Invalid input. N must be greater than 0.");
        return 0;
    }

    threadln("Fibonacci Series:");

    i = 0;
    while (i < n) {

        if (i == 0) {
            threadln(a);
        }
        else if (i == 1) {
            threadln(b);
        }
        else {
            next = a + b;
            threadln(next);
            a = b;
            b = next;
        }

        i = i + 1;
    }

    return 0;
}
