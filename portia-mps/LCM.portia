func int gcd(int a, int b) {
    if (a < 0) {
        a = 0 - a;
    }

    if (b < 0) {
        b = 0 - b;
    }

    if (b == 0) {
        return a;
    }

    return gcd(b, a % b);
}

func int lcm(int a, int b) {
    local var int result = 0;
    local var int g = 0;

    if (a == 0 || b == 0) {
        return 0;
    }

    if (a < 0) {
        a = 0 - a;
    }

    if (b < 0) {
        b = 0 - b;
    }

    g = gcd(a, b);

    result = (a / g) * b;

    return result;
}

int main() {
    local var int a = 0;
    local var int b = 0;
    local var int result = 0;

    thread("Enter first number: ");
    trap(a);

    thread("Enter second number: ");
    trap(b);

    if (a == 0 && b == 0) {
        threadln("LCM is undefined for 0 and 0.");
        return 0;
    }

    result = lcm(a, b);

    thread("LCM: ");
    threadln(result);

    return 0;
}
