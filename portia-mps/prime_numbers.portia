func int isPrime(int n) {
    local var int i = 0;

    if (n <= 1) {
        return 0;
    }

    for (i = 2; i * i <= n; i += 1) {
        if ((n % i) == 0) {
            return 0;
        }
    }

    return 1;
}

int main() {
    local var int start = 0;
    local var int end = 0;
    local var int i = 0;

    thread("Enter start number: ");
    trap(start);

    if (start <= 0) {
        threadln("Error: input should be positive.");
        return 0;
    }

    thread("Enter end number: ");
    trap(end);

    if (end <= 0) {
        threadln("Error: input should be positive.");
        return 0;
    }

    if (start > end) {
        threadln("Error: start must be less than or equal to end.");
        return 0;
    }

    threadln("Prime numbers:");

    i = start;

    for (; i <= end; i += 1) {
        if (isPrime(i) == 1) {
            thread(i, " ");
        }
    }

    return 0;
}
