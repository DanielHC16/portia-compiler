int main() {
    local var int num = 0;
    local var int i = 1;
    local var int sum = 0;

    while (true) {
        thread("Enter a positive integer: ");
        trap(num);

        if (num > 0) {
            break;
        } else {
            threadln("Invalid input. Please enter a positive number.");
        }
    }


    i = 1;
    while (i < num) {
        if (num % i == 0) {
            sum = sum + i;
        }
        i = i + 1;
    }

    thread("Sum of proper divisors: ");
    threadln(sum);

    if (sum == num) {
        threadln("Perfect Number");
    } else {
        threadln("Not a Perfect Number");
    }

    return 0;
}
