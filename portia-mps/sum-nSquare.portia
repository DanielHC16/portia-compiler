int main() {
    local var int i = 1;
    local var int n = 0;
    local var int sum = 0;

    thread("Enter the value of n: ");
    trap(n);

    if (n < 0) {
        n = -n;
    }

    while (i <= n) {
        sum = sum + i * i;
        i = i + 1;
    }

    thread("Sum of Squares: ", sum);

    return 0;
}
