func int printNumbers(int n, int limit) {
    if (n > limit) {
        return 0;
    }

    thread(n);
    thread(" ");

    printNumbers(n + 1, limit);

    return 0;
}

int main() {
    local var int num = 0;

    thread("Input a number: ");
    trap(num);

    printNumbers(1, num);

    return 0;
}
