int main() {
  local var string word = "";
  local var int len = 0;
  local var int i = 0;

  thread("Enter a word: ");
  trap(word);

  thread("Enter its length: ");
  trap(len);

  for (i = 0; i < len; i += 1) {
    thread("Character at index ");
    thread(i);
    thread(": ");
    threadln(word[i]);
  }

  return 0;
}
