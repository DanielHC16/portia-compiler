global var int a[3][3] = {{0,0,0},{0,0,0},{0,0,0}};
global var int b[3][3] = {{0,0,0},{0,0,0},{0,0,0}};
global var int result[3][3] = {{0,0,0},{0,0,0},{0,0,0}};
global var int rows = 0;
global var int cols = 0;


func int[3][3] addMatrix(int matA[3][3], int matB[3][3], int r, int c) {
    local var int res[3][3] = {{0,0,0},{0,0,0},{0,0,0}};
    local var int i = 0;
    local var int j = 0;
    i = 0;
    while (i < r) {
        j = 0;
        while (j < c) {
            res[i][j] = matA[i][j] + matB[i][j];
            j += 1;
        }
        i += 1;
    }
    return res;
}


func int[3][3] multiplyMatrix(int matA[3][3], int matB[3][3], int r, int c) {
    local var int res[3][3] = {{0,0,0},{0,0,0},{0,0,0}};
    local var int i = 0;
    local var int j = 0;
    local var int k = 0;
    i = 0;
    while (i < r) {
        j = 0;
        while (j < c) {
            res[i][j] = 0;
            k = 0;
            while (k < c) {
                res[i][j] = res[i][j] + matA[i][k] * matB[k][j];
                k += 1;
            }
            j += 1;
        }
        i += 1;
    }
    return res;
}


func int[3][3] copyMatrix(int mat[3][3], int r, int c) {
    local var int res[3][3] = {{0,0,0},{0,0,0},{0,0,0}};
    local var int i = 0;
    local var int j = 0;
    i = 0;
    while (i < r) {
        j = 0;
        while (j < c) {
            res[i][j] = mat[i][j];
            j += 1;
        }
        i += 1;
    }
    return res;
}


int main() {
    using a, b, result, rows, cols;
    local var int i = 0;
    local var int j = 0;
    local var int choice = 0;
    local var int temp[3][3] = {{0,0,0},{0,0,0},{0,0,0}};


    do {
        threadln("Enter number of rows (1-3): ");
        trap(rows);
        if (rows <= 0 || rows > 3) {
            threadln("Invalid. Enter between 1 and 3.");
        }
    } while (rows <= 0 || rows > 3);


    do {
        threadln("Enter number of columns (1-3): ");
        trap(cols);
        if (cols <= 0 || cols > 3) {
            threadln("Invalid. Enter between 1 and 3.");
        }
    } while (cols <= 0 || cols > 3);


    threadln("Enter elements of Matrix A:");
    i = 0;
    while (i < rows) {
        j = 0;
        while (j < cols) {
            threadln("A[" .. i .. "][" .. j .. "]: ");
            trap(a[i][j]);
            j += 1;
        }
        i += 1;
    }


    threadln("Enter elements of Matrix B:");
    i = 0;
    while (i < rows) {
        j = 0;
        while (j < cols) {
            threadln("B[" .. i .. "][" .. j .. "]: ");
            trap(b[i][j]);
            j += 1;
        }
        i += 1;
    }


    do {
        threadln("Choose operation:");
        threadln("1 - Matrix Addition");
        threadln("2 - Matrix Multiplication");
        threadln("3 - Matrix Transpose (Swap A and B)");
        threadln("4 - Exit");
        threadln("Enter choice: ");
        trap(choice);


        if (choice == 1) {
            result = addMatrix(a, b, rows, cols);
            threadln("Matrix A + B:");
            i = 0;
            while (i < rows) {
                j = 0;
                while (j < cols) {
                    thread(" "..result[i][j] .. " ");
                    j += 1;
                }
                threadln("");
                i += 1;
            }
        }


        if (choice == 2) {
            result = multiplyMatrix(a, b, rows, cols);
            threadln("Matrix A x B:");
            i = 0;
            while (i < rows) {
                j = 0;
                while (j < cols) {
                    thread(" "..result[i][j] .. " ");
                    j += 1;
                }
                threadln("");
                i += 1;
            }
        }


        if (choice == 3) {
            temp = copyMatrix(a, rows, cols);
            a = copyMatrix(b, rows, cols);
            b = copyMatrix(temp, rows, cols);


            threadln("Matrix A and B have been swapped!");
            threadln("New Matrix A:");
            i = 0;
            while (i < rows) {
                j = 0;
                while (j < cols) {
                    thread(" "..a[i][j] .. " ");
                    j += 1;
                }
                threadln("");
                i += 1;
            }
            threadln("New Matrix B:");
            i = 0;
            while (i < rows) {
                j = 0;
                while (j < cols) {
                    thread(" "..b[i][j] .. " ");
                    j += 1;
                }
                threadln("");
                i += 1;
            }
        }


        if (choice != 1 && choice != 2 && choice != 3 && choice != 4) {
            threadln("Invalid choice. Please enter 1, 2, 3, or 4.");
        }


    } while (choice != 4);


    threadln("Exit!");
    return 0;
}
