func float computeAverage() {
    local var int i = 1;
    local var float score = 0;
    local var float sum = 0;


    while (i <= 5) {
        thread("Enter score for quiz ");
        thread(i);
        thread(": ");
        trap(score);


        if (score < 0) {
            threadln("Invalid input. Score must not be negative.");
        } else {
            sum = sum + score;
            i = i + 1;
        }
    }


    return sum / 5;
}


int main() {
    local var float mathAvg = 0;
    local var float sciAvg = 0;
    local var float engAvg = 0;
    local var float filAvg = 0;


    threadln("=== MATH ===");
    mathAvg = computeAverage();
    thread("Average in Math: ");
    threadln(mathAvg);


    threadln("");
    threadln("=== SCIENCE ===");
    sciAvg = computeAverage();
    thread("Average in Science: ");
    threadln(sciAvg);


    threadln("");
    threadln("=== ENGLISH ===");
    engAvg = computeAverage();
    thread("Average in English: ");
    threadln(engAvg);


    threadln("");
    threadln("=== FILIPINO ===");
    filAvg = computeAverage();
    thread("Average in Filipino: ");
    threadln(filAvg);


    return 0;
}
