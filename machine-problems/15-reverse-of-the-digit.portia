int main() {
    local var long number = 0;
    local var long temp = 0;
    local var long digit = 0;
    local var long sum = 0;
    local var long reverse = 0;


    thread("Enter a number: ");
    trap(number);


    temp = number;


    if (temp < 0) {
        temp = temp * -1;
    }


    sum = 0;
    reverse = 0;


    while (temp > 0) {
        digit = temp % 10;


        sum = sum + digit;
        reverse = (reverse * 10) + digit;


        temp = temp / 10;
    }


    if (number < 0) {
        reverse = reverse * -1;
    }


    threadln("Sum of digits: " .. sum);
    threadln("Reversed number: " .. reverse);


    return 0;
}
