int main() {
    local var int choice = 0;
    local var string entry = "";
    local var bool accepting = true;
    local var bool isNumber = false;
    local var int scan = 0;
    local var int code = 0;


    threadln("Choose input type:");
    threadln("1 = characters");
    threadln("2 = numbers");
    trap(choice);


    if (choice == 1) {
        threadln("Character mode selected.");
        threadln("Enter characters. Enter a number to stop.");


        while (accepting == true) {
            threadln("Input:");
            trap(entry);


            isNumber = true;


            if (len(entry) == 0) {
                isNumber = false;
            }


            for (scan = 0; scan < len(entry); scan += 1) {
                code = (int) entry[scan];


                if (code < 48 || code > 57) {
                    isNumber = false;
                }
            }


            if (isNumber == true) {
                threadln("Number detected. Character input stopped.");
                accepting = false;
            } else {
                threadln("Accepted characters: " .. entry);
            }
        }
    } else if (choice == 2) {
        threadln("Number mode selected.");
        threadln("Enter numbers. Enter a character to stop.");


        while (accepting == true) {
            threadln("Input:");
            trap(entry);


            isNumber = true;


            if (len(entry) == 0) {
                isNumber = false;
            }


            for (scan = 0; scan < len(entry); scan += 1) {
                code = (int) entry[scan];


                if (code < 48 || code > 57) {
                    isNumber = false;
                }
            }


            if (isNumber == true) {
                threadln("Accepted number: " .. entry);
            } else {
                threadln("Character detected. Number input stopped.");
                accepting = false;
            }
        }
    } else {
        threadln("Invalid choice.");
    }


    return 0;
}
