func double calcCircle(double radius) {
    local var double area = 0.0;
    area = 3.1416 * radius * radius;
    return area;
}


func double calcTriangle(double base, double height) {
    local var double area = 0.0;
    area = (base * height) / 2.0;
    return area;
}


func double calcSquare(double side) {
    local var double area = 0.0;
    area = side * side;
    return area;
}


func double calcRectangle(double length, double width) {
    local var double area = 0.0;
    area = length * width;
    return area;
}


int main() {
    local var int choice = 0;
    local var double radius = 0.0;
    local var double base = 0.0;
    local var double height = 0.0;
    local var double side = 0.0;
    local var double length = 0.0;
    local var double width = 0.0;
    local var double result = 0.0;


    threadln("Choose shape:");
    threadln("1 - Circle");
    threadln("2 - Triangle");
    threadln("3 - Square");
    threadln("4 - Rectangle");
    thread("Enter choice: ");
    trap(choice);


    switch (choice) {
        case 1:
            thread("Enter radius: ");
            trap(radius);


            while (radius < 0) {
                threadln("Invalid input. Radius must not be negative.");
                thread("Enter radius again: ");
                trap(radius);
            }


            result = calcCircle(radius);
            threadln("Area of Circle: " .. result);
            break;


        case 2:
            thread("Enter base: ");
            trap(base);


            while (base < 0) {
                threadln("Invalid input. Base must not be negative.");
                thread("Enter base again: ");
                trap(base);
            }


            thread("Enter height: ");
            trap(height);


            while (height < 0) {
                threadln("Invalid input. Height must not be negative.");
                thread("Enter height again: ");
                trap(height);
            }


            result = calcTriangle(base, height);
            threadln("Area of Triangle: " .. result);
            break;


        case 3:
            thread("Enter side: ");
            trap(side);


            while (side < 0) {
                threadln("Invalid input. Side must not be negative.");
                thread("Enter side again: ");
                trap(side);
            }


            result = calcSquare(side);
            threadln("Area of Square: " .. result);
            break;


        case 4:
            thread("Enter length: ");
            trap(length);


            while (length < 0) {
                threadln("Invalid input. Length must not be negative.");
                thread("Enter length again: ");
                trap(length);
            }


            thread("Enter width: ");
            trap(width);


            while (width < 0) {
                threadln("Invalid input. Width must not be negative.");
                thread("Enter width again: ");
                trap(width);
            }


            result = calcRectangle(length, width);
            threadln("Area of Rectangle: " .. result);
            break;


        default:
            threadln("Invalid Input");
            break;
    }


    return 0;
}
