func bool isPrime(int n) {
    local var int i = 2;


    if (n <= 1) {
        return false;
    }


    while (i * i <= n) {
        if (n % i == 0) {
            return false;
        }
        i = i + 1;
    }


    return true;
}


func int reverseNum(int n) {
    local var int rev = 0;


    while (n > 0) {
        rev = rev * 10 + (n % 10);
        n = n / 10;
    }


    return rev;
}


int main() {
    local var int num = 0;
    local var int reversed = 0;
    local var bool isPrimeNum = false;
    local var bool isPrimeRev = false;


    do {
        thread("Enter a number (>1): ");
        trap(num);


        if (num <= 1) {
            threadln("Invalid input. Number must be greater than 1.");
        }
    } while (num <= 1);


    reversed = reverseNum(num);


    isPrimeNum = isPrime(num);
    isPrimeRev = isPrime(reversed);


    if (isPrimeNum && isPrimeRev && reversed != num) {
        threadln("Emirp Number");
    } else {
        threadln("Not an Emirp Number");
    }


    return 0;
}
