int main() {
    local var int n = 0;
    local var int i = 0;
    local var int a = 0;
    local var int b = 1;
    local var int next = 0;


    thread("Enter a number: ");
    trap(n);


    while (n < 0) {
        threadln("Negative numbers are not allowed.");
        thread("Enter N again: ");
        trap(n);
    }


    thread("Fibonacci Sequence: ");


    i = 0;
    while (i < n) {
        if (i == 0) {
            thread(a);
            thread(" ");
        }
        else if (i == 1) {
            thread(b);
            thread(" ");
        }
        else {
            next = a + b;
            thread(next);
            thread(" ");
            a = b;
            b = next;
        }


        i = i + 1;
    }


    return 0;
}
