func int gcd(int a, int b) {
    local var int result = 0;


    a = abs(a);
    b = abs(b);


    if (b == 0) {
        result = a;
    }
    else {
        result = gcd(b, a % b);
    }


    return result;
}


func int lcm(int a, int b) {
    local var int g = 0;
    local var int result = 0;


    a = abs(a);
    b = abs(b);


    if (a == 0 || b == 0) {
        result = 0;
    }
    else {
        g = gcd(a, b);
        result = (a / g) * b;
    }


    return result;
}


int main() {
    local var int a = 0;
    local var int b = 0;


    thread("Enter first integer: ");
    trap(a);


    thread("Enter second integer: ");
    trap(b);


    thread("LCM: ", lcm(a, b));


    return 0;
}
