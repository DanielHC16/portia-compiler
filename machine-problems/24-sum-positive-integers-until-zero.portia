int main() {
    local var int num = 0;
    local var int sum = 0;
    thread("Enter an integer (0 to stop): ");
    trap(num);
    while (num != 0) {
        if (num > 0) { sum = sum + num; }
        thread("Enter an integer (0 to stop): ");
        trap(num);
    }
    threadln("Sum of positive integers: ", sum);
    return 0;
}
