func int isNeon(int n) {
    local var int square = 0;
    local var int sum = 0;
    square = n * n;
    if (square == 0) {
        return 1;
    }
    while (square > 0) {
        sum = sum + (square % 10);
        square = square / 10;
    }
    if (sum == n) {
        return 1;
    }
    return 0;
}


int main() {
    local var int n = 0;


    do {
        thread("Enter a number: ");
        trap(n);
        if (n < 0) {
            threadln("Invalid. Please enter a positive number.");
        }
    } while (n < 0);


    if (isNeon(n) == 1) {
        threadln(" "..n .. " is a Neon number.");
    } else {
        threadln(" "..n .. " is not a Neon number.");
    }


    return 0;
}
