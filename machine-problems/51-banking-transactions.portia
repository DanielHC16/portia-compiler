func bool isValidAccountNo(int acc) {
    local var bool ok = false;


    if (acc >= 10000000 && acc <= 99999999) {
        ok = true;
    } else {
        ok = false;
    }


    return ok;
}


func bool isLeapYear(int year) {
    local var bool result = false;


    if (year % 400 == 0) {
        result = true;
    } else {
        if (year % 100 == 0) {
            result = false;
        } else {
            if (year % 4 == 0) {
                result = true;
            } else {
                result = false;
            }
        }
    }


    return result;
}


func bool isValidDate(int d) {
    local var int year = 0;
    local var int month = 0;
    local var int day = 0;
    local var bool ok = true;


    if (d < 10000101 || d > 99991231) {
        ok = false;
    } else {
        year = (int)(d / 10000);
        month = ((int)(d / 100)) % 100;
        day = d % 100;


        if (month < 1 || month > 12) {
            ok = false;
        } else {
            if (day < 1) {
                ok = false;
            } else {
                if (month == 1 || month == 3 || month == 5 || month == 7 || month == 8 || month == 10 || month == 12) {
                    if (day > 31) {
                        ok = false;
                    } else {
                        ok = ok;
                    }
                } else {
                    if (month == 4 || month == 6 || month == 9 || month == 11) {
                        if (day > 30) {
                            ok = false;
                        } else {
                            ok = ok;
                        }
                    } else {
                        if (month == 2) {
                            if (isLeapYear(year)) {
                                if (day > 29) {
                                    ok = false;
                                } else {
                                    ok = ok;
                                }
                            } else {
                                if (day > 28) {
                                    ok = false;
                                } else {
                                    ok = ok;
                                }
                            }
                        } else {
                            ok = false;
                        }
                    }
                }
            }
        }
    }


    return ok;
}


func bool isDuplicateAccountNo(int acc, int currentClient) {
    using accountNo1, accountNo2, accountNo3, accountNo4, accountNo5;
    local var bool dup = false;


    if (currentClient != 1 && acc == accountNo1) {
        dup = true;
    } else {
        if (currentClient != 2 && acc == accountNo2) {
            dup = true;
        } else {
            if (currentClient != 3 && acc == accountNo3) {
                dup = true;
            } else {
                if (currentClient != 4 && acc == accountNo4) {
                    dup = true;
                } else {
                    if (currentClient != 5 && acc == accountNo5) {
                        dup = true;
                    } else {
                        dup = false;
                    }
                }
            }
        }
    }


    return dup;
}


func bool isLetterOnlyName(string s) {
    local var int i = 0;
    local var int n = 0;
    local var char ch = ' ';
    local var bool ok = true;


    n = len(s);


    if (n == 0) {
        ok = false;
    } else {
        i = 0;
        while (i < n) {
            ch = s[i];


            if (ch >= 'A' && ch <= 'Z') {
                ok = ok;
            } else {
                if (ch >= 'a' && ch <= 'z') {
                    ok = ok;
                } else {
                    if (ch == ' ') {
                        ok = ok;
                    } else {
                        ok = false;
                    }
                }
            }


            i = i + 1;
        }
    }


    return ok;
}


func int printRecord(int idx, int t, int a) {
    local var int dummy = 0;


    if (t == 1) {
        threadln(idx, ". Deposit - PHP ", a);
    } else {
        if (t == 2) {
            threadln(idx, ". Withdrawal - PHP ", a);
        } else {
            threadln("");
        }
    }


    return dummy;
}


