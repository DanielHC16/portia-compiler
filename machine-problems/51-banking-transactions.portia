    using txCount1, txCount2, txCount3, txCount4, txCount5;
    using depTotal1, depTotal2, depTotal3, depTotal4, depTotal5;
    using wdTotal1, wdTotal2, wdTotal3, wdTotal4, wdTotal5;


    using recType11, recAmt11, recType12, recAmt12, recType13, recAmt13, recType14, recAmt14, recType15, recAmt15;
    using recType21, recAmt21, recType22, recAmt22, recType23, recAmt23, recType24, recAmt24, recType25, recAmt25;
    using recType31, recAmt31, recType32, recAmt32, recType33, recAmt33, recType34, recAmt34, recType35, recAmt35;
    using recType41, recAmt41, recType42, recAmt42, recType43, recAmt43, recType44, recAmt44, recType45, recAmt45;
