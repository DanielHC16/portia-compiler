                                                }
                                            }
                                        }
                                    }
                                }
                            }


                            threadln("Deposit successful.");
                        }
                    }
                } else {
                    if (txChoice == 2) {
                        if (currentTxCount >= 5) {
                            threadln("Daily financial transaction limit reached.");
                        } else {
