int main() {
    local var int secret = 17;
    local var int guess = 0;
    local var int attempts = 0;
    local var int maxAttempts = 5;


    threadln("Number Guessing Game");
    threadln("Guess the secret number.");
    thread("You only have ");
    thread(maxAttempts);
    threadln(" attempts.");


    while (attempts < maxAttempts) {
        thread("Enter your guess: ");
        trap(guess);


        attempts = attempts + 1;


        if (guess == secret) {
            threadln("Correct! You guessed the secret number.");
            thread("Attempts used: ");
            threadln(attempts);
            return 0;
        }
        else if (guess < secret) {
            threadln("Hint: Too low.");
        }
        else {
            threadln("Hint: Too high.");
        }


        if (attempts < maxAttempts) {
            thread("Remaining attempts: ");
            threadln(maxAttempts - attempts);
        }
    }


    threadln("Game Over!");
    thread("The secret number was: ");
    threadln(secret);


    return 0;
}
