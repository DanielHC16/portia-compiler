int main() {
    local var int i = 0;
    local var int j = 0;
    local var int height = 0;
    local var int width = 0;


    do {
        thread("Enter width: ");
        trap(width);
        if (width <= 0) {
            threadln("Invalid. Width must be greater than 0.");
        }
    } while (width <= 0);


    do {
        thread("Enter height: ");
        trap(height);
        if (height <= 0) {
            threadln("Invalid. Height must be greater than 0.");
        }
    } while (height <= 0);


    threadln("Rectangle:");
    i = 0;
    while (i < height) {
        j = 0;
        while (j < width) {
            thread("*");
            j = j + 1;
        }
        threadln("");
        i = i + 1;
    }


    return 0;
}
