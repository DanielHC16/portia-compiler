int main() {
    local var int nums[100];
    local var int size = 0;
    local var int input = 0;
    local var int i = 0;
    local var int count = 0;
    local var bool isTriplicate = false;


    while (isTriplicate == false) {
        thread("Enter a number: ");
        trap(input);


        count = 0;
        i = 0;


        while (i < size) {
            if (nums[i] == input) {
                count = count + 1;
            }
            i = i + 1;
        }


        if (count == 2) {
            isTriplicate = true;
        }


        nums[size] = input;
        size = size + 1;
    }


    thread("Triplicate number detected: ");
    threadln(input);


    return 0;
}
