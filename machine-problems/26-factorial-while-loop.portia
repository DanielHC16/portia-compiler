int main() {
    local var int n = 0;
    local var int i = 1;
    local var int fact = 1;



    while (true) {
        threadln("Enter a positive integer:");
        trap(n);


        if (n >= 0) {
            break;
        }


        threadln("Invalid input. Please enter a positive integer.");
    }



    i = 1;
    fact = 1;


    while (i <= n) {
        fact = fact * i;
        i = i + 1;
    }


    thread("Factorial of ");
    thread(n);
    thread(" is: ");
    threadln(fact);


    return 0;
}
