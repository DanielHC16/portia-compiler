int main() {
    local var int maxStudents = 0;
    local var int count = 0;
    local var int choice = 0;
    local var int i = 0;
    local var int j = 0;
    local var int searchNo = 0;
    local var int found = -1;
    local var int nextIndex = 0;
    local var int editChoice = 0;
    local var int confirmDelete = 0;
    local var int nameLen = 0;
    local var int courseLen = 0;
    local var bool validName = true;
    local var bool validCourse = true;
    local var bool isDuplicate = false;
    local var char ch = ' ';


    local var string tempName = "";
    local var string tempCourse = "";


    local var string names[100];
    local var int studentNos[100];
    local var string courses[100];


    thread("Enter maximum number of students: ");
    trap(maxStudents);


    if (maxStudents <= 0) {
        threadln("Invalid number of students.");
        return 0;
    }
    else if (maxStudents > 100) {
        threadln("Maximum allowed is 100 only.");
        return 0;
    }


    while (choice != 6) {
        threadln("");
        threadln("===== STUDENT RECORDS MENU =====");
        threadln("1. Add Record");
        threadln("2. Display Record (All)");
        threadln("3. Search Record");
        threadln("4. Edit Record");
        threadln("5. Delete Record");
        threadln("6. Exit");



        while (true) {
            thread("Enter choice: ");
            trap(choice);


            if (choice >= 1) {
                if (choice <= 6) {
                    break;
                }
            }


            threadln("Invalid choice.");
        }


        if (choice == 1) {
            if (count >= maxStudents) {
                threadln("Record list is already full.");
            }
            else {



                while (true) {
                    thread("Enter Student Name: ");
                    trap(tempName);


                    validName = true;
                    nameLen = len(tempName);
                    i = 0;


                    while (i < nameLen) {
                        ch = tempName[i];
                        if (!((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch == ' ') || (ch == '.'))) {
                            validName = false;
                        }
                        i = i + 1;
                    }


                    if (nameLen == 0) {
                        validName = false;
                    }


                    if (validName == true) {
                        break;
                    }


                    threadln("Invalid student name.");
                }



                while (true) {
                    thread("Enter Student Number: ");
                    trap(searchNo);


                    if (searchNo >= 0) {


                        isDuplicate = false;
                        i = 0;
                        while (i < count) {
                            if (studentNos[i] == searchNo) {
                                isDuplicate = true;
                                i = count;
                            }
                            else {
                                i = i + 1;
                            }
                        }


                        if (isDuplicate == false) {
                            break;
                        }


                        threadln("Student number already exists.");
                    }
                    else {
                        threadln("Invalid student number.");
                    }
                }



                while (true) {
                    thread("Enter Course: ");
                    trap(tempCourse);


                    validCourse = true;
                    courseLen = len(tempCourse);
                    j = 0;


                    while (j < courseLen) {
                        ch = tempCourse[j];
                        if (!((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch == ' ') || (ch == '.'))) {
                            validCourse = false;
                        }
                        j = j + 1;
                    }


                    if (courseLen == 0) {
                        validCourse = false;
                    }


                    if (validCourse == true) {
                        break;
                    }


                    threadln("Invalid course.");
                }


                names[count] = tempName;
                studentNos[count] = searchNo;
                courses[count] = tempCourse;
                count = count + 1;
                threadln("Record added successfully.");
            }
        }


        else if (choice == 2) {
            if (count == 0) {
                threadln("No records found.");
            }
            else {
                threadln("===== ALL STUDENT RECORDS =====");
                i = 0;
                while (i < count) {
                    thread("Record #");
                    threadln(i + 1);
                    thread("Name: ");
                    threadln(names[i]);
                    thread("Student Number: ");
                    threadln(studentNos[i]);
                    thread("Course: ");
                    threadln(courses[i]);
                    threadln("");
                    i = i + 1;
                }
            }
        }


        else if (choice == 3) {
            if (count == 0) {
                threadln("No records found.");
            }
            else {



                while (true) {
                    thread("Enter Student Number to search: ");
                    trap(searchNo);


                    if (searchNo >= 0) {
                        break;
                    }


                    threadln("Invalid student number.");
                }


                found = -1;
                i = 0;
                while (i < count) {
                    if (studentNos[i] == searchNo) {
                        found = i;
                        i = count;
                    }
                    else {
                        i = i + 1;
                    }
                }


                if (found == -1) {
                    threadln("Record not found.");
                }
                else {
                    threadln("===== STUDENT RECORD FOUND =====");
                    thread("Name: ");
                    threadln(names[found]);
                    thread("Student Number: ");
                    threadln(studentNos[found]);
                    thread("Course: ");
                    threadln(courses[found]);
                }
            }
        }


        else if (choice == 5) {
            if (count == 0) {
                threadln("No records found.");
            }
            else {


                while (true) {
                    thread("Enter Student Number to delete: ");
                    trap(searchNo);


                    if (searchNo >= 0) {
                        break;
                    }


                    threadln("Invalid student number.");
                }


                found = -1;
                i = 0;
                while (i < count) {
                    if (studentNos[i] == searchNo) {
                        found = i;
                        i = count;
                    }
                    else {
                        i = i + 1;
                    }
                }


                if (found == -1) {
                    threadln("Record not found.");
                }
                else {
                    threadln("Confirm delete?");



                    while (true) {
                        thread("Enter choice (1=Yes,2=No): ");
                        trap(confirmDelete);


                        if (confirmDelete == 1) {
                            break;
                        }
                        if (confirmDelete == 2) {
                            break;
                        }


                        threadln("Invalid delete choice.");
                    }


                    if (confirmDelete == 1) {
                        j = found;
                        while (j < count - 1) {
                            nextIndex = j + 1;
                            names[j] = names[nextIndex];
                            studentNos[j] = studentNos[nextIndex];
                            courses[j] = courses[nextIndex];
                            j = j + 1;
                        }


                        count = count - 1;
                        threadln("Record deleted successfully.");
                    }
                    else {
                        threadln("Delete cancelled.");
                    }
                }
            }
        }


        else if (choice == 6) {
            threadln("Exiting program...");
        }


        else if (choice == 4) {
    if (count == 0) {
        threadln("No records found.");
    }
    else {



        while (true) {
            thread("Enter Student Number to edit: ");
            trap(searchNo);


            if (searchNo >= 0) {
                break;
            }


            threadln("Invalid student number.");
        }


        found = -1;
        i = 0;
        while (i < count) {
            if (studentNos[i] == searchNo) {
                found = i;
                i = count;
            }
            else {
                i = i + 1;
            }
        }


        if (found == -1) {
            threadln("Record not found.");
        }
        else {
            threadln("===== CURRENT STUDENT RECORD =====");
            thread("Name: ");
            threadln(names[found]);
            thread("Student Number: ");
            threadln(studentNos[found]);
            thread("Course: ");
            threadln(courses[found]);
            threadln("");



            while (true) {
                threadln("1. Name");
                threadln("2. Course");
                threadln("3. Both Name and Course");
                thread("Enter choice: ");
                trap(editChoice);


                if (editChoice >= 1) {
                    if (editChoice <= 3) {
                        break;
                    }
                }


                threadln("Invalid edit choice.");
            }



            if (editChoice == 1 || editChoice == 3) {


                while (true) {
                    thread("Enter new Student Name: ");
                    trap(tempName);


                    validName = true;
                    nameLen = len(tempName);
                    i = 0;


                    while (i < nameLen) {
                        ch = tempName[i];
                        if (!((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch == ' ') || (ch == '.'))) {
                            validName = false;
                        }
                        i = i + 1;
                    }


                    if (nameLen == 0) {
                        validName = false;
                    }


                    if (validName == true) {
                        break;
                    }


                    threadln("Invalid student name.");
                }


                names[found] = tempName;
            }



            if (editChoice == 2 || editChoice == 3) {


                while (true) {
                    thread("Enter new Course: ");
                    trap(tempCourse);


                    validCourse = true;
                    courseLen = len(tempCourse);
                    j = 0;


                    while (j < courseLen) {
                        ch = tempCourse[j];
                        if (!((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z') || (ch == ' ') || (ch == '.'))) {
                            validCourse = false;
                        }
                        j = j + 1;
                    }


                    if (courseLen == 0) {
                        validCourse = false;
                    }


                    if (validCourse == true) {
                        break;
                    }


                    threadln("Invalid course.");
                }


                courses[found] = tempCourse;
            }


            threadln("Record updated successfully.");
        }
    }
}
    }


    return 0;
}
