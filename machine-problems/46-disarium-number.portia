func int powerInt(int base, int exp) {
    if (exp == 0) {
        return 1;
    }


    return base * powerInt(base, exp - 1);
}


func int countDigits(int n) {
    local var int count = 0;


    if (n == 0) {
        return 1;
    }


    while (n > 0) {
        count = count + 1;
        n = n / 10;
    }


    return count;
}


func int isDisarium(int n) {
    local var int temp = 0;
    local var int pos = 0;
    local var int sum = 0;


    if (n == 0) {
        return 1;
    }


    temp = n;
    pos = countDigits(n);


    while (temp > 0) {
        sum = sum + powerInt(temp % 10, pos);
        temp = temp / 10;
        pos = pos - 1;
    }


    if (sum == n) {
        return 1;
    }


    return 0;
}


int main() {
    local var int n = 0;
    local var int choice = 1;


    while (choice == 1) {
        thread("Enter a number (-1 to exit): ");
        trap(n);


        if (n == -1) {
            threadln("Program exited.");
            return 0;
        }


        if (n < 0) {
            threadln("Invalid input. Please enter a non-negative integer.");
        } else {
            if (isDisarium(n) == 1) {
                threadln("Disarium number");
            } else {
                threadln("Not a Disarium number");
            }
        }


        thread("Enter 1 to try again, 0 to exit: ");
        trap(choice);


        while (choice != 1 && choice != 0) {
            thread("Invalid choice. Enter 1 to try again, 0 to exit: ");
            trap(choice);
        }
    }


    threadln("Program exited.");
    return 0;
}
