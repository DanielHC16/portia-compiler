int main() {
    local var int n = 0;
    local var int i = 0;
    local var int arr[100];


    thread("Input the number of elements to be stored in the array: ");
    trap(n);



    while(n <= 0) {
        threadln("Invalid array size. Must be greater than 0.");

    if(n > 0){
        break;
    }
    thread("Input the number of elements to be stored in the array: ");
    trap(n);
    }


    threadln("Input elements in the array:");


    i = 0;
    while (i < n) {
        trap(arr[i]);
        i = i + 1;
    }


    threadln("The elements in the array are:");


    i = 0;
    while (i < n) {
        thread(arr[i]);
        thread(" ");
        i = i + 1;
    }


    return 0;
}
