int main() {
    local var string word = "";
    local var int i = 0;
    local var int count = 0;
    local var char ch = ' ';


    threadln("Enter a word:");
    trap(word);


    while (i < len(word)) {
        ch = word[i];


        if (ch >= 'A' && ch <= 'Z') {
            count = count + 1;
        }


        i = i + 1;
    }


    thread("No of capital letters: ");
    threadln(count);


    return 0;
}
