int main() {
    local var int rows = 0;
    local var int i = 0;
    local var int j = 0;
    local var int k = 0;
    local var int val = 1;


    thread("Enter number of rows: ");
    trap(rows);


    while (rows < 0) {
        threadln("Negative numbers are not allowed.");
        thread("Enter number of rows again: ");
        trap(rows);
    }


    i = 0;
    while (i < rows) {
        k = 0;
        while (k < rows - i - 1) {
            thread(" ");
            k = k + 1;
        }


        val = 1;
        j = 0;
        while (j <= i) {
            thread(val);
            thread(" ");


            val = (val * (i - j)) / (j + 1);
            j = j + 1;
        }


        threadln("");
        i = i + 1;
    }


    return 0;
}
