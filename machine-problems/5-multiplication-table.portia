int main() {
    local var int m = 0;
    local var int n = 0;
    local var int r = 0;
    local var int c = 0;
    local var int result = 0;
    thread("Enter number of rows (m): ");
    trap(m);
    thread("Enter number of columns (n): ");
    trap(n);
    threadln("Multiplication Table:");
    r = 1;
    while (r <= m) {
        c = 1;
        while (c <= n) {
            result = r * c;
            if (result < 10) { thread("  "); }
            else if (result < 100) { thread(" "); }
            thread(result);
            thread("   ");
            c = c + 1;
        }
        threadln("");
        r = r + 1;
    }
    return 0;
}
