int main() {
    local var int num1 = 0;
    local var int num2 = 0;
    local var int num3 = 0;
    local var int choice = 0;
    local var int temp = 0;



    threadln("Input 3 elements:");


    thread("Element No. 1: ");
    trap(num1);


    thread("Element No. 2: ");
    trap(num2);


    thread("Element No. 3: ");
    trap(num3);


    do {
        threadln("");
        threadln("Sort Out:");
        threadln("1. Ascending");
        threadln("2. Descending");
        threadln("3. Input new elements");
        threadln("4. Exit");
        thread("Enter choice: ");
        trap(choice);


        switch (choice) {


            case 1:

                if (num1 > num2) {
                    temp = num1;
                    num1 = num2;
                    num2 = temp;
                }


                if (num1 > num3) {
                    temp = num1;
                    num1 = num3;
                    num3 = temp;
                }


                if (num2 > num3) {
                    temp = num2;
                    num2 = num3;
                    num3 = temp;
                }


                thread("Ascending order: ");
                thread(num1); thread("  ");
                thread(num2); thread("  ");
                thread(num3); threadln("");
                break;


            case 2:

                if (num1 < num2) {
                    temp = num1;
                    num1 = num2;
                    num2 = temp;
                }


                if (num1 < num3) {
                    temp = num1;
                    num1 = num3;
                    num3 = temp;
                }


                if (num2 < num3) {
                    temp = num2;
                    num2 = num3;
                    num3 = temp;
                }


                thread("Descending order: ");
                thread(num1); thread("  ");
                thread(num2); thread("  ");
                thread(num3); threadln("");
                break;


            case 3:

              threadln("Input new 3 elements:");


               thread("Element No. 1: ");
               trap(num1);


               thread("Element No. 2: ");
               trap(num2);


               thread("Element No. 3: ");
               trap(num3);
                break;


            case 4:
                threadln("Exiting program...");
                break;


            default:
                threadln("Invalid Input");
                break;
        }


    } while (choice != 4);


    return 0;
}
