int main() {
    local var int num = 0;
    local var int sum = 0;
    local var int i = 1;


    do {
        thread("Enter a positive integer: ");
        trap(num);


        if (num <= 0) {
            threadln("Invalid input. Number must be positive.");
        }
    } while (num <= 0);


    i = 1;
    while (i <= num / 2) {
        if (num % i == 0) {
            sum = sum + i;
        }
        i = i + 1;
    }


    if (sum == num) {
        threadln("Perfect Number");
    } else {
        threadln("Not a Perfect Number");
    }


    return 0;
}
