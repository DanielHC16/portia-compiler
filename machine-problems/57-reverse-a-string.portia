int main() {
    local var string word = "";
    local var int i = 0;
    local var int length = 0;


    thread("Enter a string: ");
    trap(word);


    length = len(word);


    thread("Reversed string: ");


    i = length - 1;
    while (i >= 0) {
        thread(word[i]);
        i = i - 1;
    }


    threadln("");


    return 0;
}
