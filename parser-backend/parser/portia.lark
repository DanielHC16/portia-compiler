// PORTIA Language Grammar for Lark LALR(1) Parser
// Strict LL(1) grammar - no ambiguity, no left recursion, fully left-factored
// Note: Lark uses LALR(1), which parses all LL(1) grammars deterministically

// ============================================
// PROGRAM STRUCTURE
// ============================================

start: program

program: top_list

top_list: top_item top_list
        |

top_item: GLOBAL mutability dtype ID ASSIGN expression multi_global SEMICOLON
        | INT int_top_tail
        | LONG ID typed_decl_tail
        | FLOAT ID typed_decl_tail
        | DOUBLE ID typed_decl_tail
        | CHAR ID typed_decl_tail
        | STRING ID typed_decl_tail
        | BOOL ID typed_decl_tail
        | WEAVE ID LBRACE field_list RBRACE SEMICOLON
        | ID weave_inst_decl
        | FUNC ret_type ID LPAREN param_list RPAREN LBRACE function_body RBRACE

// Left-factor INT: could be array/var decl (ID) or main_func (MAIN)
int_top_tail: ID typed_decl_tail
            | MAIN LPAREN RPAREN LBRACE main_body RBRACE

multi_global: COMMA ID ASSIGN expression multi_global
            |

weave_inst_decl: ID weave_inst_tail weave_inst_cont SEMICOLON
               | array_dims arr_init_opt weave_arr_cont SEMICOLON

weave_inst_tail: ASSIGN LBRACE weave_field_value weave_field_list_tail RBRACE
               | array_dims arr_init_opt

weave_field_value: INTLIT
                 | LONGLIT
                 | FLOATLIT
                 | DOUBLELIT
                 | CHARLIT
                 | STRINGLIT
                 | TRUE
                 | FALSE
                 | LBRACE weave_arr_content RBRACE

weave_arr_content: LBRACE elem_list RBRACE elem_2d_tail
                 | arr_elem elem_1d_tail
                 |

weave_field_list_tail: COMMA weave_field_value weave_field_list_tail
                     |

weave_inst_cont: COMMA ID weave_inst_tail weave_inst_cont
               |

weave_arr_cont: COMMA ID array_dims arr_init_opt weave_arr_cont
              |

typed_decl_tail: array_dims arr_init_opt SEMICOLON
               | ASSIGN expression multi_typed SEMICOLON

multi_typed: COMMA ID ASSIGN expression multi_typed
           |

// ============================================
// MUTABILITY & TYPES
// ============================================

mutability: VAR
          | CONST

dtype: INT
     | LONG
     | FLOAT
     | DOUBLE
     | CHAR
     | STRING
     | BOOL

// ============================================
// VALUES & LITERALS
// ============================================

value: INTLIT
     | LONGLIT
     | FLOATLIT
     | DOUBLELIT
     | CHARLIT
     | STRINGLIT
     | TRUE
     | FALSE

value_list_tail: COMMA value value_list_tail
               |

// ============================================
// SHARED ARRAY DIMENSION RULES (MAX 2D)
// ============================================

array_dims: LBRACK size RBRACK array_dim2_opt

array_dim2_opt: LBRACK size RBRACK
              |

// ============================================
// ARRAY DECLARATIONS
// ============================================

arr_init_opt: ASSIGN LBRACE arr_init_content RBRACE
            |

arr_init_content: LBRACE elem_list RBRACE elem_2d_tail
                | arr_elem elem_1d_tail
                |

elem_2d_tail: COMMA LBRACE elem_list RBRACE elem_2d_tail
            |

elem_list: arr_elem elem_1d_tail
         |

elem_1d_tail: COMMA arr_elem elem_1d_tail
            |

arr_elem: INT LPAREN value RPAREN
        | LONG LPAREN value RPAREN
        | FLOAT LPAREN value RPAREN
        | DOUBLE LPAREN value RPAREN
        | CHAR LPAREN value RPAREN
        | STRING LPAREN value RPAREN
        | BOOL LPAREN value RPAREN
        | INTLIT
        | LONGLIT
        | FLOATLIT
        | DOUBLELIT
        | CHARLIT
        | STRINGLIT
        | TRUE
        | FALSE

size: INTLIT
    | ID

// ============================================
// WEAVE (STRUCT) DEFINITIONS
// ============================================

field_list: field_dec field_list
          |

field_dec: field_type ID field_arr_opt field_cont SEMICOLON

field_type: INT
          | LONG
          | FLOAT
          | DOUBLE
          | CHAR
          | STRING
          | BOOL
          | ID

field_arr_opt: array_dims
             |

field_cont: COMMA ID field_arr_opt field_cont
          |

// ============================================
// FUNCTIONS
// ============================================

ret_type: INT ret_type_suffix
        | LONG ret_type_suffix
        | FLOAT ret_type_suffix
        | DOUBLE ret_type_suffix
        | CHAR ret_type_suffix
        | STRING ret_type_suffix
        | BOOL ret_type_suffix
        | VOID
        | ID ret_id_suffix

ret_type_suffix: array_dims
               |

ret_id_suffix: array_dims
             | DOT ID
             |

param_list: param_type ID param_arr_opt param_cont
          |

param_type: INT
          | LONG
          | FLOAT
          | DOUBLE
          | CHAR
          | STRING
          | BOOL
          | ID

param_arr_opt: array_dims
             |

param_cont: COMMA param_type ID param_arr_opt param_cont
          |

function_body: using_block local_block stmt_list return_opt

return_opt: RETURN return_value SEMICOLON
          |

return_value: expression
            |

// ============================================
// USING BLOCK
// ============================================

using_block: USING ID using_cont SEMICOLON using_block
           |

using_cont: COMMA ID using_cont
          |

// ============================================
// LOCAL DECLARATIONS
// ============================================

local_block: LOCAL mutability local_dec_body local_block
           |

local_dec_body: INT ID typed_local_tail
              | LONG ID typed_local_tail
              | FLOAT ID typed_local_tail
              | DOUBLE ID typed_local_tail
              | CHAR ID typed_local_tail
              | STRING ID typed_local_tail
              | BOOL ID typed_local_tail
              | ID ID weave_local_tail

typed_local_tail: array_dims arr_init_opt SEMICOLON
                | ASSIGN expression multi_local SEMICOLON

multi_local: COMMA ID ASSIGN expression multi_local
           |

weave_local_tail: ASSIGN LBRACE weave_field_value weave_field_list_tail RBRACE weave_inst_cont SEMICOLON
                | array_dims arr_init_opt weave_arr_cont SEMICOLON

// ============================================
// STATEMENTS
// ============================================

stmt_list: statement stmt_list
         |

statement: expression SEMICOLON
         | io_stmt
         | ctrl_struct
         | BREAK SEMICOLON

// ============================================
// UNIFIED EXPRESSION GRAMMAR
// ============================================

expression: assign_expr

assign_expr: concat_expr assign_tail

assign_tail: assign_op assign_expr
           |

assign_op: ASSIGN
         | PLUSEQ
         | MINUSEQ
         | STAREQ
         | SLASHEQ
         | MODEQ

concat_expr: or_expr concat_tail

concat_tail: CONCAT or_expr concat_tail
           |

// ============================================
// BOOLEAN / LOGICAL EXPRESSIONS
// ============================================

or_expr: and_expr or_tail

or_tail: OR and_expr or_tail
       |

and_expr: eq_expr and_tail

and_tail: AND eq_expr and_tail
        |

eq_expr: rel_expr eq_tail

eq_tail: EQ rel_expr eq_tail
       | NEQ rel_expr eq_tail
       |

rel_expr: add_expr rel_tail

rel_tail: LT add_expr
        | GT add_expr
        | LTE add_expr
        | GTE add_expr
        |

// ============================================
// ARITHMETIC EXPRESSIONS
// ============================================

add_expr: mul_expr add_tail

add_tail: PLUS mul_expr add_tail
        | MINUS mul_expr add_tail
        |

mul_expr: unary_expr mul_tail

mul_tail: STAR unary_expr mul_tail
        | SLASH unary_expr mul_tail
        | MOD unary_expr mul_tail
        |

unary_expr: PLUS unary_expr
          | MINUS unary_expr
          | NOT unary_expr
          | INCR unary_expr
          | DECR unary_expr
          | postfix_expr

postfix_expr: LPAREN expression RPAREN postfix_chain
            | INT LPAREN expression RPAREN
            | LONG LPAREN expression RPAREN
            | FLOAT LPAREN expression RPAREN
            | DOUBLE LPAREN expression RPAREN
            | CHAR LPAREN expression RPAREN
            | STRING LPAREN expression RPAREN
            | BOOL LPAREN expression RPAREN
            | ID postfix_chain
            | INTLIT
            | LONGLIT
            | FLOATLIT
            | DOUBLELIT
            | CHARLIT
            | STRINGLIT
            | TRUE
            | FALSE

// ============================================
// IDENTIFIER POSTFIX CHAIN (MAX 2D ARRAY ACCESS)
// ============================================

postfix_chain: array_access postfix_after_arr
             | DOT ID postfix_chain
             | LPAREN arg_list RPAREN postfix_chain
             | INCR
             | DECR
             |

array_access: LBRACK array_index RBRACK array_access_dim2

array_access_dim2: LBRACK array_index RBRACK
                 |

postfix_after_arr: DOT ID postfix_chain
                 | LPAREN arg_list RPAREN postfix_chain
                 | INCR
                 | DECR
                 |

array_index: INTLIT
           | ID

arg_list: expression arg_tail
        |

arg_tail: COMMA expression arg_tail
        |

// ============================================
// I/O STATEMENTS
// ============================================

io_stmt: TRAP LPAREN expression RPAREN SEMICOLON
       | THREAD LPAREN print_args RPAREN SEMICOLON
       | THREADLN LPAREN print_args RPAREN SEMICOLON

print_args: expression print_tail

print_tail: COMMA expression print_tail
          |

// ============================================
// CONTROL STRUCTURES
// ============================================

ctrl_struct: IF LPAREN cond_or_expr RPAREN LBRACE stmt_list RBRACE else_opt
           | SWITCH LPAREN expression RPAREN LBRACE case_list default_opt RBRACE
           | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE stmt_list RBRACE
           | WHILE LPAREN cond_or_expr RPAREN LBRACE stmt_list RBRACE
           | DO LBRACE stmt_list RBRACE WHILE LPAREN cond_or_expr RPAREN SEMICOLON

else_opt: ELSE else_body
        |

else_body: LBRACE stmt_list RBRACE
         | IF LPAREN cond_or_expr RPAREN LBRACE stmt_list RBRACE else_opt

case_list: CASE case_val COLON stmt_list break_opt case_list
         |

case_val: INTLIT
        | LONGLIT
        | CHARLIT
        | TRUE
        | FALSE

default_opt: DEFAULT COLON stmt_list break_opt
           |

break_opt: BREAK SEMICOLON
         |

for_init: LOCAL VAR for_init_type ID ASSIGN expression
        | ID for_init_assign_tail
        |

for_init_assign_tail: assign_op expression

for_init_type: INT
             | LONG
             | FLOAT
             | DOUBLE
             | CHAR
             | STRING
             | BOOL

for_cond: cond_or_expr
        |

cond_or_expr: cond_and_expr cond_or_tail

cond_or_tail: OR cond_and_expr cond_or_tail
            |

cond_and_expr: cond_eq_expr cond_and_tail

cond_and_tail: AND cond_eq_expr cond_and_tail
             |

cond_eq_expr: cond_rel_expr cond_eq_tail

cond_eq_tail: EQ cond_rel_expr cond_eq_tail
            | NEQ cond_rel_expr cond_eq_tail
            |

cond_rel_expr: cond_add_expr cond_rel_tail

cond_rel_tail: LT cond_add_expr
             | GT cond_add_expr
             | LTE cond_add_expr
             | GTE cond_add_expr
             |

cond_add_expr: cond_mul_expr cond_add_tail

cond_add_tail: PLUS cond_mul_expr cond_add_tail
             | MINUS cond_mul_expr cond_add_tail
             |

cond_mul_expr: cond_unary_expr cond_mul_tail

cond_mul_tail: STAR cond_unary_expr cond_mul_tail
             | SLASH cond_unary_expr cond_mul_tail
             | MOD cond_unary_expr cond_mul_tail
             |

cond_unary_expr: PLUS cond_unary_expr
               | MINUS cond_unary_expr
               | NOT cond_unary_expr
               | cond_primary

cond_primary: LPAREN cond_or_expr RPAREN
            | INT LPAREN cond_or_expr RPAREN
            | LONG LPAREN cond_or_expr RPAREN
            | FLOAT LPAREN cond_or_expr RPAREN
            | DOUBLE LPAREN cond_or_expr RPAREN
            | CHAR LPAREN cond_or_expr RPAREN
            | STRING LPAREN cond_or_expr RPAREN
            | BOOL LPAREN cond_or_expr RPAREN
            | ID cond_postfix
            | INTLIT
            | LONGLIT
            | FLOATLIT
            | DOUBLELIT
            | CHARLIT
            | STRINGLIT
            | TRUE
            | FALSE

cond_postfix: LPAREN arg_list RPAREN
            |

for_update: ID for_update_tail
          | INCR ID
          | DECR ID
          |

for_update_tail: INCR
               | DECR
               | assign_op expression

// ============================================
// MAIN FUNCTION BODY
// ============================================

main_body: using_block local_block stmt_list RETURN INTLIT SEMICOLON

// ============================================
// TERMINALS
// ============================================

GLOBAL: "global"
LOCAL: "local"
FUNC: "func"
RETURN: "return"
IF: "if"
ELSE: "else"
SWITCH: "switch"
CASE: "case"
DEFAULT: "default"
FOR: "for"
WHILE: "while"
DO: "do"
BREAK: "break"
TRAP: "trap"
THREAD: "thread"
THREADLN: "threadln"
USING: "using"
WEAVE: "weave"
MAIN: "main"

INT: "int"
LONG: "long"
FLOAT: "float"
DOUBLE: "double"
CHAR: "char"
STRING: "string"
BOOL: "bool"
VOID: "void"

VAR: "var"
CONST: "const"
TRUE: "true"
FALSE: "false"

ASSIGN: "="
PLUSEQ: "+="
MINUSEQ: "-="
STAREQ: "*="
SLASHEQ: "/="
MODEQ: "%="

EQ: "=="
NEQ: "!="
LT: "<"
GT: ">"
LTE: "<="
GTE: ">="

AND: "&&"
OR: "||"
NOT: "!"

PLUS: "+"
MINUS: "-"
STAR: "*"
SLASH: "/"
MOD: "%"
INCR: "++"
DECR: "--"
CONCAT: ".."

LPAREN: "("
RPAREN: ")"
LBRACE: "{"
RBRACE: "}"
LBRACK: "["
RBRACK: "]"
SEMICOLON: ";"
COMMA: ","
COLON: ":"
DOT: "."

ID: /[a-zA-Z_][a-zA-Z0-9_]*/
INTLIT: /-?[0-9]{1,10}/
LONGLIT: /-?[0-9]{11,19}/
FLOATLIT: /-?[0-9]+\.[0-9]{1,7}/
DOUBLELIT: /-?[0-9]+\.[0-9]{8,16}/
CHARLIT: /'[^']'/
STRINGLIT: /"[^"]*"/

%ignore /[ \t\n]+/
%ignore /\/\/[^\n]*/
%ignore /\/\*.*?\*\//s
