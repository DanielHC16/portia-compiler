// PORTIA Language Grammar for Lark LALR(1) Parser
// Strict LL(1) grammar - no ambiguity, no left recursion, fully left-factored
// Note: Lark uses LALR(1), which parses all LL(1) grammars deterministically
// STRICT TYPE-LITERAL MATCHING: declarations accept ONLY matching literal types
// Expressions are FORBIDDEN in all declaration contexts
// EMPTY INITIALIZERS FORBIDDEN: {} is syntactically impossible (R2 compliant)

// ============================================
// PROGRAM STRUCTURE
// ============================================
// STRICT SECTION ORDERING:
// 1. Global declarations (0 or more) - must start with GLOBAL keyword
// 2. Bare top-level arrays (0 or more) - type id[size] = {...};
// 3. Weave definitions (0 or more) - weave type definitions
// 4. Weave instances (0 or more) - instances of weave types
// 5. Function declarations (0 or more) - all func definitions
// 6. Main block (exactly one, required, must be last)
// BARE SCALAR DECLARATIONS FORBIDDEN at top level (e.g., "int x = 5;" is illegal)
// Bare arrays allowed: int arr[3] = {1,2,3}; (array bracket required after id)

?start: program

program: global_section

// Global section: processes globals/weaves/arrays, then transitions to functions or main
// TYPE ID at top level requires [ (array) - scalar declarations forbidden
// INT MAIN is the main function entry point
global_section: global_decl global_section
              | INT ID int_array_with_init SEMICOLON global_section
              | LONG ID long_array_with_init SEMICOLON global_section
              | FLOAT ID float_array_with_init SEMICOLON global_section
              | DOUBLE ID double_array_with_init SEMICOLON global_section
              | CHAR ID char_array_with_init SEMICOLON global_section
              | STRING ID string_array_with_init SEMICOLON global_section
              | BOOL ID bool_array_with_init SEMICOLON global_section
              | WEAVE ID LBRACE field_list RBRACE SEMICOLON global_section
              | ID weave_inst_decl global_section
              | function_decl func_and_main
              | INT MAIN LPAREN RPAREN LBRACE main_body RBRACE

// Function section: one or more functions, then mandatory main
// Once here, no more globals allowed - strict section ordering enforced
func_and_main: function_decl func_and_main
             | INT MAIN LPAREN RPAREN LBRACE main_body RBRACE

// Global declarations - MUST start with GLOBAL keyword
// Each type accepts ONLY its matching literal type
global_decl: GLOBAL mutability INT ID ASSIGN INTLIT int_global_cont SEMICOLON
           | GLOBAL mutability LONG ID ASSIGN LONGLIT long_global_cont SEMICOLON
           | GLOBAL mutability FLOAT ID ASSIGN FLOATLIT float_global_cont SEMICOLON
           | GLOBAL mutability DOUBLE ID ASSIGN DOUBLELIT double_global_cont SEMICOLON
           | GLOBAL mutability CHAR ID ASSIGN CHARLIT char_global_cont SEMICOLON
           | GLOBAL mutability STRING ID ASSIGN STRINGLIT string_global_cont SEMICOLON
           | GLOBAL mutability BOOL ID ASSIGN bool_lit bool_global_cont SEMICOLON

// All function declarations (start with FUNC)
function_decl: FUNC INT func_ret_int
             | FUNC LONG func_ret_long
             | FUNC FLOAT func_ret_float
             | FUNC DOUBLE func_ret_double
             | FUNC CHAR func_ret_char
             | FUNC STRING func_ret_string
             | FUNC BOOL func_ret_bool
             | FUNC ID func_ret_weave
             | FUNC VOID ID LPAREN RPAREN LBRACE function_body_void RBRACE

// Boolean literal helper
bool_lit: TRUE
        | FALSE

// ============================================
// GLOBAL DECLARATION CONTINUATIONS
// ============================================
// Multi-variable global declarations - type-specific literal enforcement

int_global_cont: COMMA ID ASSIGN INTLIT int_global_cont
               |

long_global_cont: COMMA ID ASSIGN LONGLIT long_global_cont
                |

float_global_cont: COMMA ID ASSIGN FLOATLIT float_global_cont
                 |

double_global_cont: COMMA ID ASSIGN DOUBLELIT double_global_cont
                  |

char_global_cont: COMMA ID ASSIGN CHARLIT char_global_cont
                |

string_global_cont: COMMA ID ASSIGN STRINGLIT string_global_cont
                  |

bool_global_cont: COMMA ID ASSIGN bool_lit bool_global_cont
                |

// ============================================
// WEAVE INSTANCE DECLARATIONS
// ============================================
// Weave instances use literal-only field values
// Type checking for weave fields is semantic (field types unknown at parse time)

weave_inst_decl: ID weave_inst_tail weave_inst_cont SEMICOLON
               | weave_array_with_init weave_arr_cont SEMICOLON

weave_inst_tail: ASSIGN LBRACE weave_field_value weave_field_list_tail RBRACE
               | weave_array_with_init

// Weave field values support nested braces for arrays and nested weaves
// Simplified recursive structure avoids LALR conflicts
weave_field_value: INTLIT
                 | LONGLIT
                 | FLOATLIT
                 | DOUBLELIT
                 | CHARLIT
                 | STRINGLIT
                 | TRUE
                 | FALSE
                 | LBRACE weave_value_list RBRACE

// Recursive comma-separated list of field values (handles 1D, 2D, nested weaves)
// Non-nullable: nested braces must contain at least one value
weave_value_list: weave_field_value weave_value_tail

weave_value_tail: COMMA weave_field_value weave_value_tail
                |

weave_field_list_tail: COMMA weave_field_value weave_field_list_tail
                     |

weave_inst_cont: COMMA ID weave_inst_tail weave_inst_cont
               |

weave_arr_cont: COMMA ID weave_array_with_init weave_arr_cont
              |

weave_array_with_init: LBRACK size RBRACK weave_array_init_tail

weave_array_init_tail: LBRACK size RBRACK weave_arr_init_opt_2d
                     | weave_arr_init_opt_1d

weave_arr_init_opt_1d: ASSIGN LBRACE weave_arr_init_content_1d RBRACE
                     |

weave_arr_init_content_1d: LBRACE weave_field_value weave_field_list_tail RBRACE weave_init_1d_tail

weave_init_1d_tail: COMMA LBRACE weave_field_value weave_field_list_tail RBRACE weave_init_1d_tail
                  |

weave_arr_init_opt_2d: ASSIGN LBRACE weave_arr_init_content_2d RBRACE
                     |

weave_arr_init_content_2d: LBRACE weave_init_row RBRACE weave_init_2d_tail

weave_init_row: LBRACE weave_field_value weave_field_list_tail RBRACE weave_init_1d_tail

weave_init_2d_tail: COMMA LBRACE weave_init_row RBRACE weave_init_2d_tail
                  |

// ============================================
// MUTABILITY
// ============================================

mutability: VAR
          | CONST

// ============================================
// SHARED ARRAY DIMENSION RULES
// ============================================
// Used for field declarations and parameter types (no initializers)

array_dims: LBRACK size RBRACK array_dim2_opt

array_dim2_opt: LBRACK size RBRACK
              |

size: INTLIT
    | ID

// ============================================
// TYPE-SPECIFIC ARRAY DECLARATIONS
// ============================================
// Each type has dedicated array rules - elements are raw literals only
// NO type casts, NO expressions, NO identifiers in array initializers

// INT ARRAYS
int_array_with_init: LBRACK size RBRACK int_array_init_tail

int_array_init_tail: LBRACK size RBRACK int_arr_init_opt_2d
                   | int_arr_init_opt_1d

int_arr_init_opt_1d: ASSIGN LBRACE int_arr_init_content_1d RBRACE
                   |

int_arr_init_content_1d: INTLIT int_elem_1d_tail

int_elem_1d_tail: COMMA INTLIT int_elem_1d_tail
                |

int_arr_init_opt_2d: ASSIGN LBRACE int_arr_init_content_2d RBRACE
                   |

int_arr_init_content_2d: LBRACE int_elem_list RBRACE int_elem_2d_tail

int_elem_list: INTLIT int_elem_1d_tail

int_elem_2d_tail: COMMA LBRACE int_elem_list RBRACE int_elem_2d_tail
                |

// LONG ARRAYS
long_array_with_init: LBRACK size RBRACK long_array_init_tail

long_array_init_tail: LBRACK size RBRACK long_arr_init_opt_2d
                    | long_arr_init_opt_1d

long_arr_init_opt_1d: ASSIGN LBRACE long_arr_init_content_1d RBRACE
                    |

long_arr_init_content_1d: LONGLIT long_elem_1d_tail

long_elem_1d_tail: COMMA LONGLIT long_elem_1d_tail
                 |

long_arr_init_opt_2d: ASSIGN LBRACE long_arr_init_content_2d RBRACE
                    |

long_arr_init_content_2d: LBRACE long_elem_list RBRACE long_elem_2d_tail

long_elem_list: LONGLIT long_elem_1d_tail

long_elem_2d_tail: COMMA LBRACE long_elem_list RBRACE long_elem_2d_tail
                 |

// FLOAT ARRAYS
float_array_with_init: LBRACK size RBRACK float_array_init_tail

float_array_init_tail: LBRACK size RBRACK float_arr_init_opt_2d
                     | float_arr_init_opt_1d

float_arr_init_opt_1d: ASSIGN LBRACE float_arr_init_content_1d RBRACE
                     |

float_arr_init_content_1d: FLOATLIT float_elem_1d_tail

float_elem_1d_tail: COMMA FLOATLIT float_elem_1d_tail
                  |

float_arr_init_opt_2d: ASSIGN LBRACE float_arr_init_content_2d RBRACE
                     |

float_arr_init_content_2d: LBRACE float_elem_list RBRACE float_elem_2d_tail

float_elem_list: FLOATLIT float_elem_1d_tail

float_elem_2d_tail: COMMA LBRACE float_elem_list RBRACE float_elem_2d_tail
                  |

// DOUBLE ARRAYS
double_array_with_init: LBRACK size RBRACK double_array_init_tail

double_array_init_tail: LBRACK size RBRACK double_arr_init_opt_2d
                      | double_arr_init_opt_1d

double_arr_init_opt_1d: ASSIGN LBRACE double_arr_init_content_1d RBRACE
                      |

double_arr_init_content_1d: DOUBLELIT double_elem_1d_tail

double_elem_1d_tail: COMMA DOUBLELIT double_elem_1d_tail
                   |

double_arr_init_opt_2d: ASSIGN LBRACE double_arr_init_content_2d RBRACE
                      |

double_arr_init_content_2d: LBRACE double_elem_list RBRACE double_elem_2d_tail

double_elem_list: DOUBLELIT double_elem_1d_tail

double_elem_2d_tail: COMMA LBRACE double_elem_list RBRACE double_elem_2d_tail
                   |

// CHAR ARRAYS
char_array_with_init: LBRACK size RBRACK char_array_init_tail

char_array_init_tail: LBRACK size RBRACK char_arr_init_opt_2d
                    | char_arr_init_opt_1d

char_arr_init_opt_1d: ASSIGN LBRACE char_arr_init_content_1d RBRACE
                    |

char_arr_init_content_1d: CHARLIT char_elem_1d_tail

char_elem_1d_tail: COMMA CHARLIT char_elem_1d_tail
                 |

char_arr_init_opt_2d: ASSIGN LBRACE char_arr_init_content_2d RBRACE
                    |

char_arr_init_content_2d: LBRACE char_elem_list RBRACE char_elem_2d_tail

char_elem_list: CHARLIT char_elem_1d_tail

char_elem_2d_tail: COMMA LBRACE char_elem_list RBRACE char_elem_2d_tail
                 |

// STRING ARRAYS
string_array_with_init: LBRACK size RBRACK string_array_init_tail

string_array_init_tail: LBRACK size RBRACK string_arr_init_opt_2d
                      | string_arr_init_opt_1d

string_arr_init_opt_1d: ASSIGN LBRACE string_arr_init_content_1d RBRACE
                      |

string_arr_init_content_1d: STRINGLIT string_elem_1d_tail

string_elem_1d_tail: COMMA STRINGLIT string_elem_1d_tail
                   |

string_arr_init_opt_2d: ASSIGN LBRACE string_arr_init_content_2d RBRACE
                      |

string_arr_init_content_2d: LBRACE string_elem_list RBRACE string_elem_2d_tail

string_elem_list: STRINGLIT string_elem_1d_tail

string_elem_2d_tail: COMMA LBRACE string_elem_list RBRACE string_elem_2d_tail
                   |

// BOOL ARRAYS
bool_array_with_init: LBRACK size RBRACK bool_array_init_tail

bool_array_init_tail: LBRACK size RBRACK bool_arr_init_opt_2d
                    | bool_arr_init_opt_1d

bool_arr_init_opt_1d: ASSIGN LBRACE bool_arr_init_content_1d RBRACE
                    |

bool_arr_init_content_1d: bool_lit bool_elem_1d_tail

bool_elem_1d_tail: COMMA bool_lit bool_elem_1d_tail
                 |

bool_arr_init_opt_2d: ASSIGN LBRACE bool_arr_init_content_2d RBRACE
                    |

bool_arr_init_content_2d: LBRACE bool_elem_list RBRACE bool_elem_2d_tail

bool_elem_list: bool_lit bool_elem_1d_tail

bool_elem_2d_tail: COMMA LBRACE bool_elem_list RBRACE bool_elem_2d_tail
                 |

// ============================================
// WEAVE (STRUCT) DEFINITIONS
// ============================================

field_list: field_dec field_list
          |

field_dec: field_type ID field_arr_opt field_cont SEMICOLON

field_type: INT
          | LONG
          | FLOAT
          | DOUBLE
          | CHAR
          | STRING
          | BOOL
          | ID

field_arr_opt: array_dims
             |

field_cont: COMMA ID field_arr_opt field_cont
          |

// ============================================
// FUNCTIONS
// ============================================
// R10 — Strict Return Type Enforcement
// Return statements are syntactically restricted to the declared return type category
// Scalar returns: type-specific expressions (literals and casts filtered at top level)
// Array returns: identifier only (no literals, no expressions)
// Weave returns: identifier only (no field access)
// Void returns: bare return only

// Function return type tails - select appropriate body based on return type category
func_ret_int: ID LPAREN param_list RPAREN LBRACE function_body_int RBRACE
            | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_long: ID LPAREN param_list RPAREN LBRACE function_body_long RBRACE
             | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_float: ID LPAREN param_list RPAREN LBRACE function_body_float RBRACE
              | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_double: ID LPAREN param_list RPAREN LBRACE function_body_double RBRACE
               | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_char: ID LPAREN param_list RPAREN LBRACE function_body_char RBRACE
             | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_string: ID LPAREN param_list RPAREN LBRACE function_body_string RBRACE
               | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_bool: ID LPAREN param_list RPAREN LBRACE function_body_bool RBRACE
             | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_weave: ID LPAREN param_list RPAREN LBRACE function_body_weave RBRACE
              | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE
              | DOT ID ID LPAREN param_list RPAREN LBRACE function_body_weave RBRACE

param_list: param_type ID param_arr_opt param_cont
          |

param_type: INT
          | LONG
          | FLOAT
          | DOUBLE
          | CHAR
          | STRING
          | BOOL
          | ID

param_arr_opt: array_dims
             |

param_cont: COMMA param_type ID param_arr_opt param_cont
          |

// ============================================
// TYPE-SPECIFIC FUNCTION BODIES
// ============================================
// MANDATORY RETURN ENFORCEMENT:
// - func_content_* is a sequence of using/local/statements ending with mandatory_*_return
// - No lambda alternative ensures at least one return is required
// - Returns can also appear inside control structures (via statement_*_no_ret -> ctrl_struct_*)
// - Semantic analysis verifies all control paths return appropriately

// INT-returning function body
function_body_int: func_content_int

func_content_int: USING ID using_cont SEMICOLON func_content_int
                | LOCAL mutability local_dec_body func_content_int
                | statement_int_no_ret func_content_int
                | mandatory_int_return

mandatory_int_return: RETURN typed_numeric_ret_expr SEMICOLON

// LONG-returning function body
function_body_long: func_content_long

func_content_long: USING ID using_cont SEMICOLON func_content_long
                 | LOCAL mutability local_dec_body func_content_long
                 | statement_long_no_ret func_content_long
                 | mandatory_long_return

mandatory_long_return: RETURN typed_numeric_ret_expr SEMICOLON

// FLOAT-returning function body
function_body_float: func_content_float

func_content_float: USING ID using_cont SEMICOLON func_content_float
                  | LOCAL mutability local_dec_body func_content_float
                  | statement_float_no_ret func_content_float
                  | mandatory_float_return

mandatory_float_return: RETURN typed_numeric_ret_expr SEMICOLON

// DOUBLE-returning function body
function_body_double: func_content_double

func_content_double: USING ID using_cont SEMICOLON func_content_double
                   | LOCAL mutability local_dec_body func_content_double
                   | statement_double_no_ret func_content_double
                   | mandatory_double_return

mandatory_double_return: RETURN typed_numeric_ret_expr SEMICOLON

// CHAR-returning function body
function_body_char: func_content_char

func_content_char: USING ID using_cont SEMICOLON func_content_char
                 | LOCAL mutability local_dec_body func_content_char
                 | statement_char_no_ret func_content_char
                 | mandatory_char_return

mandatory_char_return: RETURN typed_string_ret_expr SEMICOLON

// STRING-returning function body
function_body_string: func_content_string

func_content_string: USING ID using_cont SEMICOLON func_content_string
                   | LOCAL mutability local_dec_body func_content_string
                   | statement_string_no_ret func_content_string
                   | mandatory_string_return

mandatory_string_return: RETURN typed_string_ret_expr SEMICOLON

// BOOL-returning function body
function_body_bool: func_content_bool

func_content_bool: USING ID using_cont SEMICOLON func_content_bool
                 | LOCAL mutability local_dec_body func_content_bool
                 | statement_bool_no_ret func_content_bool
                 | mandatory_bool_return

mandatory_bool_return: RETURN typed_bool_ret_expr SEMICOLON

// ARRAY-returning function body (any base type)
function_body_array: func_content_array

func_content_array: USING ID using_cont SEMICOLON func_content_array
                  | LOCAL mutability local_dec_body func_content_array
                  | statement_array_no_ret func_content_array
                  | mandatory_array_return

mandatory_array_return: RETURN ID SEMICOLON

// WEAVE-returning function body
function_body_weave: func_content_weave

func_content_weave: USING ID using_cont SEMICOLON func_content_weave
                  | LOCAL mutability local_dec_body func_content_weave
                  | statement_weave_no_ret func_content_weave
                  | mandatory_weave_return

mandatory_weave_return: RETURN ID SEMICOLON

// VOID function body
function_body_void: func_content_void

func_content_void: USING ID using_cont SEMICOLON func_content_void
                 | LOCAL mutability local_dec_body func_content_void
                 | statement_void_no_ret func_content_void
                 | mandatory_void_return

mandatory_void_return: RETURN SEMICOLON

// ============================================
// TYPE-SPECIFIC STATEMENTS
// ============================================
// Each return type has its own statement rule including type-appropriate return.
// Return is a first-class statement, allowed anywhere.

statement_int: effect_stmt SEMICOLON
             | io_stmt
             | ctrl_struct_int
             | RETURN typed_numeric_ret_expr SEMICOLON

statement_long: effect_stmt SEMICOLON
              | io_stmt
              | ctrl_struct_long
              | RETURN typed_numeric_ret_expr SEMICOLON

statement_float: effect_stmt SEMICOLON
               | io_stmt
               | ctrl_struct_float
               | RETURN typed_numeric_ret_expr SEMICOLON

statement_double: effect_stmt SEMICOLON
                | io_stmt
                | ctrl_struct_double
                | RETURN typed_numeric_ret_expr SEMICOLON

statement_char: effect_stmt SEMICOLON
              | io_stmt
              | ctrl_struct_char
              | RETURN typed_string_ret_expr SEMICOLON

statement_string: effect_stmt SEMICOLON
                | io_stmt
                | ctrl_struct_string
                | RETURN typed_string_ret_expr SEMICOLON

statement_bool: effect_stmt SEMICOLON
              | io_stmt
              | ctrl_struct_bool
              | RETURN typed_bool_ret_expr SEMICOLON

statement_array: effect_stmt SEMICOLON
               | io_stmt
               | ctrl_struct_array
               | RETURN ID SEMICOLON

statement_weave: effect_stmt SEMICOLON
               | io_stmt
               | ctrl_struct_weave
               | RETURN ID SEMICOLON

statement_void: effect_stmt SEMICOLON
              | io_stmt
              | ctrl_struct_void
              | RETURN SEMICOLON

// ============================================
// TYPE-SPECIFIC STATEMENTS (NO DIRECT RETURN)
// ============================================
// These rules exclude direct RETURN statements from function body prefix.
// Control structures (which may contain returns internally) are still allowed.
// Used by func_prefix_* to ensure return appears via terminator.

statement_int_no_ret: effect_stmt SEMICOLON
                    | io_stmt
                    | ctrl_struct_int

statement_long_no_ret: effect_stmt SEMICOLON
                     | io_stmt
                     | ctrl_struct_long

statement_float_no_ret: effect_stmt SEMICOLON
                      | io_stmt
                      | ctrl_struct_float

statement_double_no_ret: effect_stmt SEMICOLON
                       | io_stmt
                       | ctrl_struct_double

statement_char_no_ret: effect_stmt SEMICOLON
                     | io_stmt
                     | ctrl_struct_char

statement_string_no_ret: effect_stmt SEMICOLON
                       | io_stmt
                       | ctrl_struct_string

statement_bool_no_ret: effect_stmt SEMICOLON
                     | io_stmt
                     | ctrl_struct_bool

statement_array_no_ret: effect_stmt SEMICOLON
                      | io_stmt
                      | ctrl_struct_array

statement_weave_no_ret: effect_stmt SEMICOLON
                      | io_stmt
                      | ctrl_struct_weave

statement_void_no_ret: effect_stmt SEMICOLON
                     | io_stmt
                     | ctrl_struct_void

// ============================================
// TYPE-SPECIFIC CONTROL STRUCTURES
// ============================================
// Each return type has its own control structure rules.
// This allows return statements inside if/else/while/for/switch/do-while.
// BREAK RESTRICTION: break; only valid in loop/switch bodies (loop_stmt_list_*)

// INT control structures
ctrl_struct_int: IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_int RBRACE else_opt_int
               | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_int default_opt_int RBRACE
               | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE non_empty_loop_stmt_list_int RBRACE
               | WHILE LPAREN condition RPAREN LBRACE non_empty_loop_stmt_list_int RBRACE
               | DO LBRACE non_empty_loop_stmt_list_int RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_int: statement_int stmt_list_int
             |

// Non-empty statement list for control structure bodies
non_empty_stmt_list_int: statement_int stmt_list_int

loop_statement_int: statement_int
                  | BREAK SEMICOLON

loop_stmt_list_int: loop_statement_int loop_stmt_list_int
                  |

// Non-empty loop statement list for loop/switch bodies
non_empty_loop_stmt_list_int: loop_statement_int loop_stmt_list_int

else_opt_int: ELSE else_body_int
            |

else_body_int: LBRACE non_empty_stmt_list_int RBRACE
             | IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_int RBRACE else_opt_int

case_list_int: CASE case_val COLON non_empty_loop_stmt_list_int break_opt case_list_int
             |

default_opt_int: DEFAULT COLON non_empty_loop_stmt_list_int break_opt
               |

// LONG control structures
ctrl_struct_long: IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_long RBRACE else_opt_long
                | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_long default_opt_long RBRACE
                | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE non_empty_loop_stmt_list_long RBRACE
                | WHILE LPAREN condition RPAREN LBRACE non_empty_loop_stmt_list_long RBRACE
                | DO LBRACE non_empty_loop_stmt_list_long RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_long: statement_long stmt_list_long
              |

// Non-empty statement list for control structure bodies
non_empty_stmt_list_long: statement_long stmt_list_long

loop_statement_long: statement_long
                   | BREAK SEMICOLON

loop_stmt_list_long: loop_statement_long loop_stmt_list_long
                   |

// Non-empty loop statement list for loop/switch bodies
non_empty_loop_stmt_list_long: loop_statement_long loop_stmt_list_long

else_opt_long: ELSE else_body_long
             |

else_body_long: LBRACE non_empty_stmt_list_long RBRACE
              | IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_long RBRACE else_opt_long

case_list_long: CASE case_val COLON non_empty_loop_stmt_list_long break_opt case_list_long
              |

default_opt_long: DEFAULT COLON non_empty_loop_stmt_list_long break_opt
                |

// FLOAT control structures
ctrl_struct_float: IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_float RBRACE else_opt_float
                 | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_float default_opt_float RBRACE
                 | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE non_empty_loop_stmt_list_float RBRACE
                 | WHILE LPAREN condition RPAREN LBRACE non_empty_loop_stmt_list_float RBRACE
                 | DO LBRACE non_empty_loop_stmt_list_float RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_float: statement_float stmt_list_float
               |

// Non-empty statement list for control structure bodies
non_empty_stmt_list_float: statement_float stmt_list_float

loop_statement_float: statement_float
                    | BREAK SEMICOLON

loop_stmt_list_float: loop_statement_float loop_stmt_list_float
                    |

// Non-empty loop statement list for loop/switch bodies
non_empty_loop_stmt_list_float: loop_statement_float loop_stmt_list_float

else_opt_float: ELSE else_body_float
              |

else_body_float: LBRACE non_empty_stmt_list_float RBRACE
               | IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_float RBRACE else_opt_float

case_list_float: CASE case_val COLON non_empty_loop_stmt_list_float break_opt case_list_float
               |

default_opt_float: DEFAULT COLON non_empty_loop_stmt_list_float break_opt
                 |

// DOUBLE control structures
ctrl_struct_double: IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_double RBRACE else_opt_double
                  | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_double default_opt_double RBRACE
                  | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE non_empty_loop_stmt_list_double RBRACE
                  | WHILE LPAREN condition RPAREN LBRACE non_empty_loop_stmt_list_double RBRACE
                  | DO LBRACE non_empty_loop_stmt_list_double RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_double: statement_double stmt_list_double
                |

// Non-empty statement list for control structure bodies
non_empty_stmt_list_double: statement_double stmt_list_double

loop_statement_double: statement_double
                     | BREAK SEMICOLON

loop_stmt_list_double: loop_statement_double loop_stmt_list_double
                     |

// Non-empty loop statement list for loop/switch bodies
non_empty_loop_stmt_list_double: loop_statement_double loop_stmt_list_double

else_opt_double: ELSE else_body_double
               |

else_body_double: LBRACE non_empty_stmt_list_double RBRACE
                | IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_double RBRACE else_opt_double

case_list_double: CASE case_val COLON non_empty_loop_stmt_list_double break_opt case_list_double
                |

default_opt_double: DEFAULT COLON non_empty_loop_stmt_list_double break_opt
                  |

// CHAR control structures
ctrl_struct_char: IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_char RBRACE else_opt_char
                | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_char default_opt_char RBRACE
                | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE non_empty_loop_stmt_list_char RBRACE
                | WHILE LPAREN condition RPAREN LBRACE non_empty_loop_stmt_list_char RBRACE
                | DO LBRACE non_empty_loop_stmt_list_char RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_char: statement_char stmt_list_char
              |

// Non-empty statement list for control structure bodies
non_empty_stmt_list_char: statement_char stmt_list_char

loop_statement_char: statement_char
                   | BREAK SEMICOLON

loop_stmt_list_char: loop_statement_char loop_stmt_list_char
                   |

// Non-empty loop statement list for loop/switch bodies
non_empty_loop_stmt_list_char: loop_statement_char loop_stmt_list_char

else_opt_char: ELSE else_body_char
             |

else_body_char: LBRACE non_empty_stmt_list_char RBRACE
              | IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_char RBRACE else_opt_char

case_list_char: CASE case_val COLON non_empty_loop_stmt_list_char break_opt case_list_char
              |

default_opt_char: DEFAULT COLON non_empty_loop_stmt_list_char break_opt
                |

// STRING control structures
ctrl_struct_string: IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_string RBRACE else_opt_string
                  | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_string default_opt_string RBRACE
                  | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE non_empty_loop_stmt_list_string RBRACE
                  | WHILE LPAREN condition RPAREN LBRACE non_empty_loop_stmt_list_string RBRACE
                  | DO LBRACE non_empty_loop_stmt_list_string RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_string: statement_string stmt_list_string
                |

// Non-empty statement list for control structure bodies
non_empty_stmt_list_string: statement_string stmt_list_string

loop_statement_string: statement_string
                     | BREAK SEMICOLON

loop_stmt_list_string: loop_statement_string loop_stmt_list_string
                     |

// Non-empty loop statement list for loop/switch bodies
non_empty_loop_stmt_list_string: loop_statement_string loop_stmt_list_string

else_opt_string: ELSE else_body_string
               |

else_body_string: LBRACE non_empty_stmt_list_string RBRACE
                | IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_string RBRACE else_opt_string

case_list_string: CASE case_val COLON non_empty_loop_stmt_list_string break_opt case_list_string
                |

default_opt_string: DEFAULT COLON non_empty_loop_stmt_list_string break_opt
                  |

// BOOL control structures
ctrl_struct_bool: IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_bool RBRACE else_opt_bool
                | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_bool default_opt_bool RBRACE
                | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE non_empty_loop_stmt_list_bool RBRACE
                | WHILE LPAREN condition RPAREN LBRACE non_empty_loop_stmt_list_bool RBRACE
                | DO LBRACE non_empty_loop_stmt_list_bool RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_bool: statement_bool stmt_list_bool
              |

// Non-empty statement list for control structure bodies
non_empty_stmt_list_bool: statement_bool stmt_list_bool

loop_statement_bool: statement_bool
                   | BREAK SEMICOLON

loop_stmt_list_bool: loop_statement_bool loop_stmt_list_bool
                   |

// Non-empty loop statement list for loop/switch bodies
non_empty_loop_stmt_list_bool: loop_statement_bool loop_stmt_list_bool

else_opt_bool: ELSE else_body_bool
             |

else_body_bool: LBRACE non_empty_stmt_list_bool RBRACE
              | IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_bool RBRACE else_opt_bool

case_list_bool: CASE case_val COLON non_empty_loop_stmt_list_bool break_opt case_list_bool
              |

default_opt_bool: DEFAULT COLON non_empty_loop_stmt_list_bool break_opt
                |

// ARRAY control structures
ctrl_struct_array: IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_array RBRACE else_opt_array
                 | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_array default_opt_array RBRACE
                 | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE non_empty_loop_stmt_list_array RBRACE
                 | WHILE LPAREN condition RPAREN LBRACE non_empty_loop_stmt_list_array RBRACE
                 | DO LBRACE non_empty_loop_stmt_list_array RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_array: statement_array stmt_list_array
               |

// Non-empty statement list for control structure bodies
non_empty_stmt_list_array: statement_array stmt_list_array

loop_statement_array: statement_array
                    | BREAK SEMICOLON

loop_stmt_list_array: loop_statement_array loop_stmt_list_array
                    |

// Non-empty loop statement list for loop/switch bodies
non_empty_loop_stmt_list_array: loop_statement_array loop_stmt_list_array

else_opt_array: ELSE else_body_array
              |

else_body_array: LBRACE non_empty_stmt_list_array RBRACE
               | IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_array RBRACE else_opt_array

case_list_array: CASE case_val COLON non_empty_loop_stmt_list_array break_opt case_list_array
               |

default_opt_array: DEFAULT COLON non_empty_loop_stmt_list_array break_opt
                 |

// WEAVE control structures
ctrl_struct_weave: IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_weave RBRACE else_opt_weave
                 | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_weave default_opt_weave RBRACE
                 | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE non_empty_loop_stmt_list_weave RBRACE
                 | WHILE LPAREN condition RPAREN LBRACE non_empty_loop_stmt_list_weave RBRACE
                 | DO LBRACE non_empty_loop_stmt_list_weave RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_weave: statement_weave stmt_list_weave
               |

// Non-empty statement list for control structure bodies
non_empty_stmt_list_weave: statement_weave stmt_list_weave

loop_statement_weave: statement_weave
                    | BREAK SEMICOLON

loop_stmt_list_weave: loop_statement_weave loop_stmt_list_weave
                    |

// Non-empty loop statement list for loop/switch bodies
non_empty_loop_stmt_list_weave: loop_statement_weave loop_stmt_list_weave

else_opt_weave: ELSE else_body_weave
              |

else_body_weave: LBRACE non_empty_stmt_list_weave RBRACE
               | IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_weave RBRACE else_opt_weave

case_list_weave: CASE case_val COLON non_empty_loop_stmt_list_weave break_opt case_list_weave
               |

default_opt_weave: DEFAULT COLON non_empty_loop_stmt_list_weave break_opt
                 |

// VOID control structures
ctrl_struct_void: IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_void RBRACE else_opt_void
                | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_void default_opt_void RBRACE
                | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE non_empty_loop_stmt_list_void RBRACE
                | WHILE LPAREN condition RPAREN LBRACE non_empty_loop_stmt_list_void RBRACE
                | DO LBRACE non_empty_loop_stmt_list_void RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_void: statement_void stmt_list_void
              |

// Non-empty statement list for control structure bodies
non_empty_stmt_list_void: statement_void stmt_list_void

loop_statement_void: statement_void
                   | BREAK SEMICOLON

loop_stmt_list_void: loop_statement_void loop_stmt_list_void
                   |

// Non-empty loop statement list for loop/switch bodies
non_empty_loop_stmt_list_void: loop_statement_void loop_stmt_list_void

else_opt_void: ELSE else_body_void
             |

else_body_void: LBRACE non_empty_stmt_list_void RBRACE
              | IF LPAREN condition RPAREN LBRACE non_empty_stmt_list_void RBRACE else_opt_void

case_list_void: CASE case_val COLON non_empty_loop_stmt_list_void break_opt case_list_void
              |

default_opt_void: DEFAULT COLON non_empty_loop_stmt_list_void break_opt
                |

// ============================================
// TYPED RETURN EXPRESSIONS
// ============================================
// Strict return type enforcement using typed expression discipline
// NO assignment allowed in return expressions
// Each return type routes to type-appropriate expression rules

// NUMERIC RETURN (for int, long, float, double functions)
// Uses typed arithmetic expressions - rejects string/bool literals at top level
typed_numeric_ret_expr: typed_numeric_add_expr

// STRING RETURN (for char, string functions)
// String/char literals with concat, IDs with postfix, parens
typed_string_ret_expr: typed_string_ret_primary typed_string_cont

typed_string_ret_primary: STRINGLIT
                        | CHARLIT
                        | ID typed_postfix_chain
                        | STRING LPAREN expression RPAREN
                        | CHAR LPAREN expression RPAREN
                        | LPAREN expression RPAREN typed_postfix_chain

// BOOL RETURN (for bool functions)
// Boolean expressions with && || == != and comparisons
// Numeric literals MUST have comparison operator to become boolean
// BOOL cast supported for return expressions
typed_bool_ret_expr: typed_bool_ret_primary typed_bool_ret_tail

typed_bool_ret_primary: TRUE
                      | FALSE
                      | NOT typed_bool_factor
                      | ID typed_bool_id_cont
                      | LPAREN typed_bool_paren RPAREN
                      | BOOL LPAREN expression RPAREN
                      | INTLIT typed_numeric_cmp_required
                      | LONGLIT typed_numeric_cmp_required
                      | FLOATLIT typed_numeric_cmp_required
                      | DOUBLELIT typed_numeric_cmp_required
                      | MINUS typed_numeric_neg_cmp
                      | INT LPAREN expression RPAREN typed_numeric_cmp_required
                      | LONG LPAREN expression RPAREN typed_numeric_cmp_required
                      | FLOAT LPAREN expression RPAREN typed_numeric_cmp_required
                      | DOUBLE LPAREN expression RPAREN typed_numeric_cmp_required

typed_bool_ret_tail: AND typed_bool_term typed_bool_and_tail typed_bool_or_tail_opt
                   | OR typed_bool_term typed_bool_or_tail
                   | EQ typed_bool_factor typed_bool_eq_tail typed_bool_ret_tail
                   | NEQ typed_bool_factor typed_bool_eq_tail typed_bool_ret_tail
                   |

// ============================================
// USING BLOCK
// ============================================

using_cont: COMMA ID using_cont
          |

// ============================================
// LOCAL DECLARATIONS
// ============================================
// Type-specific local declaration tails - no expressions allowed
// Each type accepts ONLY its matching literal type

local_dec_body: INT ID int_local_tail
              | LONG ID long_local_tail
              | FLOAT ID float_local_tail
              | DOUBLE ID double_local_tail
              | CHAR ID char_local_tail
              | STRING ID string_local_tail
              | BOOL ID bool_local_tail
              | ID ID weave_local_tail

// INT local declarations
int_local_tail: int_array_with_init SEMICOLON
              | ASSIGN INTLIT int_local_cont SEMICOLON

int_local_cont: COMMA ID ASSIGN INTLIT int_local_cont
              |

// LONG local declarations
long_local_tail: long_array_with_init SEMICOLON
               | ASSIGN LONGLIT long_local_cont SEMICOLON

long_local_cont: COMMA ID ASSIGN LONGLIT long_local_cont
               |

// FLOAT local declarations
float_local_tail: float_array_with_init SEMICOLON
                | ASSIGN FLOATLIT float_local_cont SEMICOLON

float_local_cont: COMMA ID ASSIGN FLOATLIT float_local_cont
                |

// DOUBLE local declarations
double_local_tail: double_array_with_init SEMICOLON
                 | ASSIGN DOUBLELIT double_local_cont SEMICOLON

double_local_cont: COMMA ID ASSIGN DOUBLELIT double_local_cont
                 |

// CHAR local declarations
char_local_tail: char_array_with_init SEMICOLON
               | ASSIGN CHARLIT char_local_cont SEMICOLON

char_local_cont: COMMA ID ASSIGN CHARLIT char_local_cont
               |

// STRING local declarations
string_local_tail: string_array_with_init SEMICOLON
                 | ASSIGN STRINGLIT string_local_cont SEMICOLON

string_local_cont: COMMA ID ASSIGN STRINGLIT string_local_cont
                 |

// BOOL local declarations
bool_local_tail: bool_array_with_init SEMICOLON
               | ASSIGN bool_lit bool_local_cont SEMICOLON

bool_local_cont: COMMA ID ASSIGN bool_lit bool_local_cont
               |

// Weave (struct) local declarations - literal field values only
weave_local_tail: ASSIGN LBRACE weave_field_value weave_field_list_tail RBRACE weave_inst_cont SEMICOLON
                | weave_array_with_init weave_arr_cont SEMICOLON

// ============================================
// STATEMENTS (for main function only)
// ============================================
// statement_non_return is used ONLY in main function and its control structures
// All other functions use type-specific statement rules (statement_int, etc.)
// BREAK RESTRICTION: break; only valid in loop/switch bodies

statement_non_return: effect_stmt SEMICOLON
                    | io_stmt
                    | ctrl_struct

// ============================================
// UNIFIED EXPRESSION GRAMMAR (BATCH 4 - TYPED DISPATCH)
// ============================================
// Typed Expression Discipline:
// - Assignment does NOT chain (a = b = c is syntax error)
// - Boolean operators (&&, ||) require boolean operands
// - Concat (..) requires string-like operands
// - Relational (<, >, <=, >=) require numeric operands
// - Arithmetic (+, -, *, /, %) require numeric operands
// 
// Structure:
// - expression → typed_assign_expr
// - typed_assign_expr → typed_concat_expr typed_assign_tail
// - typed_assign_tail → = typed_rhs_expr | compound_op typed_numeric_add_expr | λ
// - typed_concat_expr: left-factored dispatch for full precedence
// - typed_rhs_expr: strict dispatcher for assignment RHS

expression: typed_assign_expr

typed_assign_expr: typed_concat_expr typed_assign_tail

// typed_assign_tail: = allows any RHS, compound ops restricted to numeric
typed_assign_tail: ASSIGN typed_rhs_expr
                 | PLUSEQ typed_numeric_add_expr
                 | MINUSEQ typed_numeric_add_expr
                 | STAREQ typed_numeric_add_expr
                 | SLASHEQ typed_numeric_add_expr
                 | MODEQ typed_numeric_add_expr
                 |

assign_op: ASSIGN
         | PLUSEQ
         | MINUSEQ
         | STAREQ
         | SLASHEQ
         | MODEQ

// ============================================
// TYPED_RHS_EXPR - Strict Dispatcher
// ============================================
// Entry point for assignment RHS - dispatches to typed_concat_expr
// Separate rule to clearly mark non-recursive assignment semantics

typed_rhs_expr: typed_concat_expr

// ============================================
// TYPED_CONCAT_EXPR - Left-factored Precedence Chain
// ============================================
// Routes based on starting token to enforce type discipline
// Dispatches to: typed_numeric | typed_string | typed_bool | id | paren

typed_concat_expr: STRINGLIT typed_string_cont
                 | CHARLIT typed_string_cont
                 | INTLIT typed_numeric_cont
                 | LONGLIT typed_numeric_cont
                 | FLOATLIT typed_numeric_cont
                 | DOUBLELIT typed_numeric_cont
                 | TRUE typed_bool_cont
                 | FALSE typed_bool_cont
                 | NOT typed_bool_factor typed_bool_tail_opt
                 | MINUS typed_neg_numeric_cont
                 | ID typed_id_cont
                 | LPAREN typed_paren_cont
                 | INT LPAREN expression RPAREN typed_numeric_cont
                 | LONG LPAREN expression RPAREN typed_numeric_cont
                 | FLOAT LPAREN expression RPAREN typed_numeric_cont
                 | DOUBLE LPAREN expression RPAREN typed_numeric_cont
                 | CHAR LPAREN expression RPAREN typed_string_cont
                 | STRING LPAREN expression RPAREN typed_string_cont
                 | BOOL LPAREN expression RPAREN typed_bool_cont
                 | INCR ID
                 | DECR ID

// ============================================
// STRING/CHAR CONTINUATION (concat only)
// ============================================

typed_string_cont: CONCAT typed_string_operand typed_string_cont
                 |

typed_string_operand: STRINGLIT
                    | CHARLIT
                    | ID
                    | STRING LPAREN expression RPAREN
                    | CHAR LPAREN expression RPAREN
                    | LPAREN typed_string_operand typed_string_cont RPAREN
                    | INTLIT
                    | LONGLIT
                    | FLOATLIT
                    | DOUBLELIT
                    | TRUE
                    | FALSE
                    | INT LPAREN expression RPAREN
                    | LONG LPAREN expression RPAREN
                    | FLOAT LPAREN expression RPAREN
                    | DOUBLE LPAREN expression RPAREN
                    | BOOL LPAREN expression RPAREN

// ============================================
// NUMERIC CONTINUATION (arithmetic + optional cmp/bool)
// ============================================

typed_numeric_cont: typed_arith_ops typed_after_arith
                  | typed_cmp_op typed_numeric_add_expr typed_bool_tail_opt
                  | typed_bool_tail_opt

// Arithmetic operators (first operand already parsed)
typed_arith_ops: PLUS typed_numeric_mul_expr typed_numeric_add_ops
               | MINUS typed_numeric_mul_expr typed_numeric_add_ops
               | STAR typed_numeric_unary_expr typed_numeric_mul_tail typed_numeric_add_ops
               | SLASH typed_numeric_unary_expr typed_numeric_mul_tail typed_numeric_add_ops
               | MOD typed_numeric_unary_expr typed_numeric_mul_tail typed_numeric_add_ops

typed_numeric_add_ops: PLUS typed_numeric_mul_expr typed_numeric_add_ops
                     | MINUS typed_numeric_mul_expr typed_numeric_add_ops
                     |

// After arithmetic: optional comparison, then optional boolean
typed_after_arith: typed_cmp_op typed_numeric_add_expr typed_bool_tail_opt
                 | typed_bool_tail_opt

// Negated numeric continuation
typed_neg_numeric_cont: typed_numeric_unary_expr typed_numeric_mul_tail typed_numeric_add_ops typed_after_arith

// ============================================
// BOOLEAN CONTINUATION (&&, ||, ==, != only)
// ============================================

typed_bool_cont: typed_bool_tail_opt

// Boolean tail (AND/OR) - optional  
typed_bool_tail_opt: AND typed_bool_term typed_bool_and_tail typed_bool_or_tail_opt
                   | OR typed_bool_term typed_bool_or_tail
                   |

typed_bool_or_tail_opt: OR typed_bool_term typed_bool_or_tail
                      |

// Boolean term for operand of &&/||
typed_bool_term: typed_bool_eq typed_bool_and_tail

typed_bool_and_tail: AND typed_bool_eq typed_bool_and_tail
                   |

typed_bool_or_tail: OR typed_bool_term typed_bool_or_tail
                  |

// Equality level for boolean expressions
typed_bool_eq: typed_bool_factor typed_bool_eq_tail

typed_bool_eq_tail: EQ typed_bool_factor typed_bool_eq_tail
                  | NEQ typed_bool_factor typed_bool_eq_tail
                  |

// Boolean factor - NOT or atom
typed_bool_factor: NOT typed_bool_factor
                 | typed_bool_atom

// Boolean atom - must produce boolean value
// Numeric literals MUST have comparison to become boolean
typed_bool_atom: TRUE
               | FALSE
               | ID typed_bool_id_cont
               | INTLIT typed_numeric_cmp_required
               | LONGLIT typed_numeric_cmp_required
               | FLOATLIT typed_numeric_cmp_required
               | DOUBLELIT typed_numeric_cmp_required
               | MINUS typed_numeric_neg_cmp
               | LPAREN typed_bool_paren RPAREN
               | INT LPAREN expression RPAREN typed_numeric_cmp_required
               | LONG LPAREN expression RPAREN typed_numeric_cmp_required
               | FLOAT LPAREN expression RPAREN typed_numeric_cmp_required
               | DOUBLE LPAREN expression RPAREN typed_numeric_cmp_required

// Parenthesized content in boolean atom context
typed_bool_paren: typed_bool_term typed_bool_and_or_tail

typed_bool_and_or_tail: AND typed_bool_term typed_bool_and_or_tail
                      | OR typed_bool_term typed_bool_and_or_tail
                      |

// After ID in boolean atom context
typed_bool_id_cont: typed_numeric_arith_cmp
                  | INCR
                  | DECR
                  | typed_postfix_chain

// Numeric arithmetic followed by mandatory comparison (boolean context)
typed_numeric_arith_cmp: PLUS typed_numeric_mul_expr typed_numeric_add_cmp typed_cmp_op typed_numeric_add_expr
                       | MINUS typed_numeric_mul_expr typed_numeric_add_cmp typed_cmp_op typed_numeric_add_expr
                       | STAR typed_numeric_unary_expr typed_numeric_mul_tail typed_numeric_add_cmp typed_cmp_op typed_numeric_add_expr
                       | SLASH typed_numeric_unary_expr typed_numeric_mul_tail typed_numeric_add_cmp typed_cmp_op typed_numeric_add_expr
                       | MOD typed_numeric_unary_expr typed_numeric_mul_tail typed_numeric_add_cmp typed_cmp_op typed_numeric_add_expr
                       | typed_cmp_op typed_numeric_add_expr

typed_numeric_add_cmp: PLUS typed_numeric_mul_expr typed_numeric_add_cmp
                     | MINUS typed_numeric_mul_expr typed_numeric_add_cmp
                     |

// Numeric literal requires comparison to become boolean
typed_numeric_cmp_required: typed_numeric_lit_arith typed_cmp_op typed_numeric_add_expr

typed_numeric_lit_arith: STAR typed_numeric_unary_expr typed_numeric_mul_tail typed_numeric_add_cmp
                       | SLASH typed_numeric_unary_expr typed_numeric_mul_tail typed_numeric_add_cmp
                       | MOD typed_numeric_unary_expr typed_numeric_mul_tail typed_numeric_add_cmp
                       | PLUS typed_numeric_mul_expr typed_numeric_add_cmp
                       | MINUS typed_numeric_mul_expr typed_numeric_add_cmp
                       |

// Negated numeric requires comparison (boolean context)
typed_numeric_neg_cmp: typed_numeric_unary_expr typed_numeric_mul_tail typed_numeric_add_cmp typed_cmp_op typed_numeric_add_expr

// ============================================
// ID CONTINUATION (type unknown - allow all)
// ============================================
// Left-factored to avoid reduce/reduce conflicts
// Postfix operations are inlined to eliminate epsilon chains

typed_id_cont: typed_arith_ops typed_after_arith
             | typed_cmp_op typed_numeric_add_expr typed_bool_tail_opt
             | INCR
             | DECR
             | LBRACK array_index RBRACK typed_id_arr_cont
             | DOT ID typed_id_field_cont
             | LPAREN arg_list RPAREN typed_id_call_cont
             | CONCAT typed_string_operand typed_string_cont
             | typed_bool_tail_opt

// After array access on ID
typed_id_arr_cont: LBRACK array_index RBRACK typed_id_arr2_cont
                 | typed_id_postfix_cont

typed_id_arr2_cont: typed_id_postfix_cont

typed_id_postfix_cont: DOT ID typed_id_field_cont
                     | LPAREN arg_list RPAREN typed_id_call_cont
                     | typed_arith_ops typed_after_arith
                     | typed_cmp_op typed_numeric_add_expr typed_bool_tail_opt
                     | CONCAT typed_string_operand typed_string_cont
                     | typed_bool_tail_opt

// After field access on ID
typed_id_field_cont: LBRACK array_index RBRACK typed_id_arr_cont
                   | DOT ID typed_id_field_cont
                   | LPAREN arg_list RPAREN typed_id_call_cont
                   | typed_arith_ops typed_after_arith
                   | typed_cmp_op typed_numeric_add_expr typed_bool_tail_opt
                   | CONCAT typed_string_operand typed_string_cont
                   | typed_bool_tail_opt

// After function call on ID
typed_id_call_cont: LBRACK array_index RBRACK typed_id_arr_cont
                  | DOT ID typed_id_field_cont
                  | LPAREN arg_list RPAREN typed_id_call_cont
                  | typed_arith_ops typed_after_arith
                  | typed_cmp_op typed_numeric_add_expr typed_bool_tail_opt
                  | CONCAT typed_string_operand typed_string_cont
                  | typed_bool_tail_opt

// ============================================
// PARENTHESIZED CONTINUATION
// ============================================

typed_paren_cont: typed_concat_expr RPAREN typed_paren_after

// After (expr): inline postfix to avoid epsilon chain conflicts
typed_paren_after: typed_arith_ops typed_after_arith
                 | typed_cmp_op typed_numeric_add_expr typed_bool_tail_opt
                 | CONCAT typed_string_operand typed_string_cont
                 | LBRACK array_index RBRACK typed_paren_arr_cont
                 | DOT ID typed_paren_field_cont
                 | LPAREN arg_list RPAREN typed_paren_call_cont
                 | typed_bool_tail_opt

typed_paren_arr_cont: LBRACK array_index RBRACK typed_paren_arr2_cont
                    | typed_paren_postfix_cont

typed_paren_arr2_cont: typed_paren_postfix_cont

typed_paren_postfix_cont: DOT ID typed_paren_field_cont
                        | LPAREN arg_list RPAREN typed_paren_call_cont
                        | typed_arith_ops typed_after_arith
                        | typed_cmp_op typed_numeric_add_expr typed_bool_tail_opt
                        |

typed_paren_field_cont: LBRACK array_index RBRACK typed_paren_arr_cont
                      | DOT ID typed_paren_field_cont
                      | LPAREN arg_list RPAREN typed_paren_call_cont
                      | typed_arith_ops typed_after_arith
                      | typed_cmp_op typed_numeric_add_expr typed_bool_tail_opt
                      |

typed_paren_call_cont: LBRACK array_index RBRACK typed_paren_arr_cont
                     | DOT ID typed_paren_field_cont
                     | LPAREN arg_list RPAREN typed_paren_call_cont
                     | typed_arith_ops typed_after_arith
                     | typed_cmp_op typed_numeric_add_expr typed_bool_tail_opt
                     |

// ============================================
// NUMERIC EXPRESSION RULES
// ============================================

typed_numeric_add_expr: typed_numeric_mul_expr typed_numeric_add_tail

typed_numeric_add_tail: PLUS typed_numeric_mul_expr typed_numeric_add_tail
                      | MINUS typed_numeric_mul_expr typed_numeric_add_tail
                      |

typed_numeric_mul_expr: typed_numeric_unary_expr typed_numeric_mul_tail

typed_numeric_mul_tail: STAR typed_numeric_unary_expr typed_numeric_mul_tail
                      | SLASH typed_numeric_unary_expr typed_numeric_mul_tail
                      | MOD typed_numeric_unary_expr typed_numeric_mul_tail
                      |

typed_numeric_unary_expr: NOT typed_numeric_unary_expr
                        | MINUS typed_numeric_unary_expr
                        | typed_numeric_postfix_expr

// Numeric-only postfix - excludes CHARLIT, STRINGLIT, TRUE, FALSE
typed_numeric_postfix_expr: INTLIT
                          | LONGLIT
                          | FLOATLIT
                          | DOUBLELIT
                          | ID typed_postfix_chain
                          | LPAREN expression RPAREN typed_postfix_chain
                          | INT LPAREN expression RPAREN
                          | LONG LPAREN expression RPAREN
                          | FLOAT LPAREN expression RPAREN
                          | DOUBLE LPAREN expression RPAREN
                          | INCR ID
                          | DECR ID

// ============================================
// COMPARISON OPERATORS
// ============================================

typed_cmp_op: LT
            | GT
            | LTE
            | GTE
            | EQ
            | NEQ

// ============================================
// POSTFIX CHAIN
// ============================================

typed_postfix_chain: LBRACK array_index RBRACK typed_postfix_after_arr
                   | DOT ID typed_postfix_chain
                   | LPAREN arg_list RPAREN typed_postfix_chain
                   |

typed_postfix_after_arr: LBRACK array_index RBRACK
                       | DOT ID typed_postfix_chain
                       | LPAREN arg_list RPAREN typed_postfix_chain
                       |

// ============================================
// SHARED EXPRESSION PRIMITIVES
// ============================================
// array_index, arg_list, arg_tail used by typed_postfix_chain and other live rules

array_index: INTLIT
           | ID

arg_list: arg_expr arg_tail
        |

arg_tail: COMMA arg_expr arg_tail
        |

// ============================================
// EFFECTFUL STATEMENT (SIDE-EFFECT REQUIREMENT)
// ============================================
// effect_stmt replaces stmt_expr in statement position
// Only allows constructs with side effects: assignment, ++/--, function calls
// Rejects: bare id;  arr[i];  obj.field;  literals;  pure expressions
// This is enforced purely in CFG - no semantic filtering

effect_stmt: INCR ID effect_pre_chain          // ++lvalue
           | DECR ID effect_pre_chain          // --lvalue
           | ID effect_id_cont                 // id must lead to effect

// After ++ID or --ID: optional lvalue extension (already effectful)
effect_pre_chain: LBRACK stmt_array_index RBRACK effect_pre_arr_chain
                | DOT ID effect_pre_chain
                |

effect_pre_arr_chain: LBRACK stmt_array_index RBRACK
                    | DOT ID effect_pre_chain
                    |

// After ID: MUST have effectful operation (no epsilon!)
// Compound assignment (+=, -=, *=, /=, %=) restricted to numeric RHS
effect_id_cont: ASSIGN stmt_assign_expr                          // id = expr (any RHS)
              | PLUSEQ numeric_add_expr_stmt                     // id += numeric
              | MINUSEQ numeric_add_expr_stmt                    // id -= numeric
              | STAREQ numeric_add_expr_stmt                     // id *= numeric
              | SLASHEQ numeric_add_expr_stmt                    // id /= numeric
              | MODEQ numeric_add_expr_stmt                      // id %= numeric
              | INCR                                             // id++ (post-increment)
              | DECR                                             // id-- (post-decrement)
              | LPAREN stmt_arg_list RPAREN effect_post_call    // id() (function call)
              | LBRACK stmt_array_index RBRACK effect_post_arr  // id[i]... (array, must lead to effect)
              | DOT ID effect_post_member                        // id.f... (field, must lead to effect)

// After function call: already effectful, allow any postfix chain
effect_post_call: DOT ID effect_post_call_member
                | LBRACK stmt_array_index RBRACK effect_post_call_arr
                |

effect_post_call_member: LPAREN stmt_arg_list RPAREN effect_post_call
                       | LBRACK stmt_array_index RBRACK effect_post_call_arr
                       | DOT ID effect_post_call_member
                       |

effect_post_call_arr: LBRACK stmt_array_index RBRACK effect_post_call_arr_cont
                    | effect_post_call_arr_cont

effect_post_call_arr_cont: DOT ID effect_post_call_member
                         | LPAREN stmt_arg_list RPAREN effect_post_call
                         |

// After array access on id: MUST lead to effect
effect_post_arr: LBRACK stmt_array_index RBRACK effect_post_arr_2d  // 2D array
               | effect_arr_effect                                   // 1D array, need effect

effect_post_arr_2d: effect_arr_effect                               // after 2D, need effect

// Compound assignment (+=, -=, *=, /=, %=) restricted to numeric RHS
effect_arr_effect: ASSIGN stmt_assign_expr
                 | PLUSEQ numeric_add_expr_stmt
                 | MINUSEQ numeric_add_expr_stmt
                 | STAREQ numeric_add_expr_stmt
                 | SLASHEQ numeric_add_expr_stmt
                 | MODEQ numeric_add_expr_stmt
                 | INCR
                 | DECR
                 | LPAREN stmt_arg_list RPAREN effect_post_call
                 | DOT ID effect_post_member

// After field access on id: MUST lead to effect
// Compound assignment (+=, -=, *=, /=, %=) restricted to numeric RHS
effect_post_member: ASSIGN stmt_assign_expr
                  | PLUSEQ numeric_add_expr_stmt
                  | MINUSEQ numeric_add_expr_stmt
                  | STAREQ numeric_add_expr_stmt
                  | SLASHEQ numeric_add_expr_stmt
                  | MODEQ numeric_add_expr_stmt
                  | INCR
                  | DECR
                  | LPAREN stmt_arg_list RPAREN effect_post_call
                  | LBRACK stmt_array_index RBRACK effect_post_arr
                  | DOT ID effect_post_member

// ============================================
// STATEMENT EXPRESSION RULES (ISOLATED FOLLOW SET)
// ============================================
// BATCH 3 - Typed Expression Discipline
// - Assignment does NOT chain (a = b = c is invalid)
// - Boolean operators (&&, ||, !) require boolean operands
// - Concat (..) requires string-like operands (STRINGLIT, CHARLIT, ID, casts)
// - Relational (<, >, <=, >=) require numeric operands (already enforced)
// - Arithmetic (+, -, *, /, %) require numeric operands (already enforced)
// FOLLOW set isolated to {;} for statement contexts

// Top-level: assignment with NO CHAINING
// effect_id_cont already provides the assign_op, so RHS is just the expression
stmt_assign_expr: stmt_typed_rhs

// Typed RHS - entry point after assignment operator
// Routes to concat for string-like, or bool for everything else
stmt_typed_rhs: stmt_bool_or_concat

// Top-level typed: either concat chain, numeric expression, or boolean expression
// Left-factored for LALR
stmt_bool_or_concat: STRINGLIT stmt_concat_tail_typed
                   | CHARLIT stmt_concat_tail_typed
                   | STRING LPAREN arg_expr RPAREN stmt_concat_tail_typed
                   | INTLIT stmt_numeric_or_bool
                   | LONGLIT stmt_numeric_or_bool
                   | FLOATLIT stmt_numeric_or_bool
                   | DOUBLELIT stmt_numeric_or_bool
                   | MINUS stmt_neg_numeric_or_bool
                   | TRUE stmt_bool_tail_opt
                   | FALSE stmt_bool_tail_opt
                   | NOT stmt_bool_factor stmt_bool_tail_opt
                   | INT LPAREN arg_expr RPAREN stmt_numeric_or_bool
                   | LONG LPAREN arg_expr RPAREN stmt_numeric_or_bool
                   | FLOAT LPAREN arg_expr RPAREN stmt_numeric_or_bool
                   | DOUBLE LPAREN arg_expr RPAREN stmt_numeric_or_bool
                   | CHAR LPAREN arg_expr RPAREN
                   | BOOL LPAREN arg_expr RPAREN stmt_bool_tail_opt
                   | ID stmt_id_toplevel_cont
                   | LPAREN stmt_paren_typed_content
                   | INCR ID
                   | DECR ID

// After numeric literal at top level: can be arithmetic, relational, or boolean ops
stmt_numeric_or_bool: stmt_arith_ops stmt_after_arith
                    | stmt_cmp_op numeric_add_expr_stmt stmt_bool_tail_opt
                    | stmt_bool_tail_opt

// Arithmetic operators
stmt_arith_ops: PLUS numeric_mul_expr_stmt stmt_numeric_add_ops
              | MINUS numeric_mul_expr_stmt stmt_numeric_add_ops
              | STAR numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_ops
              | SLASH numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_ops
              | MOD numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_ops

stmt_numeric_add_ops: PLUS numeric_mul_expr_stmt stmt_numeric_add_ops
                    | MINUS numeric_mul_expr_stmt stmt_numeric_add_ops
                    |

// After arithmetic: may have comparison, then optionally boolean ops
stmt_after_arith: stmt_cmp_op numeric_add_expr_stmt stmt_bool_tail_opt
                | stmt_bool_tail_opt

// Negated numeric: arithmetic then optional comparison and boolean
stmt_neg_numeric_or_bool: numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_ops stmt_after_arith

// Boolean tail (AND/OR) - optional
stmt_bool_tail_opt: AND stmt_bool_term stmt_bool_and_tail stmt_bool_or_tail_opt
                  | OR stmt_bool_term stmt_bool_or_tail
                  |

stmt_bool_or_tail_opt: OR stmt_bool_term stmt_bool_or_tail
                     |

// After ID at top level
stmt_id_toplevel_cont: stmt_arith_ops stmt_after_arith
                     | stmt_cmp_op numeric_add_expr_stmt stmt_bool_tail_opt
                     | INCR
                     | DECR
                     | stmt_postfix_chain stmt_id_after_postfix

stmt_id_after_postfix: stmt_arith_ops stmt_after_arith
                     | stmt_cmp_op numeric_add_expr_stmt stmt_bool_tail_opt
                     | CONCAT stmt_string_operand stmt_concat_tail_typed
                     | stmt_bool_tail_opt

// ============================================
// TYPE-TRACKING PARENTHESIZED EXPRESSIONS
// ============================================
// Tracks what type the paren content produces, routes to appropriate continuations
// - Numeric content → allows arithmetic, comparison, boolean after )
// - Boolean content (has comparison or starts with true/false) → only allows && || after )
// - String content → only allows concat after )
// - ID/nested paren → permissive (semantic analysis catches type errors)

stmt_paren_typed_content: STRINGLIT stmt_concat_tail_typed RPAREN stmt_paren_string_cont
                        | CHARLIT stmt_concat_tail_typed RPAREN stmt_paren_string_cont
                        | STRING LPAREN arg_expr RPAREN stmt_concat_tail_typed RPAREN stmt_paren_string_cont
                        | CHAR LPAREN arg_expr RPAREN RPAREN stmt_paren_string_cont
                        | INTLIT stmt_paren_num_start
                        | LONGLIT stmt_paren_num_start
                        | FLOATLIT stmt_paren_num_start
                        | DOUBLELIT stmt_paren_num_start
                        | MINUS stmt_paren_neg_num
                        | INT LPAREN arg_expr RPAREN stmt_paren_num_start
                        | LONG LPAREN arg_expr RPAREN stmt_paren_num_start
                        | FLOAT LPAREN arg_expr RPAREN stmt_paren_num_start
                        | DOUBLE LPAREN arg_expr RPAREN stmt_paren_num_start
                        | TRUE stmt_paren_bool_tail RPAREN stmt_paren_bool_cont
                        | FALSE stmt_paren_bool_tail RPAREN stmt_paren_bool_cont
                        | NOT stmt_bool_factor stmt_paren_bool_tail RPAREN stmt_paren_bool_cont
                        | BOOL LPAREN arg_expr RPAREN stmt_paren_bool_tail RPAREN stmt_paren_bool_cont
                        | ID stmt_paren_id_cont
                        | LPAREN stmt_paren_typed_content RPAREN stmt_paren_any_cont
                        | INCR ID stmt_paren_num_after_incr
                        | DECR ID stmt_paren_num_after_incr

// String continuation after paren - only concat allowed
stmt_paren_string_cont: CONCAT stmt_string_operand stmt_concat_tail_typed
                      |

// Numeric starting in paren - may stay numeric or become boolean via comparison
stmt_paren_num_start: stmt_paren_arith_ops
                    | stmt_cmp_op numeric_add_expr_stmt stmt_paren_bool_tail RPAREN stmt_paren_bool_cont
                    | RPAREN stmt_paren_num_cont

stmt_paren_arith_ops: PLUS numeric_mul_expr_stmt stmt_numeric_add_ops stmt_paren_after_arith
                    | MINUS numeric_mul_expr_stmt stmt_numeric_add_ops stmt_paren_after_arith
                    | STAR numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_ops stmt_paren_after_arith
                    | SLASH numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_ops stmt_paren_after_arith
                    | MOD numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_ops stmt_paren_after_arith

stmt_paren_after_arith: stmt_cmp_op numeric_add_expr_stmt stmt_paren_bool_tail RPAREN stmt_paren_bool_cont
                      | RPAREN stmt_paren_num_cont

// Negated numeric in paren
stmt_paren_neg_num: numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_ops stmt_paren_after_arith

// After ++id or --id in paren
stmt_paren_num_after_incr: stmt_paren_arith_ops
                         | stmt_cmp_op numeric_add_expr_stmt stmt_paren_bool_tail RPAREN stmt_paren_bool_cont
                         | RPAREN stmt_paren_num_cont

// Numeric continuation after ) - allows arithmetic, comparison, and bool ops
stmt_paren_num_cont: stmt_arith_ops stmt_after_arith
                   | stmt_cmp_op numeric_add_expr_stmt stmt_bool_tail_opt
                   | stmt_bool_tail_opt

// Boolean tail inside paren (before closing)
stmt_paren_bool_tail: AND stmt_bool_term stmt_bool_and_tail stmt_bool_or_tail_opt
                    | OR stmt_bool_term stmt_bool_or_tail
                    |

// Boolean continuation after ) - ONLY && and || allowed, NO arithmetic
stmt_paren_bool_cont: AND stmt_bool_term stmt_bool_and_tail stmt_bool_or_tail_opt
                    | OR stmt_bool_term stmt_bool_or_tail
                    |

// ID in paren - type unknown, dispatch based on what follows
// Uses stmt_paren_postfix_nonnull to avoid reduce/reduce with empty bool_tail
stmt_paren_id_cont: stmt_paren_arith_ops
                  | stmt_cmp_op numeric_add_expr_stmt stmt_paren_bool_tail RPAREN stmt_paren_bool_cont
                  | stmt_paren_postfix_nonnull stmt_paren_id_after_postfix
                  | INCR RPAREN stmt_paren_num_cont
                  | DECR RPAREN stmt_paren_num_cont
                  | AND stmt_bool_term stmt_bool_and_tail stmt_bool_or_tail_opt RPAREN stmt_paren_any_cont
                  | OR stmt_bool_term stmt_bool_or_tail RPAREN stmt_paren_any_cont
                  | RPAREN stmt_paren_any_cont

// Non-nullable postfix chain for use inside parens (avoids conflict with bool_tail)
stmt_paren_postfix_nonnull: LBRACK array_index RBRACK stmt_postfix_after_arr
                          | DOT ID stmt_postfix_chain
                          | LPAREN arg_list RPAREN stmt_postfix_chain

stmt_paren_id_after_postfix: stmt_paren_arith_ops
                           | stmt_cmp_op numeric_add_expr_stmt stmt_paren_bool_tail RPAREN stmt_paren_bool_cont
                           | CONCAT stmt_string_operand stmt_concat_tail_typed RPAREN stmt_paren_string_cont
                           | AND stmt_bool_term stmt_bool_and_tail stmt_bool_or_tail_opt RPAREN stmt_paren_any_cont
                           | OR stmt_bool_term stmt_bool_or_tail RPAREN stmt_paren_any_cont
                           | RPAREN stmt_paren_any_cont

// Any continuation after ) - for ID and nested parens where type is unknown
stmt_paren_any_cont: stmt_arith_ops stmt_after_arith
                   | stmt_cmp_op numeric_add_expr_stmt stmt_bool_tail_opt
                   | CONCAT stmt_string_operand stmt_concat_tail_typed
                   | stmt_bool_tail_opt

// Concat tail - string-only continuation
stmt_concat_tail_typed: CONCAT stmt_string_operand stmt_concat_tail_typed
                      |

// String operand for concat RHS - allows any value (implicit string conversion)
stmt_string_operand: STRINGLIT
                   | CHARLIT
                   | ID
                   | STRING LPAREN arg_expr RPAREN
                   | CHAR LPAREN arg_expr RPAREN
                   | LPAREN stmt_string_operand stmt_concat_tail_typed RPAREN
                   | INTLIT
                   | LONGLIT
                   | FLOATLIT
                   | DOUBLELIT
                   | TRUE
                   | FALSE
                   | INT LPAREN arg_expr RPAREN
                   | LONG LPAREN arg_expr RPAREN
                   | FLOAT LPAREN arg_expr RPAREN
                   | DOUBLE LPAREN arg_expr RPAREN
                   | BOOL LPAREN arg_expr RPAREN

// Boolean term for operand of OR (enforces boolean discipline)
stmt_bool_term: stmt_bool_eq stmt_bool_and_tail

stmt_bool_and_tail: AND stmt_bool_eq stmt_bool_and_tail
                  |

stmt_bool_or_tail: OR stmt_bool_term stmt_bool_or_tail
                 |

// Equality level for boolean expressions
// At this level, comparisons produce boolean results
stmt_bool_eq: stmt_bool_factor stmt_bool_eq_tail

stmt_bool_eq_tail: EQ stmt_bool_factor stmt_bool_eq_tail
                 | NEQ stmt_bool_factor stmt_bool_eq_tail
                 |

// Boolean factor - NOT or atom
stmt_bool_factor: NOT stmt_bool_factor
                | stmt_bool_atom

// Boolean atom - the base boolean-producing constructs
// Left-factored: ID handled specially, numeric literals require comparison
stmt_bool_atom: TRUE
              | FALSE
              | ID stmt_bool_id_cont
              | INTLIT stmt_numeric_cmp_required
              | LONGLIT stmt_numeric_cmp_required
              | FLOATLIT stmt_numeric_cmp_required
              | DOUBLELIT stmt_numeric_cmp_required
              | MINUS stmt_numeric_neg_cmp
              | LPAREN stmt_bool_paren RPAREN
              | INT LPAREN arg_expr RPAREN stmt_numeric_cmp_required
              | LONG LPAREN arg_expr RPAREN stmt_numeric_cmp_required
              | FLOAT LPAREN arg_expr RPAREN stmt_numeric_cmp_required
              | DOUBLE LPAREN arg_expr RPAREN stmt_numeric_cmp_required

// After ID in boolean context: could be boolean var, or start of comparison
// Note: empty case handled by stmt_postfix_chain which can be empty
stmt_bool_id_cont: stmt_numeric_arith_cmp
                 | INCR
                 | DECR
                 | stmt_postfix_chain

// Numeric arithmetic followed by mandatory comparison (for ID start)
stmt_numeric_arith_cmp: PLUS numeric_mul_expr_stmt stmt_numeric_add_cmp stmt_cmp_op numeric_add_expr_stmt
                      | MINUS numeric_mul_expr_stmt stmt_numeric_add_cmp stmt_cmp_op numeric_add_expr_stmt
                      | STAR numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_cmp stmt_cmp_op numeric_add_expr_stmt
                      | SLASH numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_cmp stmt_cmp_op numeric_add_expr_stmt
                      | MOD numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_cmp stmt_cmp_op numeric_add_expr_stmt
                      | stmt_cmp_op numeric_add_expr_stmt

stmt_numeric_add_cmp: PLUS numeric_mul_expr_stmt stmt_numeric_add_cmp
                    | MINUS numeric_mul_expr_stmt stmt_numeric_add_cmp
                    |

// Numeric literal MUST be followed by comparison (can't use as bare bool)
stmt_numeric_cmp_required: stmt_numeric_lit_arith stmt_cmp_op numeric_add_expr_stmt

stmt_numeric_lit_arith: STAR numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_cmp
                      | SLASH numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_cmp
                      | MOD numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_cmp
                      | PLUS numeric_mul_expr_stmt stmt_numeric_add_cmp
                      | MINUS numeric_mul_expr_stmt stmt_numeric_add_cmp
                      |

// Negated numeric - must have comparison
stmt_numeric_neg_cmp: numeric_unary_expr_stmt numeric_mul_tail_stmt stmt_numeric_add_cmp stmt_cmp_op numeric_add_expr_stmt

// Comparison operators
stmt_cmp_op: LT
           | GT
           | LTE
           | GTE
           | EQ
           | NEQ

// Parenthesized expression in boolean context
// Parenthesized content in boolean atom context
stmt_bool_paren: stmt_bool_term stmt_bool_and_or_tail

stmt_bool_and_or_tail: AND stmt_bool_term stmt_bool_and_or_tail
                     | OR stmt_bool_term stmt_bool_and_or_tail
                     |

// ============================================
// STMT LAYER NUMERIC RULES
// ============================================
// Used by typed expression dispatch for arithmetic operations

numeric_mul_expr_stmt: numeric_unary_expr_stmt numeric_mul_tail_stmt

numeric_mul_tail_stmt: STAR numeric_unary_expr_stmt numeric_mul_tail_stmt
                     | SLASH numeric_unary_expr_stmt numeric_mul_tail_stmt
                     | MOD numeric_unary_expr_stmt numeric_mul_tail_stmt
                     |

numeric_add_expr_stmt: numeric_mul_expr_stmt numeric_add_tail_stmt

numeric_add_tail_stmt: PLUS numeric_mul_expr_stmt numeric_add_tail_stmt
                     | MINUS numeric_mul_expr_stmt numeric_add_tail_stmt
                     |

numeric_unary_expr_stmt: NOT numeric_unary_expr_stmt
                       | MINUS numeric_unary_expr_stmt
                       | numeric_postfix_expr_stmt

// Numeric postfix - only numeric literals, id, parens, numeric casts
numeric_postfix_expr_stmt: LPAREN arg_expr RPAREN stmt_postfix_chain
                         | INT LPAREN arg_expr RPAREN
                         | LONG LPAREN arg_expr RPAREN
                         | FLOAT LPAREN arg_expr RPAREN
                         | DOUBLE LPAREN arg_expr RPAREN
                         | INCR ID
                         | DECR ID
                         | ID stmt_id_postfix
                         | INTLIT
                         | LONGLIT
                         | FLOATLIT
                         | DOUBLELIT

stmt_id_postfix: INCR
               | DECR
               | stmt_postfix_chain

stmt_postfix_chain: stmt_array_access stmt_postfix_after_arr
                  | DOT ID stmt_postfix_chain
                  | LPAREN stmt_arg_list RPAREN stmt_postfix_chain
                  |

stmt_array_access: LBRACK stmt_array_index RBRACK stmt_array_access_dim2

stmt_array_access_dim2: LBRACK stmt_array_index RBRACK
                      |

stmt_postfix_after_arr: DOT ID stmt_postfix_chain
                      | LPAREN stmt_arg_list RPAREN stmt_postfix_chain
                      |

stmt_array_index: INTLIT
                | ID

// Argument list within stmt_expr context uses arg_expr for clean FOLLOW
stmt_arg_list: arg_expr stmt_arg_tail
             |

stmt_arg_tail: COMMA arg_expr stmt_arg_tail
             |

// ============================================
// ARGUMENT EXPRESSION (ISOLATED FOLLOW SET)
// ============================================
// BATCH 3 - Typed Expression Discipline for arg context
// - Assignment does NOT chain (a = b = c is invalid)
// - Boolean operators (&&, ||, !) require boolean operands
// - Concat (..) requires string-like operands
// - Relational (<, >, <=, >=) require numeric operands
// - Arithmetic (+, -, *, /, %) require numeric operands
// FOLLOW set isolated to {, )} for argument contexts

arg_expr: arg_typed_rhs arg_assign_tail

// assign_tail does NOT recurse to arg_assign_expr - prevents a = b = c
arg_assign_tail: assign_op arg_typed_rhs
               |

// Typed RHS - entry point after assignment operator
arg_typed_rhs: arg_bool_or_concat

// Top-level typed: either concat chain, numeric expression, or boolean expression
arg_bool_or_concat: STRINGLIT arg_concat_tail_typed
                  | CHARLIT arg_concat_tail_typed
                  | STRING LPAREN arg_expr RPAREN arg_concat_tail_typed
                  | INTLIT arg_numeric_or_bool
                  | LONGLIT arg_numeric_or_bool
                  | FLOATLIT arg_numeric_or_bool
                  | DOUBLELIT arg_numeric_or_bool
                  | MINUS arg_neg_numeric_or_bool
                  | TRUE arg_bool_tail_opt
                  | FALSE arg_bool_tail_opt
                  | NOT arg_bool_factor arg_bool_tail_opt
                  | INT LPAREN arg_expr RPAREN arg_numeric_or_bool
                  | LONG LPAREN arg_expr RPAREN arg_numeric_or_bool
                  | FLOAT LPAREN arg_expr RPAREN arg_numeric_or_bool
                  | DOUBLE LPAREN arg_expr RPAREN arg_numeric_or_bool
                  | CHAR LPAREN arg_expr RPAREN
                  | BOOL LPAREN arg_expr RPAREN arg_bool_tail_opt
                  | ID arg_id_toplevel_cont
                  | LPAREN arg_toplevel_paren RPAREN arg_toplevel_paren_cont
                  | INCR ID
                  | DECR ID

// After numeric literal at top level: arithmetic, relational, or boolean ops
arg_numeric_or_bool: arg_arith_ops arg_after_arith
                   | arg_cmp_op numeric_add_expr_arg arg_bool_tail_opt
                   | arg_bool_tail_opt

// Arithmetic operators
arg_arith_ops: PLUS numeric_mul_expr_arg arg_numeric_add_ops
             | MINUS numeric_mul_expr_arg arg_numeric_add_ops
             | STAR numeric_unary_expr_arg numeric_mul_tail_arg arg_numeric_add_ops
             | SLASH numeric_unary_expr_arg numeric_mul_tail_arg arg_numeric_add_ops
             | MOD numeric_unary_expr_arg numeric_mul_tail_arg arg_numeric_add_ops

arg_numeric_add_ops: PLUS numeric_mul_expr_arg arg_numeric_add_ops
                   | MINUS numeric_mul_expr_arg arg_numeric_add_ops
                   |

// After arithmetic: may have comparison, then optionally boolean ops
arg_after_arith: arg_cmp_op numeric_add_expr_arg arg_bool_tail_opt
               | arg_bool_tail_opt

// Negated numeric: arithmetic then optional comparison and boolean
arg_neg_numeric_or_bool: numeric_unary_expr_arg numeric_mul_tail_arg arg_numeric_add_ops arg_after_arith

// Boolean tail (AND/OR) - optional
arg_bool_tail_opt: AND arg_bool_term arg_bool_and_tail arg_bool_or_tail_opt
                 | OR arg_bool_term arg_bool_or_tail
                 |

arg_bool_or_tail_opt: OR arg_bool_term arg_bool_or_tail
                    |

// After ID at top level
arg_id_toplevel_cont: arg_arith_ops arg_after_arith
                    | arg_cmp_op numeric_add_expr_arg arg_bool_tail_opt
                    | INCR
                    | DECR
                    | arg_postfix_chain arg_id_after_postfix

arg_id_after_postfix: arg_arith_ops arg_after_arith
                    | arg_cmp_op numeric_add_expr_arg arg_bool_tail_opt
                    | CONCAT arg_string_operand arg_concat_tail_typed
                    | arg_bool_tail_opt

// Parenthesized at top level
arg_toplevel_paren: arg_bool_or_concat

arg_toplevel_paren_cont: arg_arith_ops arg_after_arith
                       | arg_cmp_op numeric_add_expr_arg arg_bool_tail_opt
                       | CONCAT arg_string_operand arg_concat_tail_typed
                       | arg_bool_tail_opt

// Concat tail - string-only continuation
arg_concat_tail_typed: CONCAT arg_string_operand arg_concat_tail_typed
                     |

// String operand for concat RHS
arg_string_operand: STRINGLIT
                  | CHARLIT
                  | ID
                  | STRING LPAREN arg_expr RPAREN
                  | CHAR LPAREN arg_expr RPAREN
                  | LPAREN arg_string_operand arg_concat_tail_typed RPAREN

// Boolean term for operand of OR (enforces boolean discipline)
arg_bool_term: arg_bool_eq arg_bool_and_tail

arg_bool_and_tail: AND arg_bool_eq arg_bool_and_tail
                 |

arg_bool_or_tail: OR arg_bool_term arg_bool_or_tail
                |

// Equality level for boolean expressions
arg_bool_eq: arg_bool_factor arg_bool_eq_tail

arg_bool_eq_tail: EQ arg_bool_factor arg_bool_eq_tail
                | NEQ arg_bool_factor arg_bool_eq_tail
                |

// Boolean factor - NOT or atom
arg_bool_factor: NOT arg_bool_factor
               | arg_bool_atom

// Boolean atom - the base boolean-producing constructs
arg_bool_atom: TRUE
             | FALSE
             | ID arg_bool_id_cont
             | INTLIT arg_numeric_cmp_required
             | LONGLIT arg_numeric_cmp_required
             | FLOATLIT arg_numeric_cmp_required
             | DOUBLELIT arg_numeric_cmp_required
             | MINUS arg_numeric_neg_cmp
             | LPAREN arg_bool_paren RPAREN
             | INT LPAREN arg_expr RPAREN arg_numeric_cmp_required
             | LONG LPAREN arg_expr RPAREN arg_numeric_cmp_required
             | FLOAT LPAREN arg_expr RPAREN arg_numeric_cmp_required
             | DOUBLE LPAREN arg_expr RPAREN arg_numeric_cmp_required

// Parenthesized content in boolean atom context
arg_bool_paren: arg_bool_term arg_bool_and_or_tail

arg_bool_and_or_tail: AND arg_bool_term arg_bool_and_or_tail
                    | OR arg_bool_term arg_bool_and_or_tail
                    |

// After ID in boolean context
arg_bool_id_cont: arg_numeric_arith_cmp
                | INCR
                | DECR
                | arg_postfix_chain

// Numeric arithmetic followed by mandatory comparison (for ID start)
arg_numeric_arith_cmp: PLUS numeric_mul_expr_arg arg_numeric_add_cmp arg_cmp_op numeric_add_expr_arg
                     | MINUS numeric_mul_expr_arg arg_numeric_add_cmp arg_cmp_op numeric_add_expr_arg
                     | STAR numeric_unary_expr_arg numeric_mul_tail_arg arg_numeric_add_cmp arg_cmp_op numeric_add_expr_arg
                     | SLASH numeric_unary_expr_arg numeric_mul_tail_arg arg_numeric_add_cmp arg_cmp_op numeric_add_expr_arg
                     | MOD numeric_unary_expr_arg numeric_mul_tail_arg arg_numeric_add_cmp arg_cmp_op numeric_add_expr_arg
                     | arg_cmp_op numeric_add_expr_arg

arg_numeric_add_cmp: PLUS numeric_mul_expr_arg arg_numeric_add_cmp
                   | MINUS numeric_mul_expr_arg arg_numeric_add_cmp
                   |

// Numeric literal MUST be followed by comparison (can't use as bare bool)
arg_numeric_cmp_required: arg_numeric_lit_arith arg_cmp_op numeric_add_expr_arg

arg_numeric_lit_arith: STAR numeric_unary_expr_arg numeric_mul_tail_arg arg_numeric_add_cmp
                     | SLASH numeric_unary_expr_arg numeric_mul_tail_arg arg_numeric_add_cmp
                     | MOD numeric_unary_expr_arg numeric_mul_tail_arg arg_numeric_add_cmp
                     | PLUS numeric_mul_expr_arg arg_numeric_add_cmp
                     | MINUS numeric_mul_expr_arg arg_numeric_add_cmp
                     |

// Negated numeric - must have comparison
arg_numeric_neg_cmp: numeric_unary_expr_arg numeric_mul_tail_arg arg_numeric_add_cmp arg_cmp_op numeric_add_expr_arg

// Comparison operators for arg context
arg_cmp_op: LT
          | GT
          | LTE
          | GTE
          | EQ
          | NEQ

// ============================================
// ARG LAYER NUMERIC RULES
// ============================================
// Used by typed expression dispatch for arithmetic in argument contexts

numeric_mul_expr_arg: numeric_unary_expr_arg numeric_mul_tail_arg

numeric_mul_tail_arg: STAR numeric_unary_expr_arg numeric_mul_tail_arg
                    | SLASH numeric_unary_expr_arg numeric_mul_tail_arg
                    | MOD numeric_unary_expr_arg numeric_mul_tail_arg
                    |

numeric_add_expr_arg: numeric_mul_expr_arg numeric_add_tail_arg

numeric_add_tail_arg: PLUS numeric_mul_expr_arg numeric_add_tail_arg
                    | MINUS numeric_mul_expr_arg numeric_add_tail_arg
                    |

numeric_unary_expr_arg: NOT numeric_unary_expr_arg
                      | MINUS numeric_unary_expr_arg
                      | numeric_postfix_expr_arg

// Numeric postfix - only numeric literals, id, parens, numeric casts
numeric_postfix_expr_arg: LPAREN arg_expr RPAREN arg_postfix_chain
                        | INT LPAREN arg_expr RPAREN
                        | LONG LPAREN arg_expr RPAREN
                        | FLOAT LPAREN arg_expr RPAREN
                        | DOUBLE LPAREN arg_expr RPAREN
                        | INCR ID
                        | DECR ID
                        | ID arg_id_postfix
                        | INTLIT
                        | LONGLIT
                        | FLOATLIT
                        | DOUBLELIT

arg_id_postfix: INCR
              | DECR
              | arg_postfix_chain

arg_postfix_chain: arg_array_access arg_postfix_after_arr
                 | DOT ID arg_postfix_chain
                 | LPAREN arg_nested_list RPAREN arg_postfix_chain
                 |

arg_array_access: LBRACK arg_array_index RBRACK arg_array_access_dim2

arg_array_access_dim2: LBRACK arg_array_index RBRACK
                     |

arg_postfix_after_arr: DOT ID arg_postfix_chain
                     | LPAREN arg_nested_list RPAREN arg_postfix_chain
                     |

arg_array_index: INTLIT
               | ID

// Nested argument list within arg_expr (for function calls inside arguments)
arg_nested_list: arg_expr arg_nested_tail
               |

arg_nested_tail: COMMA arg_expr arg_nested_tail
               |

// ============================================
// I/O STATEMENTS
// ============================================

io_stmt: TRAP LPAREN trap_target RPAREN SEMICOLON
       | THREAD LPAREN print_args RPAREN SEMICOLON
       | THREADLN LPAREN print_args RPAREN SEMICOLON

// trap() accepts exactly one variable target (id with optional array/member access)
trap_target: ID trap_target_tail

trap_target_tail: LBRACK arg_expr RBRACK
                | DOT ID
                |

print_args: arg_expr print_tail

print_tail: COMMA arg_expr print_tail
          |

// ============================================
// CONTROL STRUCTURES (for main function only)
// ============================================
// These control structure rules are used ONLY in main function
// All other functions use type-specific control structures (ctrl_struct_int, etc.)
// BREAK RESTRICTION: break; only valid in loop/switch bodies (loop_ctrl_stmt_list)

ctrl_struct: IF LPAREN condition RPAREN LBRACE non_empty_ctrl_stmt_list RBRACE else_opt
           | SWITCH LPAREN arg_expr RPAREN LBRACE case_list default_opt RBRACE
           | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE non_empty_loop_ctrl_stmt_list RBRACE
           | WHILE LPAREN condition RPAREN LBRACE non_empty_loop_ctrl_stmt_list RBRACE
           | DO LBRACE non_empty_loop_ctrl_stmt_list RBRACE WHILE LPAREN condition RPAREN SEMICOLON

// Statement list for control structures in main function (no break at top level)
ctrl_stmt_list: statement_non_return ctrl_stmt_list
              |

// Non-empty statement list for control structure bodies
non_empty_ctrl_stmt_list: statement_non_return ctrl_stmt_list

// Loop statement includes break (valid in loop/switch bodies)
loop_statement_non_return: statement_non_return
                         | BREAK SEMICOLON

// Statement list for loop/switch bodies in main function (break allowed)
loop_ctrl_stmt_list: loop_statement_non_return loop_ctrl_stmt_list
                   |

// Non-empty loop statement list for loop/switch bodies
non_empty_loop_ctrl_stmt_list: loop_statement_non_return loop_ctrl_stmt_list

else_opt: ELSE else_body
        |

else_body: LBRACE non_empty_ctrl_stmt_list RBRACE
         | IF LPAREN condition RPAREN LBRACE non_empty_ctrl_stmt_list RBRACE else_opt

case_list: CASE case_val COLON non_empty_loop_ctrl_stmt_list break_opt case_list
         |

case_val: INTLIT
        | LONGLIT
        | CHARLIT
        | TRUE
        | FALSE

default_opt: DEFAULT COLON non_empty_loop_ctrl_stmt_list break_opt
           |

break_opt: BREAK SEMICOLON
         |

for_init: LOCAL VAR for_init_type ID ASSIGN for_init_expr
        | ID for_init_assign_tail
        |

for_init_assign_tail: assign_op for_init_expr

// Restricted expression for for_init: no assignment chaining
// Uses stmt_typed_rhs since for_init is followed by SEMICOLON
for_init_expr: stmt_typed_rhs

for_init_type: INT
             | LONG
             | FLOAT
             | DOUBLE
             | CHAR
             | STRING
             | BOOL

for_cond: condition

// ============================================
// BATCH 2 – CONDITION SYSTEM REPLACED
// ============================================
// Self-contained typed boolean system for conditions.
// Strict boolean discipline: only boolean-producing constructs allowed.
// Arithmetic requires comparison. Logical ops only on booleans.
// Left-factored to be LALR(1)-compatible.

condition: cond_or

cond_or: cond_and cond_or_tail

cond_or_tail: OR cond_and cond_or_tail
            |

cond_and: cond_not cond_and_tail

cond_and_tail: AND cond_not cond_and_tail
             |

cond_not: NOT cond_not
        | cond_atom

// Left-factored atom: ID and LPAREN handled specially
cond_atom: TRUE
         | FALSE
         | ID cond_id_cont
         | LPAREN cond_paren_inner RPAREN cond_paren_tail
         | cond_lit_cmp

// Content inside parentheses - unified for left-factoring
// Supports: (x), (x<5), (x+5)>10, (!flag), (a&&b)
cond_paren_inner: cond_paren_start cond_paren_cont

cond_paren_start: ID
                | INTLIT
                | LONGLIT
                | FLOATLIT
                | DOUBLELIT
                | TRUE
                | FALSE
                | NOT cond_not
                | MINUS cond_paren_unary
                | LPAREN cond_paren_inner RPAREN

// After initial token inside parens: arithmetic ops, comparison ops, or logical ops
cond_paren_cont: cond_paren_arith_ops cond_paren_after_arith
               | cond_cmp cond_rhs cond_paren_logic
               | cond_paren_logic

// Arithmetic operations inside parens
cond_paren_arith_ops: PLUS cond_paren_unary cond_paren_mul_ops
                    | MINUS cond_paren_unary cond_paren_mul_ops
                    | STAR cond_paren_unary cond_paren_mul_ops
                    | SLASH cond_paren_unary cond_paren_mul_ops
                    | MOD cond_paren_unary cond_paren_mul_ops

cond_paren_mul_ops: STAR cond_paren_unary cond_paren_mul_ops
                  | SLASH cond_paren_unary cond_paren_mul_ops
                  | MOD cond_paren_unary cond_paren_mul_ops
                  | PLUS cond_paren_unary cond_paren_mul_ops
                  | MINUS cond_paren_unary cond_paren_mul_ops
                  |

cond_paren_unary: MINUS cond_paren_unary
                | cond_paren_primary

cond_paren_primary: INTLIT
                  | LONGLIT
                  | FLOATLIT
                  | DOUBLELIT
                  | ID cond_rhs_id_tail
                  | LPAREN cond_paren_inner RPAREN

// After arithmetic inside parens: might have comparison, then logic
cond_paren_after_arith: cond_cmp cond_rhs cond_paren_logic
                      |

// Logical operations inside parens (for full boolean expressions)
cond_paren_logic: AND cond_and
               | OR cond_or
               |

// What follows RPAREN: nothing (was boolean) or comparison (was arithmetic LHS)
cond_paren_tail: cond_cmp cond_rhs
               |

// After ID in condition: bare boolean OR comparison with arithmetic
// String comparisons disallowed in conditions
// Array access supported: arr[i] > 0
cond_id_cont: LBRACK cond_arr_index RBRACK cond_id_arr_cont
            | PLUS cond_rhs_unary cond_rhs_mul cond_rhs_add cond_cmp cond_rhs
            | MINUS cond_rhs_unary cond_rhs_mul cond_rhs_add cond_cmp cond_rhs
            | STAR cond_rhs_unary cond_rhs_mul cond_rhs_add cond_cmp cond_rhs
            | SLASH cond_rhs_unary cond_rhs_mul cond_rhs_add cond_cmp cond_rhs
            | MOD cond_rhs_unary cond_rhs_mul cond_rhs_add cond_cmp cond_rhs
            | LT cond_rhs
            | GT cond_rhs
            | LTE cond_rhs
            | GTE cond_rhs
            | EQ cond_rhs
            | NEQ cond_rhs
            |

// Array index expression (numeric)
cond_arr_index: cond_rhs

// After arr[i]: optional 2D access, then arithmetic/comparison
cond_id_arr_cont: LBRACK cond_arr_index RBRACK cond_id_arr_after
                | cond_id_arr_after

cond_id_arr_after: PLUS cond_rhs_unary cond_rhs_mul cond_rhs_add cond_cmp cond_rhs
                 | MINUS cond_rhs_unary cond_rhs_mul cond_rhs_add cond_cmp cond_rhs
                 | STAR cond_rhs_unary cond_rhs_mul cond_rhs_add cond_cmp cond_rhs
                 | SLASH cond_rhs_unary cond_rhs_mul cond_rhs_add cond_cmp cond_rhs
                 | MOD cond_rhs_unary cond_rhs_mul cond_rhs_add cond_cmp cond_rhs
                 | LT cond_rhs
                 | GT cond_rhs
                 | LTE cond_rhs
                 | GTE cond_rhs
                 | EQ cond_rhs
                 | NEQ cond_rhs
                 |

// Literal-starting comparison (MUST have comparison - no bare literals allowed)
// String/char literals disallowed in conditions
cond_lit_cmp: INTLIT cond_lit_mul cond_lit_add cond_cmp cond_rhs
            | LONGLIT cond_lit_mul cond_lit_add cond_cmp cond_rhs
            | FLOATLIT cond_lit_mul cond_lit_add cond_cmp cond_rhs
            | DOUBLELIT cond_lit_mul cond_lit_add cond_cmp cond_rhs
            | MINUS cond_lit_unary cond_lit_mul cond_lit_add cond_cmp cond_rhs

// LHS-specific tail rules (isolated from RHS to avoid conflicts)
cond_lit_mul: STAR cond_lit_unary cond_lit_mul
            | SLASH cond_lit_unary cond_lit_mul
            | MOD cond_lit_unary cond_lit_mul
            |

cond_lit_add: PLUS cond_lit_unary cond_lit_mul cond_lit_add
            | MINUS cond_lit_unary cond_lit_mul cond_lit_add
            |

cond_lit_unary: MINUS cond_lit_unary
              | cond_lit_primary

cond_lit_primary: INTLIT
                | LONGLIT
                | FLOATLIT
                | DOUBLELIT
                | ID cond_rhs_id_tail
                | LPAREN cond_lit_expr RPAREN

cond_lit_expr: cond_lit_unary cond_lit_mul cond_lit_add

// RHS expression rules (after comparison operator)
cond_rhs: cond_rhs_unary cond_rhs_mul cond_rhs_add

cond_rhs_unary: MINUS cond_rhs_unary
              | cond_rhs_primary

cond_rhs_primary: INTLIT
                | LONGLIT
                | FLOATLIT
                | DOUBLELIT
                | ID cond_rhs_id_tail
                | LPAREN cond_rhs RPAREN

// Optional array access after ID in RHS
cond_rhs_id_tail: LBRACK cond_arr_index RBRACK cond_rhs_arr_tail
                |

cond_rhs_arr_tail: LBRACK cond_arr_index RBRACK
                 |

cond_rhs_mul: STAR cond_rhs_unary cond_rhs_mul
            | SLASH cond_rhs_unary cond_rhs_mul
            | MOD cond_rhs_unary cond_rhs_mul
            |

cond_rhs_add: PLUS cond_rhs_unary cond_rhs_mul cond_rhs_add
            | MINUS cond_rhs_unary cond_rhs_mul cond_rhs_add
            |

cond_cmp: LT
        | GT
        | LTE
        | GTE
        | EQ
        | NEQ

////////////////////////////////////////////////////////

for_update: ID for_update_tail
          | INCR ID
          | DECR ID
          |

for_update_tail: INCR
               | DECR
               | assign_op arg_expr

// ============================================
// MAIN FUNCTION BODY
// ============================================

main_body: main_content

main_content: USING ID using_cont SEMICOLON main_content
            | LOCAL mutability local_dec_body main_content
            | statement_non_return main_content
            | RETURN INTLIT SEMICOLON

// ============================================
// TERMINALS
// ============================================

GLOBAL: "global"
LOCAL: "local"
FUNC: "func"
RETURN: "return"
IF: "if"
ELSE: "else"
SWITCH: "switch"
CASE: "case"
DEFAULT: "default"
FOR: "for"
WHILE: "while"
DO: "do"
BREAK: "break"
TRAP: "trap"
THREAD: "thread"
THREADLN: "threadln"
USING: "using"
WEAVE: "weave"
MAIN: "main"

INT: "int"
LONG: "long"
FLOAT: "float"
DOUBLE: "double"
CHAR: "char"
STRING: "string"
BOOL: "bool"
VOID: "void"

VAR: "var"
CONST: "const"
TRUE: "true"
FALSE: "false"

ASSIGN: "="
PLUSEQ: "+="
MINUSEQ: "-="
STAREQ: "*="
SLASHEQ: "/="
MODEQ: "%="

EQ: "=="
NEQ: "!="
LT: "<"
GT: ">"
LTE: "<="
GTE: ">="

AND: "&&"
OR: "||"
NOT: "!"

PLUS: "+"
MINUS: "-"
STAR: "*"
SLASH: "/"
MOD: "%"
INCR: "++"
DECR: "--"
CONCAT: ".."

LPAREN: "("
RPAREN: ")"
LBRACE: "{"
RBRACE: "}"
LBRACK: "["
RBRACK: "]"
SEMICOLON: ";"
COMMA: ","
COLON: ":"
DOT: "."

// ID MUST NOT match reserved keywords. Using negative lookahead.
// Keywords: int, long, float, double, char, string, bool, void, var, const,
//           true, false, if, else, while, for, switch, case, default, return,
//           func, global, local, do, break, trap, thread, threadln, using,
//           weave, main, array
ID: /(?!(int|long|float|double|char|string|bool|void|var|const|true|false|if|else|while|for|switch|case|default|return|func|global|local|do|break|trap|thread|threadln|using|weave|main|array)\b)[a-zA-Z_][a-zA-Z0-9_]*/
INTLIT: /-?[0-9]{1,10}/
LONGLIT: /-?[0-9]{11,19}/
FLOATLIT: /-?[0-9]+\.[0-9]{1,7}/
DOUBLELIT: /-?[0-9]+\.[0-9]{8,16}/
CHARLIT: /'[^']'/
STRINGLIT: /"[^"]*"/

%ignore /[ \t\n]+/
%ignore /\/\/[^\n]*/
%ignore /\/\*.*?\*\//s
