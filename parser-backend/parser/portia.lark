// PORTIA Language Grammar for Lark LALR(1) Parser
// Strict LL(1) grammar - no ambiguity, no left recursion, fully left-factored
// Note: Lark uses LALR(1), which parses all LL(1) grammars deterministically
// STRICT TYPE-LITERAL MATCHING: declarations accept ONLY matching literal types
// Expressions are FORBIDDEN in all declaration contexts
// EMPTY INITIALIZERS FORBIDDEN: {} is syntactically impossible (R2 compliant)

// ============================================
// PROGRAM STRUCTURE
// ============================================
// STRICT SECTION ORDERING:
// 1. Global declarations (0 or more) - must start with GLOBAL keyword
// 2. Bare top-level arrays (0 or more) - type id[size] = {...};
// 3. Weave definitions (0 or more) - weave type definitions
// 4. Weave instances (0 or more) - instances of weave types
// 5. Function declarations (0 or more) - all func definitions
// 6. Main block (exactly one, required, must be last)
// BARE SCALAR DECLARATIONS FORBIDDEN at top level (e.g., "int x = 5;" is illegal)
// Bare arrays allowed: int arr[3] = {1,2,3}; (array bracket required after id)

?start: program

program: global_section

// Global section: processes globals/weaves/arrays, then transitions to functions or main
// TYPE ID at top level requires [ (array) - scalar declarations forbidden
// INT MAIN is the main function entry point
global_section: global_decl global_section
              | INT ID int_array_with_init SEMICOLON global_section
              | LONG ID long_array_with_init SEMICOLON global_section
              | FLOAT ID float_array_with_init SEMICOLON global_section
              | DOUBLE ID double_array_with_init SEMICOLON global_section
              | CHAR ID char_array_with_init SEMICOLON global_section
              | STRING ID string_array_with_init SEMICOLON global_section
              | BOOL ID bool_array_with_init SEMICOLON global_section
              | WEAVE ID LBRACE field_list RBRACE SEMICOLON global_section
              | ID weave_inst_decl global_section
              | function_decl func_and_main
              | INT MAIN LPAREN RPAREN LBRACE main_body RBRACE

// Function section: one or more functions, then mandatory main
// Once here, no more globals allowed - strict section ordering enforced
func_and_main: function_decl func_and_main
             | INT MAIN LPAREN RPAREN LBRACE main_body RBRACE

// Global declarations - MUST start with GLOBAL keyword
// Each type accepts ONLY its matching literal type
global_decl: GLOBAL mutability INT ID ASSIGN INTLIT int_global_cont SEMICOLON
           | GLOBAL mutability LONG ID ASSIGN LONGLIT long_global_cont SEMICOLON
           | GLOBAL mutability FLOAT ID ASSIGN FLOATLIT float_global_cont SEMICOLON
           | GLOBAL mutability DOUBLE ID ASSIGN DOUBLELIT double_global_cont SEMICOLON
           | GLOBAL mutability CHAR ID ASSIGN CHARLIT char_global_cont SEMICOLON
           | GLOBAL mutability STRING ID ASSIGN STRINGLIT string_global_cont SEMICOLON
           | GLOBAL mutability BOOL ID ASSIGN bool_lit bool_global_cont SEMICOLON

// All function declarations (start with FUNC)
function_decl: FUNC INT func_ret_int
             | FUNC LONG func_ret_long
             | FUNC FLOAT func_ret_float
             | FUNC DOUBLE func_ret_double
             | FUNC CHAR func_ret_char
             | FUNC STRING func_ret_string
             | FUNC BOOL func_ret_bool
             | FUNC ID func_ret_weave
             | FUNC VOID ID LPAREN RPAREN LBRACE function_body_void RBRACE

// Boolean literal helper
bool_lit: TRUE
        | FALSE

// ============================================
// GLOBAL DECLARATION CONTINUATIONS
// ============================================
// Multi-variable global declarations - type-specific literal enforcement

int_global_cont: COMMA ID ASSIGN INTLIT int_global_cont
               |

long_global_cont: COMMA ID ASSIGN LONGLIT long_global_cont
                |

float_global_cont: COMMA ID ASSIGN FLOATLIT float_global_cont
                 |

double_global_cont: COMMA ID ASSIGN DOUBLELIT double_global_cont
                  |

char_global_cont: COMMA ID ASSIGN CHARLIT char_global_cont
                |

string_global_cont: COMMA ID ASSIGN STRINGLIT string_global_cont
                  |

bool_global_cont: COMMA ID ASSIGN bool_lit bool_global_cont
                |

// ============================================
// WEAVE INSTANCE DECLARATIONS
// ============================================
// Weave instances use literal-only field values
// Type checking for weave fields is semantic (field types unknown at parse time)

weave_inst_decl: ID weave_inst_tail weave_inst_cont SEMICOLON
               | weave_array_with_init weave_arr_cont SEMICOLON

weave_inst_tail: ASSIGN LBRACE weave_field_value weave_field_list_tail RBRACE
               | weave_array_with_init

// Weave field values support nested braces for arrays and nested weaves
// Simplified recursive structure avoids LALR conflicts
weave_field_value: INTLIT
                 | LONGLIT
                 | FLOATLIT
                 | DOUBLELIT
                 | CHARLIT
                 | STRINGLIT
                 | TRUE
                 | FALSE
                 | LBRACE weave_value_list RBRACE

// Recursive comma-separated list of field values (handles 1D, 2D, nested weaves)
// Non-nullable: nested braces must contain at least one value
weave_value_list: weave_field_value weave_value_tail

weave_value_tail: COMMA weave_field_value weave_value_tail
                |

weave_field_list_tail: COMMA weave_field_value weave_field_list_tail
                     |

weave_inst_cont: COMMA ID weave_inst_tail weave_inst_cont
               |

weave_arr_cont: COMMA ID weave_array_with_init weave_arr_cont
              |

weave_array_with_init: LBRACK size RBRACK weave_array_init_tail

weave_array_init_tail: LBRACK size RBRACK weave_arr_init_opt_2d
                     | weave_arr_init_opt_1d

weave_arr_init_opt_1d: ASSIGN LBRACE weave_arr_init_content_1d RBRACE
                     |

weave_arr_init_content_1d: LBRACE weave_field_value weave_field_list_tail RBRACE weave_init_1d_tail

weave_init_1d_tail: COMMA LBRACE weave_field_value weave_field_list_tail RBRACE weave_init_1d_tail
                  |

weave_arr_init_opt_2d: ASSIGN LBRACE weave_arr_init_content_2d RBRACE
                     |

weave_arr_init_content_2d: LBRACE weave_init_row RBRACE weave_init_2d_tail

weave_init_row: LBRACE weave_field_value weave_field_list_tail RBRACE weave_init_1d_tail

weave_init_2d_tail: COMMA LBRACE weave_init_row RBRACE weave_init_2d_tail
                  |

// ============================================
// MUTABILITY
// ============================================

mutability: VAR
          | CONST

// ============================================
// SHARED ARRAY DIMENSION RULES
// ============================================
// Used for field declarations and parameter types (no initializers)

array_dims: LBRACK size RBRACK array_dim2_opt

array_dim2_opt: LBRACK size RBRACK
              |

size: INTLIT
    | ID

// ============================================
// TYPE-SPECIFIC ARRAY DECLARATIONS
// ============================================
// Each type has dedicated array rules - elements are raw literals only
// NO type casts, NO expressions, NO identifiers in array initializers

// INT ARRAYS
int_array_with_init: LBRACK size RBRACK int_array_init_tail

int_array_init_tail: LBRACK size RBRACK int_arr_init_opt_2d
                   | int_arr_init_opt_1d

int_arr_init_opt_1d: ASSIGN LBRACE int_arr_init_content_1d RBRACE
                   |

int_arr_init_content_1d: INTLIT int_elem_1d_tail

int_elem_1d_tail: COMMA INTLIT int_elem_1d_tail
                |

int_arr_init_opt_2d: ASSIGN LBRACE int_arr_init_content_2d RBRACE
                   |

int_arr_init_content_2d: LBRACE int_elem_list RBRACE int_elem_2d_tail

int_elem_list: INTLIT int_elem_1d_tail

int_elem_2d_tail: COMMA LBRACE int_elem_list RBRACE int_elem_2d_tail
                |

// LONG ARRAYS
long_array_with_init: LBRACK size RBRACK long_array_init_tail

long_array_init_tail: LBRACK size RBRACK long_arr_init_opt_2d
                    | long_arr_init_opt_1d

long_arr_init_opt_1d: ASSIGN LBRACE long_arr_init_content_1d RBRACE
                    |

long_arr_init_content_1d: LONGLIT long_elem_1d_tail

long_elem_1d_tail: COMMA LONGLIT long_elem_1d_tail
                 |

long_arr_init_opt_2d: ASSIGN LBRACE long_arr_init_content_2d RBRACE
                    |

long_arr_init_content_2d: LBRACE long_elem_list RBRACE long_elem_2d_tail

long_elem_list: LONGLIT long_elem_1d_tail

long_elem_2d_tail: COMMA LBRACE long_elem_list RBRACE long_elem_2d_tail
                 |

// FLOAT ARRAYS
float_array_with_init: LBRACK size RBRACK float_array_init_tail

float_array_init_tail: LBRACK size RBRACK float_arr_init_opt_2d
                     | float_arr_init_opt_1d

float_arr_init_opt_1d: ASSIGN LBRACE float_arr_init_content_1d RBRACE
                     |

float_arr_init_content_1d: FLOATLIT float_elem_1d_tail

float_elem_1d_tail: COMMA FLOATLIT float_elem_1d_tail
                  |

float_arr_init_opt_2d: ASSIGN LBRACE float_arr_init_content_2d RBRACE
                     |

float_arr_init_content_2d: LBRACE float_elem_list RBRACE float_elem_2d_tail

float_elem_list: FLOATLIT float_elem_1d_tail

float_elem_2d_tail: COMMA LBRACE float_elem_list RBRACE float_elem_2d_tail
                  |

// DOUBLE ARRAYS
double_array_with_init: LBRACK size RBRACK double_array_init_tail

double_array_init_tail: LBRACK size RBRACK double_arr_init_opt_2d
                      | double_arr_init_opt_1d

double_arr_init_opt_1d: ASSIGN LBRACE double_arr_init_content_1d RBRACE
                      |

double_arr_init_content_1d: DOUBLELIT double_elem_1d_tail

double_elem_1d_tail: COMMA DOUBLELIT double_elem_1d_tail
                   |

double_arr_init_opt_2d: ASSIGN LBRACE double_arr_init_content_2d RBRACE
                      |

double_arr_init_content_2d: LBRACE double_elem_list RBRACE double_elem_2d_tail

double_elem_list: DOUBLELIT double_elem_1d_tail

double_elem_2d_tail: COMMA LBRACE double_elem_list RBRACE double_elem_2d_tail
                   |

// CHAR ARRAYS
char_array_with_init: LBRACK size RBRACK char_array_init_tail

char_array_init_tail: LBRACK size RBRACK char_arr_init_opt_2d
                    | char_arr_init_opt_1d

char_arr_init_opt_1d: ASSIGN LBRACE char_arr_init_content_1d RBRACE
                    |

char_arr_init_content_1d: CHARLIT char_elem_1d_tail

char_elem_1d_tail: COMMA CHARLIT char_elem_1d_tail
                 |

char_arr_init_opt_2d: ASSIGN LBRACE char_arr_init_content_2d RBRACE
                    |

char_arr_init_content_2d: LBRACE char_elem_list RBRACE char_elem_2d_tail

char_elem_list: CHARLIT char_elem_1d_tail

char_elem_2d_tail: COMMA LBRACE char_elem_list RBRACE char_elem_2d_tail
                 |

// STRING ARRAYS
string_array_with_init: LBRACK size RBRACK string_array_init_tail

string_array_init_tail: LBRACK size RBRACK string_arr_init_opt_2d
                      | string_arr_init_opt_1d

string_arr_init_opt_1d: ASSIGN LBRACE string_arr_init_content_1d RBRACE
                      |

string_arr_init_content_1d: STRINGLIT string_elem_1d_tail

string_elem_1d_tail: COMMA STRINGLIT string_elem_1d_tail
                   |

string_arr_init_opt_2d: ASSIGN LBRACE string_arr_init_content_2d RBRACE
                      |

string_arr_init_content_2d: LBRACE string_elem_list RBRACE string_elem_2d_tail

string_elem_list: STRINGLIT string_elem_1d_tail

string_elem_2d_tail: COMMA LBRACE string_elem_list RBRACE string_elem_2d_tail
                   |

// BOOL ARRAYS
bool_array_with_init: LBRACK size RBRACK bool_array_init_tail

bool_array_init_tail: LBRACK size RBRACK bool_arr_init_opt_2d
                    | bool_arr_init_opt_1d

bool_arr_init_opt_1d: ASSIGN LBRACE bool_arr_init_content_1d RBRACE
                    |

bool_arr_init_content_1d: bool_lit bool_elem_1d_tail

bool_elem_1d_tail: COMMA bool_lit bool_elem_1d_tail
                 |

bool_arr_init_opt_2d: ASSIGN LBRACE bool_arr_init_content_2d RBRACE
                    |

bool_arr_init_content_2d: LBRACE bool_elem_list RBRACE bool_elem_2d_tail

bool_elem_list: bool_lit bool_elem_1d_tail

bool_elem_2d_tail: COMMA LBRACE bool_elem_list RBRACE bool_elem_2d_tail
                 |

// ============================================
// WEAVE (STRUCT) DEFINITIONS
// ============================================

field_list: field_dec field_list
          |

field_dec: field_type ID field_arr_opt field_cont SEMICOLON

field_type: INT
          | LONG
          | FLOAT
          | DOUBLE
          | CHAR
          | STRING
          | BOOL
          | ID

field_arr_opt: array_dims
             |

field_cont: COMMA ID field_arr_opt field_cont
          |

// ============================================
// FUNCTIONS
// ============================================
// R10 — Strict Return Type Enforcement
// Return statements are syntactically restricted to the declared return type category
// Scalar returns: type-specific expressions (literals and casts filtered at top level)
// Array returns: identifier only (no literals, no expressions)
// Weave returns: identifier only (no field access)
// Void returns: bare return only

// Function return type tails - select appropriate body based on return type category
func_ret_int: ID LPAREN param_list RPAREN LBRACE function_body_int RBRACE
            | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_long: ID LPAREN param_list RPAREN LBRACE function_body_long RBRACE
             | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_float: ID LPAREN param_list RPAREN LBRACE function_body_float RBRACE
              | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_double: ID LPAREN param_list RPAREN LBRACE function_body_double RBRACE
               | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_char: ID LPAREN param_list RPAREN LBRACE function_body_char RBRACE
             | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_string: ID LPAREN param_list RPAREN LBRACE function_body_string RBRACE
               | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_bool: ID LPAREN param_list RPAREN LBRACE function_body_bool RBRACE
             | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE

func_ret_weave: ID LPAREN param_list RPAREN LBRACE function_body_weave RBRACE
              | array_dims ID LPAREN param_list RPAREN LBRACE function_body_array RBRACE
              | DOT ID ID LPAREN param_list RPAREN LBRACE function_body_weave RBRACE

param_list: param_type ID param_arr_opt param_cont
          |

param_type: INT
          | LONG
          | FLOAT
          | DOUBLE
          | CHAR
          | STRING
          | BOOL
          | ID

param_arr_opt: array_dims
             |

param_cont: COMMA param_type ID param_arr_opt param_cont
          |

// ============================================
// TYPE-SPECIFIC FUNCTION BODIES
// ============================================
// MANDATORY RETURN ENFORCEMENT:
// - func_content_* is a sequence of using/local/statements ending with mandatory_*_return
// - No lambda alternative ensures at least one return is required
// - Returns can also appear inside control structures (via statement_*_no_ret -> ctrl_struct_*)
// - Semantic analysis verifies all control paths return appropriately

// INT-returning function body
function_body_int: func_content_int

func_content_int: USING ID using_cont SEMICOLON func_content_int
                | LOCAL mutability local_dec_body func_content_int
                | statement_int_no_ret func_content_int
                | mandatory_int_return

mandatory_int_return: RETURN int_return_expr SEMICOLON

// LONG-returning function body
function_body_long: func_content_long

func_content_long: USING ID using_cont SEMICOLON func_content_long
                 | LOCAL mutability local_dec_body func_content_long
                 | statement_long_no_ret func_content_long
                 | mandatory_long_return

mandatory_long_return: RETURN long_return_expr SEMICOLON

// FLOAT-returning function body
function_body_float: func_content_float

func_content_float: USING ID using_cont SEMICOLON func_content_float
                  | LOCAL mutability local_dec_body func_content_float
                  | statement_float_no_ret func_content_float
                  | mandatory_float_return

mandatory_float_return: RETURN float_return_expr SEMICOLON

// DOUBLE-returning function body
function_body_double: func_content_double

func_content_double: USING ID using_cont SEMICOLON func_content_double
                   | LOCAL mutability local_dec_body func_content_double
                   | statement_double_no_ret func_content_double
                   | mandatory_double_return

mandatory_double_return: RETURN double_return_expr SEMICOLON

// CHAR-returning function body
function_body_char: func_content_char

func_content_char: USING ID using_cont SEMICOLON func_content_char
                 | LOCAL mutability local_dec_body func_content_char
                 | statement_char_no_ret func_content_char
                 | mandatory_char_return

mandatory_char_return: RETURN char_return_expr SEMICOLON

// STRING-returning function body
function_body_string: func_content_string

func_content_string: USING ID using_cont SEMICOLON func_content_string
                   | LOCAL mutability local_dec_body func_content_string
                   | statement_string_no_ret func_content_string
                   | mandatory_string_return

mandatory_string_return: RETURN string_return_expr SEMICOLON

// BOOL-returning function body
function_body_bool: func_content_bool

func_content_bool: USING ID using_cont SEMICOLON func_content_bool
                 | LOCAL mutability local_dec_body func_content_bool
                 | statement_bool_no_ret func_content_bool
                 | mandatory_bool_return

mandatory_bool_return: RETURN bool_return_expr SEMICOLON

// ARRAY-returning function body (any base type)
function_body_array: func_content_array

func_content_array: USING ID using_cont SEMICOLON func_content_array
                  | LOCAL mutability local_dec_body func_content_array
                  | statement_array_no_ret func_content_array
                  | mandatory_array_return

mandatory_array_return: RETURN ID SEMICOLON

// WEAVE-returning function body
function_body_weave: func_content_weave

func_content_weave: USING ID using_cont SEMICOLON func_content_weave
                  | LOCAL mutability local_dec_body func_content_weave
                  | statement_weave_no_ret func_content_weave
                  | mandatory_weave_return

mandatory_weave_return: RETURN ID SEMICOLON

// VOID function body
function_body_void: func_content_void

func_content_void: USING ID using_cont SEMICOLON func_content_void
                 | LOCAL mutability local_dec_body func_content_void
                 | statement_void_no_ret func_content_void
                 | mandatory_void_return

mandatory_void_return: RETURN SEMICOLON

// ============================================
// TYPE-SPECIFIC STATEMENTS
// ============================================
// Each return type has its own statement rule including type-appropriate return.
// Return is a first-class statement, allowed anywhere.

statement_int: effect_stmt SEMICOLON
             | io_stmt
             | ctrl_struct_int
             | BREAK SEMICOLON
             | RETURN int_return_expr SEMICOLON

statement_long: effect_stmt SEMICOLON
              | io_stmt
              | ctrl_struct_long
              | BREAK SEMICOLON
              | RETURN long_return_expr SEMICOLON

statement_float: effect_stmt SEMICOLON
               | io_stmt
               | ctrl_struct_float
               | BREAK SEMICOLON
               | RETURN float_return_expr SEMICOLON

statement_double: effect_stmt SEMICOLON
                | io_stmt
                | ctrl_struct_double
                | BREAK SEMICOLON
                | RETURN double_return_expr SEMICOLON

statement_char: effect_stmt SEMICOLON
              | io_stmt
              | ctrl_struct_char
              | BREAK SEMICOLON
              | RETURN char_return_expr SEMICOLON

statement_string: effect_stmt SEMICOLON
                | io_stmt
                | ctrl_struct_string
                | BREAK SEMICOLON
                | RETURN string_return_expr SEMICOLON

statement_bool: effect_stmt SEMICOLON
              | io_stmt
              | ctrl_struct_bool
              | BREAK SEMICOLON
              | RETURN bool_return_expr SEMICOLON

statement_array: effect_stmt SEMICOLON
               | io_stmt
               | ctrl_struct_array
               | BREAK SEMICOLON
               | RETURN ID SEMICOLON

statement_weave: effect_stmt SEMICOLON
               | io_stmt
               | ctrl_struct_weave
               | BREAK SEMICOLON
               | RETURN ID SEMICOLON

statement_void: effect_stmt SEMICOLON
              | io_stmt
              | ctrl_struct_void
              | BREAK SEMICOLON
              | RETURN SEMICOLON

// ============================================
// TYPE-SPECIFIC STATEMENTS (NO DIRECT RETURN)
// ============================================
// These rules exclude direct RETURN statements from function body prefix.
// Control structures (which may contain returns internally) are still allowed.
// Used by func_prefix_* to ensure return appears via terminator.

statement_int_no_ret: effect_stmt SEMICOLON
                    | io_stmt
                    | ctrl_struct_int
                    | BREAK SEMICOLON

statement_long_no_ret: effect_stmt SEMICOLON
                     | io_stmt
                     | ctrl_struct_long
                     | BREAK SEMICOLON

statement_float_no_ret: effect_stmt SEMICOLON
                      | io_stmt
                      | ctrl_struct_float
                      | BREAK SEMICOLON

statement_double_no_ret: effect_stmt SEMICOLON
                       | io_stmt
                       | ctrl_struct_double
                       | BREAK SEMICOLON

statement_char_no_ret: effect_stmt SEMICOLON
                     | io_stmt
                     | ctrl_struct_char
                     | BREAK SEMICOLON

statement_string_no_ret: effect_stmt SEMICOLON
                       | io_stmt
                       | ctrl_struct_string
                       | BREAK SEMICOLON

statement_bool_no_ret: effect_stmt SEMICOLON
                     | io_stmt
                     | ctrl_struct_bool
                     | BREAK SEMICOLON

statement_array_no_ret: effect_stmt SEMICOLON
                      | io_stmt
                      | ctrl_struct_array
                      | BREAK SEMICOLON

statement_weave_no_ret: effect_stmt SEMICOLON
                      | io_stmt
                      | ctrl_struct_weave
                      | BREAK SEMICOLON

statement_void_no_ret: effect_stmt SEMICOLON
                     | io_stmt
                     | ctrl_struct_void
                     | BREAK SEMICOLON

// ============================================
// TYPE-SPECIFIC CONTROL STRUCTURES
// ============================================
// Each return type has its own control structure rules.
// This allows return statements inside if/else/while/for/switch/do-while.

// INT control structures
ctrl_struct_int: IF LPAREN condition RPAREN LBRACE stmt_list_int RBRACE else_opt_int
               | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_int default_opt_int RBRACE
               | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE stmt_list_int RBRACE
               | WHILE LPAREN condition RPAREN LBRACE stmt_list_int RBRACE
               | DO LBRACE stmt_list_int RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_int: statement_int stmt_list_int
             |

else_opt_int: ELSE else_body_int
            |

else_body_int: LBRACE stmt_list_int RBRACE
             | IF LPAREN condition RPAREN LBRACE stmt_list_int RBRACE else_opt_int

case_list_int: CASE case_val COLON stmt_list_int break_opt case_list_int
             |

default_opt_int: DEFAULT COLON stmt_list_int break_opt
               |

// LONG control structures
ctrl_struct_long: IF LPAREN condition RPAREN LBRACE stmt_list_long RBRACE else_opt_long
                | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_long default_opt_long RBRACE
                | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE stmt_list_long RBRACE
                | WHILE LPAREN condition RPAREN LBRACE stmt_list_long RBRACE
                | DO LBRACE stmt_list_long RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_long: statement_long stmt_list_long
              |

else_opt_long: ELSE else_body_long
             |

else_body_long: LBRACE stmt_list_long RBRACE
              | IF LPAREN condition RPAREN LBRACE stmt_list_long RBRACE else_opt_long

case_list_long: CASE case_val COLON stmt_list_long break_opt case_list_long
              |

default_opt_long: DEFAULT COLON stmt_list_long break_opt
                |

// FLOAT control structures
ctrl_struct_float: IF LPAREN condition RPAREN LBRACE stmt_list_float RBRACE else_opt_float
                 | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_float default_opt_float RBRACE
                 | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE stmt_list_float RBRACE
                 | WHILE LPAREN condition RPAREN LBRACE stmt_list_float RBRACE
                 | DO LBRACE stmt_list_float RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_float: statement_float stmt_list_float
               |

else_opt_float: ELSE else_body_float
              |

else_body_float: LBRACE stmt_list_float RBRACE
               | IF LPAREN condition RPAREN LBRACE stmt_list_float RBRACE else_opt_float

case_list_float: CASE case_val COLON stmt_list_float break_opt case_list_float
               |

default_opt_float: DEFAULT COLON stmt_list_float break_opt
                 |

// DOUBLE control structures
ctrl_struct_double: IF LPAREN condition RPAREN LBRACE stmt_list_double RBRACE else_opt_double
                  | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_double default_opt_double RBRACE
                  | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE stmt_list_double RBRACE
                  | WHILE LPAREN condition RPAREN LBRACE stmt_list_double RBRACE
                  | DO LBRACE stmt_list_double RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_double: statement_double stmt_list_double
                |

else_opt_double: ELSE else_body_double
               |

else_body_double: LBRACE stmt_list_double RBRACE
                | IF LPAREN condition RPAREN LBRACE stmt_list_double RBRACE else_opt_double

case_list_double: CASE case_val COLON stmt_list_double break_opt case_list_double
                |

default_opt_double: DEFAULT COLON stmt_list_double break_opt
                  |

// CHAR control structures
ctrl_struct_char: IF LPAREN condition RPAREN LBRACE stmt_list_char RBRACE else_opt_char
                | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_char default_opt_char RBRACE
                | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE stmt_list_char RBRACE
                | WHILE LPAREN condition RPAREN LBRACE stmt_list_char RBRACE
                | DO LBRACE stmt_list_char RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_char: statement_char stmt_list_char
              |

else_opt_char: ELSE else_body_char
             |

else_body_char: LBRACE stmt_list_char RBRACE
              | IF LPAREN condition RPAREN LBRACE stmt_list_char RBRACE else_opt_char

case_list_char: CASE case_val COLON stmt_list_char break_opt case_list_char
              |

default_opt_char: DEFAULT COLON stmt_list_char break_opt
                |

// STRING control structures
ctrl_struct_string: IF LPAREN condition RPAREN LBRACE stmt_list_string RBRACE else_opt_string
                  | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_string default_opt_string RBRACE
                  | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE stmt_list_string RBRACE
                  | WHILE LPAREN condition RPAREN LBRACE stmt_list_string RBRACE
                  | DO LBRACE stmt_list_string RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_string: statement_string stmt_list_string
                |

else_opt_string: ELSE else_body_string
               |

else_body_string: LBRACE stmt_list_string RBRACE
                | IF LPAREN condition RPAREN LBRACE stmt_list_string RBRACE else_opt_string

case_list_string: CASE case_val COLON stmt_list_string break_opt case_list_string
                |

default_opt_string: DEFAULT COLON stmt_list_string break_opt
                  |

// BOOL control structures
ctrl_struct_bool: IF LPAREN condition RPAREN LBRACE stmt_list_bool RBRACE else_opt_bool
                | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_bool default_opt_bool RBRACE
                | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE stmt_list_bool RBRACE
                | WHILE LPAREN condition RPAREN LBRACE stmt_list_bool RBRACE
                | DO LBRACE stmt_list_bool RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_bool: statement_bool stmt_list_bool
              |

else_opt_bool: ELSE else_body_bool
             |

else_body_bool: LBRACE stmt_list_bool RBRACE
              | IF LPAREN condition RPAREN LBRACE stmt_list_bool RBRACE else_opt_bool

case_list_bool: CASE case_val COLON stmt_list_bool break_opt case_list_bool
              |

default_opt_bool: DEFAULT COLON stmt_list_bool break_opt
                |

// ARRAY control structures
ctrl_struct_array: IF LPAREN condition RPAREN LBRACE stmt_list_array RBRACE else_opt_array
                 | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_array default_opt_array RBRACE
                 | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE stmt_list_array RBRACE
                 | WHILE LPAREN condition RPAREN LBRACE stmt_list_array RBRACE
                 | DO LBRACE stmt_list_array RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_array: statement_array stmt_list_array
               |

else_opt_array: ELSE else_body_array
              |

else_body_array: LBRACE stmt_list_array RBRACE
               | IF LPAREN condition RPAREN LBRACE stmt_list_array RBRACE else_opt_array

case_list_array: CASE case_val COLON stmt_list_array break_opt case_list_array
               |

default_opt_array: DEFAULT COLON stmt_list_array break_opt
                 |

// WEAVE control structures
ctrl_struct_weave: IF LPAREN condition RPAREN LBRACE stmt_list_weave RBRACE else_opt_weave
                 | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_weave default_opt_weave RBRACE
                 | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE stmt_list_weave RBRACE
                 | WHILE LPAREN condition RPAREN LBRACE stmt_list_weave RBRACE
                 | DO LBRACE stmt_list_weave RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_weave: statement_weave stmt_list_weave
               |

else_opt_weave: ELSE else_body_weave
              |

else_body_weave: LBRACE stmt_list_weave RBRACE
               | IF LPAREN condition RPAREN LBRACE stmt_list_weave RBRACE else_opt_weave

case_list_weave: CASE case_val COLON stmt_list_weave break_opt case_list_weave
               |

default_opt_weave: DEFAULT COLON stmt_list_weave break_opt
                 |

// VOID control structures
ctrl_struct_void: IF LPAREN condition RPAREN LBRACE stmt_list_void RBRACE else_opt_void
                | SWITCH LPAREN arg_expr RPAREN LBRACE case_list_void default_opt_void RBRACE
                | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE stmt_list_void RBRACE
                | WHILE LPAREN condition RPAREN LBRACE stmt_list_void RBRACE
                | DO LBRACE stmt_list_void RBRACE WHILE LPAREN condition RPAREN SEMICOLON

stmt_list_void: statement_void stmt_list_void
              |

else_opt_void: ELSE else_body_void
             |

else_body_void: LBRACE stmt_list_void RBRACE
              | IF LPAREN condition RPAREN LBRACE stmt_list_void RBRACE else_opt_void

case_list_void: CASE case_val COLON stmt_list_void break_opt case_list_void
              |

default_opt_void: DEFAULT COLON stmt_list_void break_opt
                |

// ============================================
// TYPE-SPECIFIC RETURN EXPRESSIONS
// ============================================
// Top-level literals and casts restricted to declared return type
// After operators, regular expression rules apply

// INT RETURN EXPRESSION
int_return_expr: int_ret_assign

int_ret_assign: int_ret_concat assign_tail

int_ret_concat: int_ret_or concat_tail

int_ret_or: int_ret_and or_tail

int_ret_and: int_ret_eq and_tail

int_ret_eq: int_ret_rel eq_tail

int_ret_rel: int_ret_add rel_tail

int_ret_add: int_ret_mul add_tail

int_ret_mul: int_ret_unary mul_tail

int_ret_unary: NOT int_ret_unary
             | int_ret_postfix

int_ret_postfix: INTLIT
               | INCR ID
               | DECR ID
               | ID id_postfix
               | LPAREN expression RPAREN postfix_chain
               | INT LPAREN expression RPAREN

// LONG RETURN EXPRESSION
long_return_expr: long_ret_assign

long_ret_assign: long_ret_concat assign_tail

long_ret_concat: long_ret_or concat_tail

long_ret_or: long_ret_and or_tail

long_ret_and: long_ret_eq and_tail

long_ret_eq: long_ret_rel eq_tail

long_ret_rel: long_ret_add rel_tail

long_ret_add: long_ret_mul add_tail

long_ret_mul: long_ret_unary mul_tail

long_ret_unary: NOT long_ret_unary
              | long_ret_postfix

long_ret_postfix: LONGLIT
                | INCR ID
                | DECR ID
                | ID id_postfix
                | LPAREN expression RPAREN postfix_chain
                | LONG LPAREN expression RPAREN

// FLOAT RETURN EXPRESSION
float_return_expr: float_ret_assign

float_ret_assign: float_ret_concat assign_tail

float_ret_concat: float_ret_or concat_tail

float_ret_or: float_ret_and or_tail

float_ret_and: float_ret_eq and_tail

float_ret_eq: float_ret_rel eq_tail

float_ret_rel: float_ret_add rel_tail

float_ret_add: float_ret_mul add_tail

float_ret_mul: float_ret_unary mul_tail

float_ret_unary: NOT float_ret_unary
               | float_ret_postfix

float_ret_postfix: FLOATLIT
                 | INCR ID
                 | DECR ID
                 | ID id_postfix
                 | LPAREN expression RPAREN postfix_chain
                 | FLOAT LPAREN expression RPAREN

// DOUBLE RETURN EXPRESSION
double_return_expr: double_ret_assign

double_ret_assign: double_ret_concat assign_tail

double_ret_concat: double_ret_or concat_tail

double_ret_or: double_ret_and or_tail

double_ret_and: double_ret_eq and_tail

double_ret_eq: double_ret_rel eq_tail

double_ret_rel: double_ret_add rel_tail

double_ret_add: double_ret_mul add_tail

double_ret_mul: double_ret_unary mul_tail

double_ret_unary: NOT double_ret_unary
                | double_ret_postfix

double_ret_postfix: DOUBLELIT
                  | INCR ID
                  | DECR ID
                  | ID id_postfix
                  | LPAREN expression RPAREN postfix_chain
                  | DOUBLE LPAREN expression RPAREN

// CHAR RETURN EXPRESSION
char_return_expr: char_ret_assign

char_ret_assign: char_ret_concat assign_tail

char_ret_concat: char_ret_or concat_tail

char_ret_or: char_ret_and or_tail

char_ret_and: char_ret_eq and_tail

char_ret_eq: char_ret_rel eq_tail

char_ret_rel: char_ret_add rel_tail

char_ret_add: char_ret_mul add_tail

char_ret_mul: char_ret_unary mul_tail

char_ret_unary: NOT char_ret_unary
              | char_ret_postfix

char_ret_postfix: CHARLIT
                | INCR ID
                | DECR ID
                | ID id_postfix
                | LPAREN expression RPAREN postfix_chain
                | CHAR LPAREN expression RPAREN

// STRING RETURN EXPRESSION
string_return_expr: string_ret_assign

string_ret_assign: string_ret_concat assign_tail

string_ret_concat: string_ret_or concat_tail

string_ret_or: string_ret_and or_tail

string_ret_and: string_ret_eq and_tail

string_ret_eq: string_ret_rel eq_tail

string_ret_rel: string_ret_add rel_tail

string_ret_add: string_ret_mul add_tail

string_ret_mul: string_ret_unary mul_tail

string_ret_unary: NOT string_ret_unary
                | string_ret_postfix

string_ret_postfix: STRINGLIT
                  | INCR ID
                  | DECR ID
                  | ID id_postfix
                  | LPAREN expression RPAREN postfix_chain
                  | STRING LPAREN expression RPAREN

// BOOL RETURN EXPRESSION
bool_return_expr: bool_ret_assign

bool_ret_assign: bool_ret_concat assign_tail

bool_ret_concat: bool_ret_or concat_tail

bool_ret_or: bool_ret_and or_tail

bool_ret_and: bool_ret_eq and_tail

bool_ret_eq: bool_ret_rel eq_tail

bool_ret_rel: bool_ret_add rel_tail

bool_ret_add: bool_ret_mul add_tail

bool_ret_mul: bool_ret_unary mul_tail

bool_ret_unary: NOT bool_ret_unary
              | bool_ret_postfix

bool_ret_postfix: TRUE
                | FALSE
                | INCR ID
                | DECR ID
                | ID id_postfix
                | LPAREN expression RPAREN postfix_chain
                | BOOL LPAREN expression RPAREN

// ============================================
// USING BLOCK
// ============================================

using_cont: COMMA ID using_cont
          |

// ============================================
// LOCAL DECLARATIONS
// ============================================
// Type-specific local declaration tails - no expressions allowed
// Each type accepts ONLY its matching literal type

local_dec_body: INT ID int_local_tail
              | LONG ID long_local_tail
              | FLOAT ID float_local_tail
              | DOUBLE ID double_local_tail
              | CHAR ID char_local_tail
              | STRING ID string_local_tail
              | BOOL ID bool_local_tail
              | ID ID weave_local_tail

// INT local declarations
int_local_tail: int_array_with_init SEMICOLON
              | ASSIGN INTLIT int_local_cont SEMICOLON

int_local_cont: COMMA ID ASSIGN INTLIT int_local_cont
              |

// LONG local declarations
long_local_tail: long_array_with_init SEMICOLON
               | ASSIGN LONGLIT long_local_cont SEMICOLON

long_local_cont: COMMA ID ASSIGN LONGLIT long_local_cont
               |

// FLOAT local declarations
float_local_tail: float_array_with_init SEMICOLON
                | ASSIGN FLOATLIT float_local_cont SEMICOLON

float_local_cont: COMMA ID ASSIGN FLOATLIT float_local_cont
                |

// DOUBLE local declarations
double_local_tail: double_array_with_init SEMICOLON
                 | ASSIGN DOUBLELIT double_local_cont SEMICOLON

double_local_cont: COMMA ID ASSIGN DOUBLELIT double_local_cont
                 |

// CHAR local declarations
char_local_tail: char_array_with_init SEMICOLON
               | ASSIGN CHARLIT char_local_cont SEMICOLON

char_local_cont: COMMA ID ASSIGN CHARLIT char_local_cont
               |

// STRING local declarations
string_local_tail: string_array_with_init SEMICOLON
                 | ASSIGN STRINGLIT string_local_cont SEMICOLON

string_local_cont: COMMA ID ASSIGN STRINGLIT string_local_cont
                 |

// BOOL local declarations
bool_local_tail: bool_array_with_init SEMICOLON
               | ASSIGN bool_lit bool_local_cont SEMICOLON

bool_local_cont: COMMA ID ASSIGN bool_lit bool_local_cont
               |

// Weave (struct) local declarations - literal field values only
weave_local_tail: ASSIGN LBRACE weave_field_value weave_field_list_tail RBRACE weave_inst_cont SEMICOLON
                | weave_array_with_init weave_arr_cont SEMICOLON

// ============================================
// STATEMENTS (for main function only)
// ============================================
// statement_non_return is used ONLY in main function and its control structures
// All other functions use type-specific statement rules (statement_int, etc.)

statement_non_return: effect_stmt SEMICOLON
                    | io_stmt
                    | ctrl_struct
                    | BREAK SEMICOLON

// ============================================
// UNIFIED EXPRESSION GRAMMAR
// ============================================

expression: assign_expr

assign_expr: concat_expr assign_tail

assign_tail: assign_op assign_expr
           |

assign_op: ASSIGN
         | PLUSEQ
         | MINUSEQ
         | STAREQ
         | SLASHEQ
         | MODEQ

concat_expr: or_expr concat_tail

concat_tail: CONCAT or_expr concat_tail
           |

// ============================================
// BOOLEAN / LOGICAL EXPRESSIONS
// ============================================

or_expr: and_expr or_tail

or_tail: OR and_expr or_tail
       |

and_expr: eq_expr and_tail

and_tail: AND eq_expr and_tail
        |

eq_expr: rel_expr eq_tail

eq_tail: EQ rel_expr eq_tail
       | NEQ rel_expr eq_tail
       |

rel_expr: add_expr rel_tail

rel_tail: LT add_expr
        | GT add_expr
        | LTE add_expr
        | GTE add_expr
        |

// ============================================
// ARITHMETIC EXPRESSIONS
// ============================================

add_expr: mul_expr add_tail

add_tail: PLUS mul_expr add_tail
        | MINUS mul_expr add_tail
        |

mul_expr: unary_expr mul_tail

mul_tail: STAR unary_expr mul_tail
        | SLASH unary_expr mul_tail
        | MOD unary_expr mul_tail
        |

unary_expr: NOT unary_expr
          | postfix_expr

// ============================================
// POSTFIX EXPRESSIONS
// ============================================
// Increment/decrement constrained to C-like semantics:
// - ++id, --id, id++, id-- are the ONLY valid forms
// - Operand must be bare identifier (not expression, not parenthesized)
// - No chaining: ++id++, ++++id are syntactically impossible

postfix_expr: LPAREN expression RPAREN postfix_chain
            | INT LPAREN expression RPAREN
            | LONG LPAREN expression RPAREN
            | FLOAT LPAREN expression RPAREN
            | DOUBLE LPAREN expression RPAREN
            | CHAR LPAREN expression RPAREN
            | STRING LPAREN expression RPAREN
            | BOOL LPAREN expression RPAREN
            | INCR ID
            | DECR ID
            | ID id_postfix
            | INTLIT
            | LONGLIT
            | FLOATLIT
            | DOUBLELIT
            | CHARLIT
            | STRINGLIT
            | TRUE
            | FALSE

// ============================================
// IDENTIFIER POSTFIX (C-LIKE INCREMENT/DECREMENT)
// ============================================
// After bare ID: either terminal inc/dec OR regular postfix chain
// This ensures ++id and id++ are valid but ++id++ is not

id_postfix: INCR
          | DECR
          | postfix_chain

// ============================================
// POSTFIX CHAIN (NO INCREMENT/DECREMENT)
// ============================================
// Array access, field access, function calls - NO inc/dec allowed here
// Inc/dec only valid on bare identifiers (handled by id_postfix)

postfix_chain: array_access postfix_after_arr
             | DOT ID postfix_chain
             | LPAREN arg_list RPAREN postfix_chain
             |

array_access: LBRACK array_index RBRACK array_access_dim2

array_access_dim2: LBRACK array_index RBRACK
                 |

postfix_after_arr: DOT ID postfix_chain
                 | LPAREN arg_list RPAREN postfix_chain
                 |

array_index: INTLIT
           | ID

arg_list: arg_expr arg_tail
        |

arg_tail: COMMA arg_expr arg_tail
        |

// ============================================
// EFFECTFUL STATEMENT (SIDE-EFFECT REQUIREMENT)
// ============================================
// effect_stmt replaces stmt_expr in statement position
// Only allows constructs with side effects: assignment, ++/--, function calls
// Rejects: bare id;  arr[i];  obj.field;  literals;  pure expressions
// This is enforced purely in CFG - no semantic filtering

effect_stmt: INCR ID effect_pre_chain          // ++lvalue
           | DECR ID effect_pre_chain          // --lvalue
           | ID effect_id_cont                 // id must lead to effect

// After ++ID or --ID: optional lvalue extension (already effectful)
effect_pre_chain: LBRACK stmt_array_index RBRACK effect_pre_arr_chain
                | DOT ID effect_pre_chain
                |

effect_pre_arr_chain: LBRACK stmt_array_index RBRACK
                    | DOT ID effect_pre_chain
                    |

// After ID: MUST have effectful operation (no epsilon!)
effect_id_cont: assign_op stmt_assign_expr                      // id = expr (assignment)
              | INCR                                             // id++ (post-increment)
              | DECR                                             // id-- (post-decrement)
              | LPAREN stmt_arg_list RPAREN effect_post_call    // id() (function call)
              | LBRACK stmt_array_index RBRACK effect_post_arr  // id[i]... (array, must lead to effect)
              | DOT ID effect_post_member                        // id.f... (field, must lead to effect)

// After function call: already effectful, allow any postfix chain
effect_post_call: DOT ID effect_post_call_member
                | LBRACK stmt_array_index RBRACK effect_post_call_arr
                |

effect_post_call_member: LPAREN stmt_arg_list RPAREN effect_post_call
                       | LBRACK stmt_array_index RBRACK effect_post_call_arr
                       | DOT ID effect_post_call_member
                       |

effect_post_call_arr: LBRACK stmt_array_index RBRACK effect_post_call_arr_cont
                    | effect_post_call_arr_cont

effect_post_call_arr_cont: DOT ID effect_post_call_member
                         | LPAREN stmt_arg_list RPAREN effect_post_call
                         |

// After array access on id: MUST lead to effect
effect_post_arr: LBRACK stmt_array_index RBRACK effect_post_arr_2d  // 2D array
               | effect_arr_effect                                   // 1D array, need effect

effect_post_arr_2d: effect_arr_effect                               // after 2D, need effect

effect_arr_effect: assign_op stmt_assign_expr
                 | INCR
                 | DECR
                 | LPAREN stmt_arg_list RPAREN effect_post_call
                 | DOT ID effect_post_member

// After field access on id: MUST lead to effect
effect_post_member: assign_op stmt_assign_expr
                  | INCR
                  | DECR
                  | LPAREN stmt_arg_list RPAREN effect_post_call
                  | LBRACK stmt_array_index RBRACK effect_post_arr
                  | DOT ID effect_post_member

// ============================================
// STATEMENT EXPRESSION RULES (ISOLATED FOLLOW SET)
// ============================================
// These rules isolate FOLLOW set to {;} for statement contexts
// Used by effect_stmt for RHS expressions (after assignment operators)
// Error messages will correctly show: operators, ; (not , ) from arg contexts)

stmt_assign_expr: stmt_concat_expr stmt_assign_tail

stmt_assign_tail: assign_op stmt_assign_expr
                |

stmt_concat_expr: stmt_or_expr stmt_concat_tail

stmt_concat_tail: CONCAT stmt_or_expr stmt_concat_tail
                |

stmt_or_expr: stmt_and_expr stmt_or_tail

stmt_or_tail: OR stmt_and_expr stmt_or_tail
            |

stmt_and_expr: stmt_eq_expr stmt_and_tail

stmt_and_tail: AND stmt_eq_expr stmt_and_tail
             |

stmt_eq_expr: stmt_rel_expr stmt_eq_tail

stmt_eq_tail: EQ stmt_rel_expr stmt_eq_tail
            | NEQ stmt_rel_expr stmt_eq_tail
            |

stmt_rel_expr: stmt_add_expr stmt_rel_tail

stmt_rel_tail: LT stmt_add_expr
             | GT stmt_add_expr
             | LTE stmt_add_expr
             | GTE stmt_add_expr
             |

stmt_add_expr: stmt_mul_expr stmt_add_tail

stmt_add_tail: PLUS stmt_mul_expr stmt_add_tail
             | MINUS stmt_mul_expr stmt_add_tail
             |

stmt_mul_expr: stmt_unary_expr stmt_mul_tail

stmt_mul_tail: STAR stmt_unary_expr stmt_mul_tail
             | SLASH stmt_unary_expr stmt_mul_tail
             | MOD stmt_unary_expr stmt_mul_tail
             |

stmt_unary_expr: NOT stmt_unary_expr
               | MINUS stmt_unary_expr
               | stmt_postfix_expr

stmt_postfix_expr: LPAREN arg_expr RPAREN stmt_postfix_chain
                 | INT LPAREN arg_expr RPAREN
                 | LONG LPAREN arg_expr RPAREN
                 | FLOAT LPAREN arg_expr RPAREN
                 | DOUBLE LPAREN arg_expr RPAREN
                 | CHAR LPAREN arg_expr RPAREN
                 | STRING LPAREN arg_expr RPAREN
                 | BOOL LPAREN arg_expr RPAREN
                 | INCR ID
                 | DECR ID
                 | ID stmt_id_postfix
                 | INTLIT
                 | LONGLIT
                 | FLOATLIT
                 | DOUBLELIT
                 | CHARLIT
                 | STRINGLIT
                 | TRUE
                 | FALSE

stmt_id_postfix: INCR
               | DECR
               | stmt_postfix_chain

stmt_postfix_chain: stmt_array_access stmt_postfix_after_arr
                  | DOT ID stmt_postfix_chain
                  | LPAREN stmt_arg_list RPAREN stmt_postfix_chain
                  |

stmt_array_access: LBRACK stmt_array_index RBRACK stmt_array_access_dim2

stmt_array_access_dim2: LBRACK stmt_array_index RBRACK
                      |

stmt_postfix_after_arr: DOT ID stmt_postfix_chain
                      | LPAREN stmt_arg_list RPAREN stmt_postfix_chain
                      |

stmt_array_index: INTLIT
                | ID

// Argument list within stmt_expr context uses arg_expr for clean FOLLOW
stmt_arg_list: arg_expr stmt_arg_tail
             |

stmt_arg_tail: COMMA arg_expr stmt_arg_tail
             |

// ============================================
// ARGUMENT EXPRESSION (ISOLATED FOLLOW SET)
// ============================================
// arg_expr is used where expression is in argument position (followed by , or ))
// Isolates FOLLOW set so expected tokens don't include ; from statement context
// Error messages will correctly show: operators, , )

arg_expr: arg_assign_expr

arg_assign_expr: arg_concat_expr arg_assign_tail

arg_assign_tail: assign_op arg_assign_expr
               |

arg_concat_expr: arg_or_expr arg_concat_tail

arg_concat_tail: CONCAT arg_or_expr arg_concat_tail
               |

arg_or_expr: arg_and_expr arg_or_tail

arg_or_tail: OR arg_and_expr arg_or_tail
           |

arg_and_expr: arg_eq_expr arg_and_tail

arg_and_tail: AND arg_eq_expr arg_and_tail
            |

arg_eq_expr: arg_rel_expr arg_eq_tail

arg_eq_tail: EQ arg_rel_expr arg_eq_tail
           | NEQ arg_rel_expr arg_eq_tail
           |

arg_rel_expr: arg_add_expr arg_rel_tail

arg_rel_tail: LT arg_add_expr
            | GT arg_add_expr
            | LTE arg_add_expr
            | GTE arg_add_expr
            |

arg_add_expr: arg_mul_expr arg_add_tail

arg_add_tail: PLUS arg_mul_expr arg_add_tail
            | MINUS arg_mul_expr arg_add_tail
            |

arg_mul_expr: arg_unary_expr arg_mul_tail

arg_mul_tail: STAR arg_unary_expr arg_mul_tail
            | SLASH arg_unary_expr arg_mul_tail
            | MOD arg_unary_expr arg_mul_tail
            |

arg_unary_expr: NOT arg_unary_expr
              | MINUS arg_unary_expr
              | arg_postfix_expr

arg_postfix_expr: LPAREN arg_expr RPAREN arg_postfix_chain
                | INT LPAREN arg_expr RPAREN
                | LONG LPAREN arg_expr RPAREN
                | FLOAT LPAREN arg_expr RPAREN
                | DOUBLE LPAREN arg_expr RPAREN
                | CHAR LPAREN arg_expr RPAREN
                | STRING LPAREN arg_expr RPAREN
                | BOOL LPAREN arg_expr RPAREN
                | INCR ID
                | DECR ID
                | ID arg_id_postfix
                | INTLIT
                | LONGLIT
                | FLOATLIT
                | DOUBLELIT
                | CHARLIT
                | STRINGLIT
                | TRUE
                | FALSE

arg_id_postfix: INCR
              | DECR
              | arg_postfix_chain

arg_postfix_chain: arg_array_access arg_postfix_after_arr
                 | DOT ID arg_postfix_chain
                 | LPAREN arg_nested_list RPAREN arg_postfix_chain
                 |

arg_array_access: LBRACK arg_array_index RBRACK arg_array_access_dim2

arg_array_access_dim2: LBRACK arg_array_index RBRACK
                     |

arg_postfix_after_arr: DOT ID arg_postfix_chain
                     | LPAREN arg_nested_list RPAREN arg_postfix_chain
                     |

arg_array_index: INTLIT
               | ID

// Nested argument list within arg_expr (for function calls inside arguments)
arg_nested_list: arg_expr arg_nested_tail
               |

arg_nested_tail: COMMA arg_expr arg_nested_tail
               |

// ============================================
// I/O STATEMENTS
// ============================================

io_stmt: TRAP LPAREN arg_expr RPAREN SEMICOLON
       | THREAD LPAREN print_args RPAREN SEMICOLON
       | THREADLN LPAREN print_args RPAREN SEMICOLON

print_args: arg_expr print_tail

print_tail: COMMA arg_expr print_tail
          |

// ============================================
// CONTROL STRUCTURES (for main function only)
// ============================================
// These control structure rules are used ONLY in main function
// All other functions use type-specific control structures (ctrl_struct_int, etc.)

ctrl_struct: IF LPAREN condition RPAREN LBRACE ctrl_stmt_list RBRACE else_opt
           | SWITCH LPAREN arg_expr RPAREN LBRACE case_list default_opt RBRACE
           | FOR LPAREN for_init SEMICOLON for_cond SEMICOLON for_update RPAREN LBRACE ctrl_stmt_list RBRACE
           | WHILE LPAREN condition RPAREN LBRACE ctrl_stmt_list RBRACE
           | DO LBRACE ctrl_stmt_list RBRACE WHILE LPAREN condition RPAREN SEMICOLON

// Statement list for control structures in main function only
ctrl_stmt_list: statement_non_return ctrl_stmt_list
              |

else_opt: ELSE else_body
        |

else_body: LBRACE ctrl_stmt_list RBRACE
         | IF LPAREN condition RPAREN LBRACE ctrl_stmt_list RBRACE else_opt

case_list: CASE case_val COLON ctrl_stmt_list break_opt case_list
         |

case_val: INTLIT
        | LONGLIT
        | CHARLIT
        | TRUE
        | FALSE

default_opt: DEFAULT COLON ctrl_stmt_list break_opt
           |

break_opt: BREAK SEMICOLON
         |

for_init: LOCAL VAR for_init_type ID ASSIGN for_init_expr
        | ID for_init_assign_tail
        |

for_init_assign_tail: assign_op for_init_expr

// Restricted expression for for_init: no assignment chaining
// Uses stmt_concat_expr since for_init is followed by SEMICOLON
for_init_expr: stmt_concat_expr

for_init_type: INT
             | LONG
             | FLOAT
             | DOUBLE
             | CHAR
             | STRING
             | BOOL

for_cond: condition

// ============================================
// CONDITION EXPRESSIONS (STRICT BOOLEAN DISCIPLINE)
// ============================================
// Complete redesign for strict boolean enforcement:
// - ONLY boolean-producing constructs allowed
// - Relational expressions ALWAYS require comparison operator
// - Arithmetic expressions FORBIDDEN without comparison
// - Type casts FORBIDDEN without comparison
// - Numeric literals FORBIDDEN standalone
//
// Allowed:
// - Boolean identifiers: if (x)
// - Boolean literals: if (true), if (false)
// - Relational expressions: if (x < 5), if (a == b)
// - Logical combinations: if (x && y), if (a || b)
// - Negation: if (!x), if (!(a < b))
// - Nested parentheses: if ((a && b) || c)
//
// Disallowed:
// - Standalone numeric literals: if (2), if (3.14)
// - Standalone arithmetic: if (x + 5), if (a * b)
// - Arithmetic in logical without comparison: if (x && 2)
// - Type casts without comparison: if (int(5))

condition: bool_or

bool_or: bool_and bool_or_tail
bool_or_tail: OR bool_and bool_or_tail
            |

bool_and: bool_not bool_and_tail
bool_and_tail: AND bool_not bool_and_tail
             |

bool_not: NOT bool_not
        | bool_primary

// bool_primary: Only boolean-producing constructs
// - true/false literals
// - Identifiers (semantic verifies bool type)
// - Parenthesized conditions (recursive boolean context)
// - Relational expressions (comparison required)
bool_primary: TRUE
            | FALSE
            | ID bool_id_options
            | LPAREN bool_paren_complete
            | relational_lhs_no_id relational_op_and_rhs

// Parenthesized condition - handles RPAREN internally
// Some paths (ID+arith with outside compare) consume RPAREN themselves
bool_paren_complete: paren_outer_start_complete

// After ID in condition: dispatch based on what follows
// - If ++/-- appears: comparison is REQUIRED (no standalone postincrement/decrement)
// - If only [, ., () appear (no ++/--): can standalone or compare
// - If comparison op: comparison
// - If nothing: standalone ID (semantic checks bool type)
// FIX: Prevents for(; j++; ) from being accepted - ++/-- must have comparison
bool_id_options: INCR bool_must_compare_cont
               | DECR bool_must_compare_cont
               | LBRACK arg_expr RBRACK bool_after_bracket
               | DOT ID bool_id_options
               | LPAREN arg_list RPAREN bool_id_options
               | relational_op_and_rhs
               |

// After [expr] - decide path based on next token
bool_after_bracket: LBRACK arg_expr RBRACK bool_after_2d_bracket
                  | INCR bool_must_compare_cont
                  | DECR bool_must_compare_cont
                  | DOT ID bool_id_options
                  | LPAREN arg_list RPAREN bool_id_options
                  | relational_op_and_rhs
                  |

// After [expr][expr] - 2D array access complete
bool_after_2d_bracket: INCR bool_must_compare_cont
                     | DECR bool_must_compare_cont
                     | DOT ID bool_id_options
                     | LPAREN arg_list RPAREN bool_id_options
                     | relational_op_and_rhs
                     |

// After ++/--, comparison is REQUIRED (no epsilon - enforces the fix)
// May have additional postfix after ++/-- (e.g., id++.field, id++[i])
bool_must_compare_cont: LBRACK arg_expr RBRACK bool_must_compare_after_bracket
                      | DOT ID bool_must_compare_cont
                      | LPAREN arg_list RPAREN bool_must_compare_cont
                      | relational_op_and_rhs

// After [expr] when comparison required - check for 2D or continue
bool_must_compare_after_bracket: LBRACK arg_expr RBRACK bool_must_compare_after_2d
                               | DOT ID bool_must_compare_cont
                               | LPAREN arg_list RPAREN bool_must_compare_cont
                               | relational_op_and_rhs

// After [expr][expr] when comparison required - no more array dims
bool_must_compare_after_2d: DOT ID bool_must_compare_cont
                          | LPAREN arg_list RPAREN bool_must_compare_cont
                          | relational_op_and_rhs

// ID postfix: field access, array subscript, function call, increment/decrement
// NOTE: Used by parenthesized condition rules (paren_outer_id_complete, paren_inner_*)
bool_id_postfix: INCR
               | DECR
               | LBRACK arg_expr RBRACK bool_id_arr_dim2
               | DOT ID bool_id_postfix
               | LPAREN arg_list RPAREN bool_id_postfix
               |

bool_id_arr_dim2: LBRACK arg_expr RBRACK
                |

// ============================================
// PARENTHESIZED CONDITION CONTENT (STRICT)
// ============================================
// Strict parsing for paren content:
// - TRUE/FALSE/!expr: pure boolean, can terminate
// - ID: can terminate (semantic validates) OR arithmetic with deferred comparison
// - Literal/cast: MUST have comparison inside (no deferral)
// - Nested parens: NO deferral - comparison must be inside if arithmetic present
//
// Valid: (x), (x && y), (x < 5), (x + 5 > 10), (x + 5) > 10, ((x)), ((x < 5))
// Invalid: (3), (3 + 2), ((x + 5)), (x + 5) without comparison

// Outer paren content - handles RPAREN and possible outside comparison
// All paths consume RPAREN internally
paren_outer_start_complete: TRUE paren_bool_tail RPAREN paren_outside_opt
                          | FALSE paren_bool_tail RPAREN paren_outside_opt
                          | NOT bool_not paren_bool_tail RPAREN paren_outside_opt
                          | ID paren_outer_id_complete
                          | LPAREN paren_inner_content RPAREN paren_after_nested_outer RPAREN paren_outside_opt
                          | paren_arith_lhs paren_must_compare_inside RPAREN paren_outside_opt

// Optional outside comparison for committed content (pure boolean or relational)
paren_outside_opt: relational_continue_ops
                 |

// After TRUE/FALSE/!expr - can continue with logical or end
paren_bool_tail: OR bool_and bool_or_tail
               | AND bool_not bool_and_tail
               |

// After ID in outer paren - dispatch based on postfix
// FIX: ++/-- paths MUST compare (no bare RPAREN option)
paren_outer_id_complete: INCR paren_outer_must_compare_cont
                       | DECR paren_outer_must_compare_cont
                       | LBRACK arg_expr RBRACK paren_outer_after_bracket
                       | DOT ID paren_outer_id_complete
                       | LPAREN arg_list RPAREN paren_outer_id_complete
                       | paren_outer_id_after_plain

// After plain ID (no ++/--) - can terminate or compare
paren_outer_id_after_plain: OR bool_and bool_or_tail RPAREN paren_outside_opt
                          | AND bool_not bool_and_tail RPAREN paren_outside_opt
                          | comp_op arg_add_expr paren_rel_tail RPAREN paren_outside_opt
                          | paren_id_arith_path
                          | RPAREN paren_outside_opt

// After [expr] in outer paren - decide path
paren_outer_after_bracket: LBRACK arg_expr RBRACK paren_outer_after_2d_bracket
                         | INCR paren_outer_must_compare_cont
                         | DECR paren_outer_must_compare_cont
                         | DOT ID paren_outer_id_complete
                         | LPAREN arg_list RPAREN paren_outer_id_complete
                         | paren_outer_id_after_plain

// After [expr][expr] in outer paren
paren_outer_after_2d_bracket: INCR paren_outer_must_compare_cont
                            | DECR paren_outer_must_compare_cont
                            | DOT ID paren_outer_id_complete
                            | LPAREN arg_list RPAREN paren_outer_id_complete
                            | paren_outer_id_after_plain

// After ++/-- in outer paren, comparison REQUIRED - no bare RPAREN
paren_outer_must_compare_cont: LBRACK arg_expr RBRACK paren_outer_must_compare_after_bracket
                             | DOT ID paren_outer_must_compare_cont
                             | LPAREN arg_list RPAREN paren_outer_must_compare_cont
                             | comp_op arg_add_expr paren_rel_tail RPAREN paren_outside_opt
                             | paren_id_arith_path

// After [expr] when comparison required in outer paren
paren_outer_must_compare_after_bracket: LBRACK arg_expr RBRACK paren_outer_must_compare_after_2d
                                      | DOT ID paren_outer_must_compare_cont
                                      | LPAREN arg_list RPAREN paren_outer_must_compare_cont
                                      | comp_op arg_add_expr paren_rel_tail RPAREN paren_outside_opt
                                      | paren_id_arith_path

// After [expr][expr] when comparison required in outer paren
paren_outer_must_compare_after_2d: DOT ID paren_outer_must_compare_cont
                                 | LPAREN arg_list RPAREN paren_outer_must_compare_cont
                                 | comp_op arg_add_expr paren_rel_tail RPAREN paren_outside_opt
                                 | paren_id_arith_path

// ID + arithmetic - comparison REQUIRED (inside paren OR outside paren)
// NO path allows termination without comparison
paren_id_arith_path: PLUS relational_unary relational_arith_tail paren_arith_ending
                   | MINUS relational_unary relational_arith_tail paren_arith_ending
                   | STAR relational_unary relational_arith_tail paren_arith_ending
                   | SLASH relational_unary relational_arith_tail paren_arith_ending
                   | MOD relational_unary relational_arith_tail paren_arith_ending

// After arithmetic in paren: comparison INSIDE or close and compare OUTSIDE
// Both paths require comparison - NO bare termination allowed
// Both paths consume RPAREN
paren_arith_ending: comp_op arg_add_expr paren_rel_tail RPAREN paren_outside_opt
                  | RPAREN relational_continue_ops

// After nested parens at outer level - arithmetic must compare, boolean can end
paren_after_nested_outer: OR bool_and bool_or_tail
                        | AND bool_not bool_and_tail
                        | comp_op arg_add_expr paren_rel_tail
                        | paren_nested_arith_must_compare
                        |

// Arithmetic after nested parens - comparison REQUIRED (no defer from nested)
paren_nested_arith_must_compare: PLUS relational_unary relational_arith_tail comp_op arg_add_expr paren_rel_tail
                               | MINUS relational_unary relational_arith_tail comp_op arg_add_expr paren_rel_tail
                               | STAR relational_unary relational_arith_tail comp_op arg_add_expr paren_rel_tail
                               | SLASH relational_unary relational_arith_tail comp_op arg_add_expr paren_rel_tail
                               | MOD relational_unary relational_arith_tail comp_op arg_add_expr paren_rel_tail

// ============================================
// INNER PAREN CONTENT (NO DEFERRAL)
// ============================================
// Used for nested parens - NO deferred comparison allowed
// Arithmetic MUST have comparison inside

paren_inner_content: paren_inner_start

paren_inner_start: TRUE paren_bool_tail
                 | FALSE paren_bool_tail
                 | NOT paren_inner_not paren_bool_tail
                 | ID paren_inner_id_path
                 | LPAREN paren_inner_content RPAREN paren_after_nested_inner
                 | paren_arith_lhs paren_must_compare_inside

// NOT in inner paren context
paren_inner_not: NOT paren_inner_not
               | paren_inner_primary

paren_inner_primary: TRUE
                   | FALSE
                   | ID paren_inner_id_options_simple
                   | LPAREN paren_inner_content RPAREN

// After ID in inner primary - dispatch based on postfix
// FIX: ++/-- paths have no epsilon (comparison required eventually)
paren_inner_id_options_simple: INCR paren_inner_must_compare_cont_simple
                             | DECR paren_inner_must_compare_cont_simple
                             | LBRACK arg_expr RBRACK paren_inner_after_bracket_simple
                             | DOT ID paren_inner_id_options_simple
                             | LPAREN arg_list RPAREN paren_inner_id_options_simple
                             |

paren_inner_after_bracket_simple: LBRACK arg_expr RBRACK paren_inner_after_2d_simple
                                | INCR paren_inner_must_compare_cont_simple
                                | DECR paren_inner_must_compare_cont_simple
                                | DOT ID paren_inner_id_options_simple
                                | LPAREN arg_list RPAREN paren_inner_id_options_simple
                                |

paren_inner_after_2d_simple: INCR paren_inner_must_compare_cont_simple
                           | DECR paren_inner_must_compare_cont_simple
                           | DOT ID paren_inner_id_options_simple
                           | LPAREN arg_list RPAREN paren_inner_id_options_simple
                           |

// After ++/-- in inner simple - must eventually compare (no epsilon here)
paren_inner_must_compare_cont_simple: LBRACK arg_expr RBRACK paren_inner_must_compare_cont_simple
                                    | DOT ID paren_inner_must_compare_cont_simple
                                    | LPAREN arg_list RPAREN paren_inner_must_compare_cont_simple
                                    | comp_op arg_add_expr

// After ID in inner paren - dispatch based on postfix
// FIX: ++/-- paths MUST compare (no bare epsilon)
paren_inner_id_path: INCR paren_inner_must_compare_cont
                   | DECR paren_inner_must_compare_cont
                   | LBRACK arg_expr RBRACK paren_inner_after_bracket
                   | DOT ID paren_inner_id_path
                   | LPAREN arg_list RPAREN paren_inner_id_path
                   | paren_inner_id_after_plain

// After plain ID (no ++/--) in inner paren - can terminate or compare
paren_inner_id_after_plain: OR paren_inner_and paren_inner_or_tail
                          | AND paren_inner_not paren_inner_and_tail
                          | comp_op arg_add_expr paren_rel_tail
                          | paren_id_arith_must_compare
                          |

// After [expr] in inner paren - decide path
paren_inner_after_bracket: LBRACK arg_expr RBRACK paren_inner_after_2d_bracket
                         | INCR paren_inner_must_compare_cont
                         | DECR paren_inner_must_compare_cont
                         | DOT ID paren_inner_id_path
                         | LPAREN arg_list RPAREN paren_inner_id_path
                         | paren_inner_id_after_plain

// After [expr][expr] in inner paren
paren_inner_after_2d_bracket: INCR paren_inner_must_compare_cont
                            | DECR paren_inner_must_compare_cont
                            | DOT ID paren_inner_id_path
                            | LPAREN arg_list RPAREN paren_inner_id_path
                            | paren_inner_id_after_plain

// After ++/-- in inner paren, comparison REQUIRED - no epsilon
paren_inner_must_compare_cont: LBRACK arg_expr RBRACK paren_inner_must_compare_after_bracket
                             | DOT ID paren_inner_must_compare_cont
                             | LPAREN arg_list RPAREN paren_inner_must_compare_cont
                             | comp_op arg_add_expr paren_rel_tail
                             | paren_id_arith_must_compare

// After [expr] when comparison required in inner paren
paren_inner_must_compare_after_bracket: LBRACK arg_expr RBRACK paren_inner_must_compare_after_2d
                                      | DOT ID paren_inner_must_compare_cont
                                      | LPAREN arg_list RPAREN paren_inner_must_compare_cont
                                      | comp_op arg_add_expr paren_rel_tail
                                      | paren_id_arith_must_compare

// After [expr][expr] when comparison required in inner paren
paren_inner_must_compare_after_2d: DOT ID paren_inner_must_compare_cont
                                 | LPAREN arg_list RPAREN paren_inner_must_compare_cont
                                 | comp_op arg_add_expr paren_rel_tail
                                 | paren_id_arith_must_compare

// Inner paren logical continuations
paren_inner_or_tail: OR paren_inner_and paren_inner_or_tail
                   |

paren_inner_and: paren_inner_not paren_inner_and_tail

paren_inner_and_tail: AND paren_inner_not paren_inner_and_tail
                    |

// ID + arithmetic in inner paren - comparison REQUIRED (no defer)
paren_id_arith_must_compare: PLUS relational_unary relational_arith_tail comp_op arg_add_expr paren_rel_tail
                           | MINUS relational_unary relational_arith_tail comp_op arg_add_expr paren_rel_tail
                           | STAR relational_unary relational_arith_tail comp_op arg_add_expr paren_rel_tail
                           | SLASH relational_unary relational_arith_tail comp_op arg_add_expr paren_rel_tail
                           | MOD relational_unary relational_arith_tail comp_op arg_add_expr paren_rel_tail

// After nested parens in inner context - same rules, no defer
paren_after_nested_inner: OR paren_inner_and paren_inner_or_tail
                        | AND paren_inner_not paren_inner_and_tail
                        | comp_op arg_add_expr paren_rel_tail
                        | paren_nested_arith_must_compare
                        |

// ============================================
// ARITHMETIC LHS (MUST COMPARE)
// ============================================
// Literal/cast/unary-minus/prefix-incr-decr starters
// These ALWAYS require comparison - no deferral

paren_arith_lhs: MINUS relational_unary relational_arith_tail
               | INCR ID relational_id_postfix_opt relational_arith_tail
               | DECR ID relational_id_postfix_opt relational_arith_tail
               | relational_literal relational_arith_tail
               | relational_cast relational_arith_tail

// Must have comparison inside paren (NO epsilon)
paren_must_compare_inside: comp_op arg_add_expr paren_rel_tail

// After relational in paren - can continue with logical or end
paren_rel_tail: OR bool_and bool_or_tail
              | AND bool_not bool_and_tail
              |

// Relational expression left-hand side (excludes ID which is handled separately)
// These MUST be followed by comparison operator
relational_lhs_no_id: MINUS relational_unary
                    | INCR ID relational_id_postfix_opt
                    | DECR ID relational_id_postfix_opt
                    | relational_literal
                    | relational_cast

// Literals in relational context
relational_literal: INTLIT
                  | LONGLIT
                  | FLOATLIT
                  | DOUBLELIT
                  | CHARLIT
                  | STRINGLIT

// Type casts in relational context
relational_cast: INT LPAREN arg_expr RPAREN
               | LONG LPAREN arg_expr RPAREN
               | FLOAT LPAREN arg_expr RPAREN
               | DOUBLE LPAREN arg_expr RPAREN
               | CHAR LPAREN arg_expr RPAREN
               | STRING LPAREN arg_expr RPAREN
               | BOOL LPAREN arg_expr RPAREN

// Unary expression in relational
relational_unary: relational_unary_primary relational_arith_tail

relational_unary_primary: MINUS relational_unary_primary
                        | relational_postfix

relational_postfix: relational_literal
                  | relational_cast
                  | INCR ID relational_id_postfix_opt
                  | DECR ID relational_id_postfix_opt
                  | ID relational_id_postfix_opt
                  | LPAREN arg_add_expr RPAREN

relational_id_postfix_opt: INCR
                         | DECR
                         | LBRACK arg_expr RBRACK relational_id_arr_dim2
                         | DOT ID relational_id_postfix_opt
                         | LPAREN arg_list RPAREN relational_id_postfix_opt
                         |

relational_id_arr_dim2: LBRACK arg_expr RBRACK
                      |

// Arithmetic continuation in relational expression
relational_arith_tail: STAR relational_unary relational_arith_tail
                     | SLASH relational_unary relational_arith_tail
                     | MOD relational_unary relational_arith_tail
                     | PLUS relational_unary relational_arith_tail
                     | MINUS relational_unary relational_arith_tail
                     |

// Continue from arithmetic to comparison (handles (x+5) > y patterns)
relational_continue_ops: STAR relational_unary relational_arith_tail comp_op arg_add_expr
                       | SLASH relational_unary relational_arith_tail comp_op arg_add_expr
                       | MOD relational_unary relational_arith_tail comp_op arg_add_expr
                       | PLUS relational_unary relational_arith_tail comp_op arg_add_expr
                       | MINUS relational_unary relational_arith_tail comp_op arg_add_expr
                       | comp_op arg_add_expr

// Comparison operator then RHS (mandatory comparison)
relational_op_and_rhs: STAR relational_unary relational_arith_tail comp_op arg_add_expr
                     | SLASH relational_unary relational_arith_tail comp_op arg_add_expr
                     | MOD relational_unary relational_arith_tail comp_op arg_add_expr
                     | PLUS relational_unary relational_arith_tail comp_op arg_add_expr
                     | MINUS relational_unary relational_arith_tail comp_op arg_add_expr
                     | comp_op arg_add_expr

comp_op: EQ
       | NEQ
       | LT
       | GT
       | LTE
       | GTE

for_update: ID for_update_tail
          | INCR ID
          | DECR ID
          |

for_update_tail: INCR
               | DECR
               | assign_op arg_expr

// ============================================
// MAIN FUNCTION BODY
// ============================================

main_body: main_content

main_content: USING ID using_cont SEMICOLON main_content
            | LOCAL mutability local_dec_body main_content
            | statement_non_return main_content
            | RETURN INTLIT SEMICOLON

// ============================================
// TERMINALS
// ============================================

GLOBAL: "global"
LOCAL: "local"
FUNC: "func"
RETURN: "return"
IF: "if"
ELSE: "else"
SWITCH: "switch"
CASE: "case"
DEFAULT: "default"
FOR: "for"
WHILE: "while"
DO: "do"
BREAK: "break"
TRAP: "trap"
THREAD: "thread"
THREADLN: "threadln"
USING: "using"
WEAVE: "weave"
MAIN: "main"

INT: "int"
LONG: "long"
FLOAT: "float"
DOUBLE: "double"
CHAR: "char"
STRING: "string"
BOOL: "bool"
VOID: "void"

VAR: "var"
CONST: "const"
TRUE: "true"
FALSE: "false"

ASSIGN: "="
PLUSEQ: "+="
MINUSEQ: "-="
STAREQ: "*="
SLASHEQ: "/="
MODEQ: "%="

EQ: "=="
NEQ: "!="
LT: "<"
GT: ">"
LTE: "<="
GTE: ">="

AND: "&&"
OR: "||"
NOT: "!"

PLUS: "+"
MINUS: "-"
STAR: "*"
SLASH: "/"
MOD: "%"
INCR: "++"
DECR: "--"
CONCAT: ".."

LPAREN: "("
RPAREN: ")"
LBRACE: "{"
RBRACE: "}"
LBRACK: "["
RBRACK: "]"
SEMICOLON: ";"
COMMA: ","
COLON: ":"
DOT: "."

// ID MUST NOT match reserved keywords. Using negative lookahead.
// Keywords: int, long, float, double, char, string, bool, void, var, const,
//           true, false, if, else, while, for, switch, case, default, return,
//           func, global, local, do, break, trap, thread, threadln, using,
//           weave, main, array
ID: /(?!(int|long|float|double|char|string|bool|void|var|const|true|false|if|else|while|for|switch|case|default|return|func|global|local|do|break|trap|thread|threadln|using|weave|main|array)\b)[a-zA-Z_][a-zA-Z0-9_]*/
INTLIT: /-?[0-9]{1,10}/
LONGLIT: /-?[0-9]{11,19}/
FLOATLIT: /-?[0-9]+\.[0-9]{1,7}/
DOUBLELIT: /-?[0-9]+\.[0-9]{8,16}/
CHARLIT: /'[^']'/
STRINGLIT: /"[^"]*"/

%ignore /[ \t\n]+/
%ignore /\/\/[^\n]*/
%ignore /\/\*.*?\*\//s
